  {
    "@id": "BlockNode:00CS1593NR010",
    "@type": "BlockNode",
    "title": "**Best Practices**",
    "text": "**Best Practices**:",
    "parent": "BlockNode:00CS1593NR00W",
    "type": "paragraph",
    "children": [
      "BlockNode:00CS1593NR011",
      "BlockNode:00CS1593NR012",
