  },
  {
    "@id": "BlockNode/00C5FPAA20048",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20048",
    "children": [
      "BlockNode/00C5FPAA20049"
    ],
    "title": "00C64YWX6000T",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20049",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20049",
    "children": [],
    "text": "Unlike `<div>` or `<p>`, `<span>` elements introduce no visual breaks or line collapses in the rendered plane.",
    "title": "00C64YWX6000V",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004A",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004A",
    "children": [
