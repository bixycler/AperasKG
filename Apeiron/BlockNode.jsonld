    ]
  },
  {
    "@id": "BlockNode:00D1GC79B8001",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D1GC79B8001:props:StringProp:00D1GC8GZR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00D1GC79B8001:props:StringProp:00D1GC8GZR001",
