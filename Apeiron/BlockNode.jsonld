    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593N800S",
    "@type": "BlockNode",
    "title": "**Run and Validate Tests**",
    "text": "**Run and Validate Tests**:",
    "parent": "BlockNode:00CS1593N800P",
    "type": "listItem",
    "children": [
      "BlockNode:00CS1593N800T"
    ]
  },
  {
    "@id": "BlockNode:00CS1593N800T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593N800T:props:StringProp:00CS159848002",
