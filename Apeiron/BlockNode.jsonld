    "@id": "BlockNode:00D22ZMTKG002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D22ZMTKG002:props:StringProp:00D22ZN5V0000",
        "@type": "StringProp",
