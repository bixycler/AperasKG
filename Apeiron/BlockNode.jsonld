  },
  {
    "@id": "BlockNode/00C5FPAA20079",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20079",
    "children": [],
    "text": "Sub-agent spawning for coding agents without background API access",
    "title": "00C64YWX6003V",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007A",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007A",
    "children": [
      "BlockNode/00C5FPAA2007B",
      "BlockNode/00C5FPAA2007D"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX6003W",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007B",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007B",
    "children": [
      "BlockNode/00C5FPAA2007C"
    ],
    "title": "00C64YWX6003X",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007C",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007C",
    "children": [],
    "text": "Equips primary coding agents with specialized `SKILL.md` definitions that allow them to spawn local sub-agents via headless CLI calls, native sub-agent tools, or local execution scripts.",
    "title": "00C64YWX6003Y",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007D",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007D",
    "children": [
      "BlockNode/00C5FPAA2007E"
    ],
    "title": "00C64YWX6003Z",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007E",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007E",
    "children": [],
    "text": "Preserves the direct Phase 0/2 skill set so local coding agents perform deep structural graph operations, AST transductions, and multi-node updates using existing lab harnesses without secondary API costs.",
    "title": "00C64YWX60040",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2007F",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2007F",
    "children": [
      "BlockNode/00C5FPAA28000",
      "BlockNode/00C5FPAA28001"
    ],
    "title": "00C64YWX60041",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28000",
    "@type": "BlockNode",
    "blockId": "00C5FPAA28000",
    "children": [],
    "text": "Dedicated agent swarms (API-enabled environments)",
    "title": "00C64YWX60042",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28001",
    "@type": "BlockNode",
    "blockId": "00C5FPAA28001",
    "children": [
      "BlockNode/00C5FPAA28002"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX60043",
    "type": "list",
    "unfolded": false
  },
  {
