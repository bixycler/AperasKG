      }
    ],
    "title": "00CBFDZ418005",
    "text": "Aperas Master Architectural Index",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ418006",
      "BlockNode:00CBFDZ418009"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ418006",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ418006:props:StringProp:00CBFDZ428002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ418006:props:StringProp:00CBFDZ428003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ418006",
    "text": "Overview",
    "parent": "BlockNode:00CBFDZ418005",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ418007",
      "BlockNode:00CBFDZ418008"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ418007",
    "@type": "BlockNode",
    "title": "00CBFDZ418007",
    "text": "Aperas is an architecture for agentic knowledge systems operating over a fluid, unconditioned semantic core and crystallizing typed boundaries on demand.",
    "parent": "BlockNode:00CBFDZ418006",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ418008",
    "@type": "BlockNode",
    "title": "00CBFDZ418008",
    "text": "To maintain modularity and deep clarity, the specification is decomposed into three focused documents.",
    "parent": "BlockNode:00CBFDZ418006",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ418009",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ418009:props:StringProp:00CBFDZ42G000",
