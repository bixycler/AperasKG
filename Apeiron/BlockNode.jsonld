  },
  {
    "@id": "BlockNode/00C5FPAA2003Y",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2003Y",
    "children": [],
    "text": "Graph plane (Relational Peras)",
    "title": "00C64YWX6000G",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2003Z",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2003Z",
    "children": [
      "BlockNode/00C5FPAA20040"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX6000H",
    "type": "list",
