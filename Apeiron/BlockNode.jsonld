        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Philosophy and Ontology of Aperas",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00J",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00J",
    "blockId": "00C7BJZCTR00J",
    "children": [
      "BlockNode/00C7BJZCTR00K",
      "BlockNode/00C7BJZCTR00P",
      "BlockNode/00C7BJZCTR00Z"
    ],
    "parent": "BlockNode/00C7BJZCTR00H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00J/props/StringProp/8OhlHgPBGlvErTNy",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00J/props/StringProp/PWo4X59DuoJJQWyS",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Metaphysics of Form and Freedom (Unbounded – Unbound – Bound)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00K",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00K",
    "blockId": "00C7BJZCTR00K",
    "children": [
      "BlockNode/00C7BJZCTR00M",
      "BlockNode/00C7BJZCTR00N"
    ],
    "parent": "BlockNode/00C7BJZCTR00J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00K/props/StringProp/42q5iM57RsIr4DQS",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00K/props/StringProp/raj0JfBr8qGo8WE3",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Apeiron – Unbounded (Macrocosm – Objective Infinite)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00M",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00M",
    "blockId": "00C7BJZCTR00M",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00K",
    "text": "The outer universe existing in a state of infinite, unmanifested potential.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00N",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00N",
    "blockId": "00C7BJZCTR00N",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00K",
    "text": "Represents the unconditioned, boundless origin – an inexhaustible, schema-free field holding all possibilities without being trapped by any single form.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00P",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00P",
    "blockId": "00C7BJZCTR00P",
    "children": [
      "BlockNode/00C7BJZCTR00Q",
      "BlockNode/00C7BJZCTR00R",
      "BlockNode/00C7BJZCTR00Y"
    ],
    "parent": "BlockNode/00C7BJZCTR00J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00P/props/StringProp/NgDcokIn-TgaEVdq",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00P/props/StringProp/f_zn9rKPi3lvKGDW",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Aperas – Unbound (Microcosm – Subjective Liberation)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00Q",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00Q",
    "blockId": "00C7BJZCTR00Q",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00P",
    "text": "The inner human spirit achieving freedom through the liberation of the soul.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00R",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00R",
    "blockId": "00C7BJZCTR00R",
    "children": [
      "BlockNode/00C7BJZCTR00S",
      "BlockNode/00C7BJZCTR00T",
      "BlockNode/00C7BJZCTR00V",
      "BlockNode/00C7BJZCTR00W",
      "BlockNode/00C7BJZCTR00X"
    ],
    "parent": "BlockNode/00C7BJZCTR00P",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00R/props/StringProp/oqDIRhhw4F84O20T",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00R/props/StringProp/v2zFe8BzKpB85Tya",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Etymologically layered:",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00S",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00S",
    "blockId": "00C7BJZCTR00S",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00R",
    "text": "*A-* (without) + *Peras* (limit) = **Unbound**: Not merely “unlimited” in size, but intrinsically free from rigid constraints.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00T",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00T",
    "blockId": "00C7BJZCTR00T",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00R",
    "text": "*Aperas* in Esperanto = “Appears / Emerges”: The active manifestation where structured forms materialize out of the fluid core on demand.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00V",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00V",
    "blockId": "00C7BJZCTR00V",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00R",
    "text": "*Aperas* (Spanish verb meaning “equip, harness”): The functional act of provisioning an agent with the vital instruments, tools, and memory required to navigate and execute operations.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00W",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00W",
    "blockId": "00C7BJZCTR00W",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00R",
    "text": "*Apera* (Botanical Genus / [Windgrass](https://en.wikipedia.org/wiki/Apera)): The organic paradigm of fluid resilience, the ability to keep wholeness (*a-pēros*) by gracefully bending and naturalizing across any environment without breaking.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00X",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00X",
    "blockId": "00C7BJZCTR00X",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00R",
    "text": "*Aperis* (Latin verb meaning “open, uncover”): The open-source act of laying knowledge bare, mirroring its legal fluidity under [The Unlicense](https://unlicense.org/) by refusing rigid cages or ownership.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00Y",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00Y",
    "blockId": "00C7BJZCTR00Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00P",
    "text": "While daily interaction imposes limits and fixed roles, the liberated soul breaks through the illusion of rigid division, realizing its inner ground is identical in essence to the boundless Apeiron.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00Z",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00Z",
    "blockId": "00C7BJZCTR00Z",
    "children": [
      "BlockNode/00C7BJZCTR010",
      "BlockNode/00C7BJZCTR011"
    ],
    "parent": "BlockNode/00C7BJZCTR00J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00Z/props/StringProp/0MJvJ-7O1RzgW_4k",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00Z/props/StringProp/hp-VWnIglNELfwir",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Peras – Bound (The Interface – Transient Boundary)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR010",
    "@type": "BlockNode",
    "title": "00C7BJZCTR010",
    "blockId": "00C7BJZCTR010",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00Z",
    "text": "The limit, boundary, or transient interface where interaction occurs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR011",
    "@type": "BlockNode",
    "title": "00C7BJZCTR011",
    "blockId": "00C7BJZCTR011",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00Z",
    "text": "Form is not a rigid cage, but a temporary, playful instrument. Content remains formless (Apeiron), while the interface solidifies temporarily into defined structures (Peras) to accelerate interaction, then dissolves effortlessly back into the origin.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR012",
    "@type": "BlockNode",
    "title": "00C7BJZCTR012",
    "blockId": "00C7BJZCTR012",
    "children": [
      "BlockNode/00C7BJZCTR013",
      "BlockNode/00C7BJZCTR016"
    ],
    "parent": "BlockNode/00C7BJZCTR00H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR012/props/StringProp/Zy43B5-yDsQNDX-7",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR012/props/StringProp/kl8GFtMii3N0VXQJ",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Multi-Faceted Node Epistemology (The Wikipedia Reference Model)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR013",
    "@type": "BlockNode",
    "title": "00C7BJZCTR013",
    "blockId": "00C7BJZCTR013",
    "children": [
      "BlockNode/00C7BJZCTR014",
      "BlockNode/00C7BJZCTR015"
    ],
    "parent": "BlockNode/00C7BJZCTR012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR013/props/StringProp/IxFMcJn0TVlnfQGk",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR013/props/StringProp/jrIfYgyhRiLxpAlZ",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Historical precedent in collaborative knowledge work",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR014",
    "@type": "BlockNode",
    "title": "00C7BJZCTR014",
    "blockId": "00C7BJZCTR014",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR013",
    "text": "Systems like Wikipedia demonstrate that knowledge nodes are multi-perspective entities rather than flat text blobs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR015",
    "@type": "BlockNode",
    "title": "00C7BJZCTR015",
    "blockId": "00C7BJZCTR015",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR013",
    "text": "Aperas adopts this multi-tab structure as an illustrative reference model for node projections.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR016",
    "@type": "BlockNode",
    "title": "00C7BJZCTR016",
    "blockId": "00C7BJZCTR016",
    "children": [
      "BlockNode/00C7BJZCTR017",
      "BlockNode/00C7BJZCTR018",
      "BlockNode/00C7BJZCTR019",
      "BlockNode/00C7BJZCTR01A"
    ],
    "parent": "BlockNode/00C7BJZCTR012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR016/props/StringProp/XCrM1effikFTIYac",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR016/props/StringProp/XetRRyetyqerStxm",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Projection faces of a node",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR017",
    "@type": "BlockNode",
    "title": "00C7BJZCTR017",
    "blockId": "00C7BJZCTR017",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR016",
    "text": "Surface view (Article – Peras projection): Markdown and HTML outliner blocks rendered for human reading and fast LLM context window ingestion.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR018",
    "@type": "BlockNode",
    "title": "00C7BJZCTR018",
    "blockId": "00C7BJZCTR018",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR016",
    "text": "Graph view (Source – Canonical triples): Semantic graph triples, explicit parent-child hierarchies, typed predicates (`impacts`, `verifies`, `derived_from`), and IRI references.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR019",
    "@type": "BlockNode",
    "title": "00C7BJZCTR019",
    "blockId": "00C7BJZCTR019",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR016",
    "text": "Discourse view (Talk – Agent trails): Agent trails, deliberations, conflicting perspectives, and reasoning traces behind decision states.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01A",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01A",
    "blockId": "00C7BJZCTR01A",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR016",
    "text": "Provenance view (History – Audit deltas): Immutable commit logs, author signatures (human or agent ID), and atomic revision deltas.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01B",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01B",
    "blockId": "00C7BJZCTR01B",
    "children": [
      "BlockNode/00C7BJZCTR01C"
    ],
    "parent": "BlockNode/00C7BJZCTR00H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01B/props/StringProp/FzwG3DtjdXohu_WU",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01B/props/StringProp/j6BNE4Cs7QUEOd1W",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Meta-Aperas / Self-Aperas (Recursive Methodology)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01C",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01C",
    "blockId": "00C7BJZCTR01C",
    "children": [
      "BlockNode/00C7BJZCTR01D",
      "BlockNode/00C7BJZCTR01E",
      "BlockNode/00C7BJZCTR01F",
      "BlockNode/00C7BJZCTR01G"
    ],
    "parent": "BlockNode/00C7BJZCTR01B",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01C/props/StringProp/-Aav9eUePK5N1Poh",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01C/props/StringProp/_Sv6eRcCP6cSZx4Z",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "System evolution as ontological practice",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01D",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01D",
    "blockId": "00C7BJZCTR01D",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01C",
    "text": "The engineering roadmap of Aperas is itself a self-instantiation of its underlying philosophy.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01E",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01E",
    "blockId": "00C7BJZCTR01E",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01C",
    "text": "Phase 0 begins in the uncarved, schema-free substrate (Apeiron), avoiding premature interfaces or heavy abstractions.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01F",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01F",
    "blockId": "00C7BJZCTR01F",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01C",
    "text": "Projections, skills, and tools (Perata) crystallize organically on demand only as concrete human–agent coordination points emerge.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01G",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01G",
    "blockId": "00C7BJZCTR01G",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01C",
    "text": "The platform builds itself using the exact principles it uses to manage knowledge: fluid at rest, bound and structured when touched.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01H",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01H",
    "blockId": "00C7BJZCTR01H",
    "children": [
      "BlockNode/00C7BJZCTR01J",
      "BlockNode/00C7BJZCTR01W",
      "BlockNode/00C7BJZCTR025",
      "BlockNode/00C7BJZCTR02A",
      "BlockNode/00C7BJZCTR02H"
    ],
    "parent": "BlockNode/00C7BJZCTG004",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01H/props/StringProp/KuJCIzX-ZXO8A-QP",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01H/props/StringProp/NN__n-3dG0vgHEke",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "System Architecture and Mechanics of Aperas",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01J",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01J",
    "blockId": "00C7BJZCTR01J",
    "children": [
      "BlockNode/00C7BJZCTR01K",
      "BlockNode/00C7BJZCTR01P",
      "BlockNode/00C7BJZCTR01S"
    ],
    "parent": "BlockNode/00C7BJZCTR01H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01J/props/StringProp/GjeCd8E-vj0aJWk0",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01J/props/StringProp/v9OpRLV5t3xuJ4XG",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Architectural Philosophy: Fluid Core vs. Crystallized Interfaces",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01K",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01K",
    "blockId": "00C7BJZCTR01K",
    "children": [
      "BlockNode/00C7BJZCTR01M",
      "BlockNode/00C7BJZCTR01N"
    ],
    "parent": "BlockNode/00C7BJZCTR01J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01K/props/StringProp/4Jyl7musH8gnv4wR",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01K/props/StringProp/i8Ir1XWmtGlQqDyP",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Fluid core substrate (Apeiron – formless content)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01M",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01M",
    "blockId": "00C7BJZCTR01M",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01K",
    "text": "The canonical state substrate remains a continuous, unconditioned semantic field – a rich graph of associations, atomic assertions, decisions, and raw evidence without rigid schema impedance.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01N",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01N",
    "blockId": "00C7BJZCTR01N",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01K",
    "text": "Avoids premature schema-on-write constraints that destroy nuance or cause friction during exploratory thought and multi-agent reasoning.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01P",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01P",
    "blockId": "00C7BJZCTR01P",
    "children": [
      "BlockNode/00C7BJZCTR01Q",
      "BlockNode/00C7BJZCTR01R"
    ],
    "parent": "BlockNode/00C7BJZCTR01J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01P/props/StringProp/Id_sG7F51kZr1lo3",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01P/props/StringProp/sV0FqE8AbciWPdhG",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Schema-as-projection (Peras – crystallized interfaces)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01Q",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01Q",
    "blockId": "00C7BJZCTR01Q",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01P",
    "text": "Schemas, types, enums, and unique identifiers are not intrinsic properties of the data substrate; they are temporary, disposable crystallizations generated on demand.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01R",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01R",
    "blockId": "00C7BJZCTR01R",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01P",
    "text": "Interfaces represent agreed-upon, lossy compressions between two parties (agents, APIs, UI engines) designed to minimize interaction friction and maximize transaction speed.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01S",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01S",
    "blockId": "00C7BJZCTR01S",
    "children": [
      "BlockNode/00C7BJZCTR01T",
      "BlockNode/00C7BJZCTR01V"
    ],
    "parent": "BlockNode/00C7BJZCTR01J",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01S/props/StringProp/hnzaOSXnNhZVejED",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01S/props/StringProp/nFUwgsWaTu7i7H6r",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Perimeter boundary transducers",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01T",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01T",
    "blockId": "00C7BJZCTR01T",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01S",
    "text": "Type systems (e.g., Pydantic in Python, Zod/TypeBox in TypeScript) live strictly at the system perimeter (boundary transducers) rather than polluting the core graph engine.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01V",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01V",
    "blockId": "00C7BJZCTR01V",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01S",
    "text": "Boundary agents sample the fluid core (Apeiron) and project it into rigid, type-safe structures (Peras) strictly when interacting with deterministic runtimes (databases, AST compilers, UI outliners, or structured LLM tool endpoints).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01W",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01W",
    "blockId": "00C7BJZCTR01W",
    "children": [
      "BlockNode/00C7BJZCTR01X",
      "BlockNode/00C7BJZCTR01Z",
      "BlockNode/00C7BJZCTR022"
    ],
    "parent": "BlockNode/00C7BJZCTR01H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01W/props/StringProp/adPWpqfcmuA7AyUa",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01W/props/StringProp/wzGYE2T9810L9gSZ",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Multi-Agent Projection Pattern",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01X",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01X",
    "blockId": "00C7BJZCTR01X",
    "children": [
      "BlockNode/00C7BJZCTR01Y"
    ],
    "parent": "BlockNode/00C7BJZCTR01W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01X/props/StringProp/leVERf4XWhUEw0Ak",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01X/props/StringProp/t-W2ge9Rbz7GByix",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Pattern definition",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01Y",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01Y",
    "blockId": "00C7BJZCTR01Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01X",
    "text": "An architectural paradigm where a high-dimensional, fluid state graph (Apeiron) acts as the single source of truth, while specialized agents act as bidirectional transducers (lenses) mediating human and machine interactions.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR01Z",
    "@type": "BlockNode",
    "title": "00C7BJZCTR01Z",
    "blockId": "00C7BJZCTR01Z",
    "children": [
      "BlockNode/00C7BJZCTR020",
      "BlockNode/00C7BJZCTR021"
    ],
    "parent": "BlockNode/00C7BJZCTR01W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR01Z/props/StringProp/Ev51PYqTc2guvsXe",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR01Z/props/StringProp/YmFitkAFGFKDsgjg",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Read-side projection lenses (deep read)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR020",
    "@type": "BlockNode",
    "title": "00C7BJZCTR020",
    "blockId": "00C7BJZCTR020",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01Z",
    "text": "Specialized projection agents extract subgraphs and crystallize them into low-dimensional, context-specific interfaces (Peras) like Markdown outliners, source code ASTs, or sequence diagrams.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR021",
    "@type": "BlockNode",
    "title": "00C7BJZCTR021",
    "blockId": "00C7BJZCTR021",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR01Z",
    "text": "Enables deep read capabilities where every rendered element retains provenance anchors and backlinks, allowing readers to drill down into the supporting evidence subgraph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR022",
    "@type": "BlockNode",
    "title": "00C7BJZCTR022",
    "blockId": "00C7BJZCTR022",
    "children": [
      "BlockNode/00C7BJZCTR023",
      "BlockNode/00C7BJZCTR024"
    ],
    "parent": "BlockNode/00C7BJZCTR01W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR022/props/StringProp/2L_Iy2tZJ9GpTlsr",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR022/props/StringProp/G2H24mP9QUWIUAve",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Write-side control and delta ingestion (deep write)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR023",
    "@type": "BlockNode",
    "title": "00C7BJZCTR023",
    "blockId": "00C7BJZCTR023",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR022",
    "text": "Intake and impact agents parse view-level edits, calculate semantic diffs, and commit reified assertion nodes or validity updates back to the substrate.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR024",
    "@type": "BlockNode",
    "title": "00C7BJZCTR024",
    "blockId": "00C7BJZCTR024",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR022",
    "text": "Enables deep write capabilities where edits trigger impact traversals along `affects` or `constrains` edges, calculating downstream ripple effects and queuing advisory invalidations.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR025",
    "@type": "BlockNode",
    "title": "00C7BJZCTR025",
    "blockId": "00C7BJZCTR025",
    "children": [
      "BlockNode/00C7BJZCTR026",
      "BlockNode/00C7BJZCTR027",
      "BlockNode/00C7BJZCTR028",
      "BlockNode/00C7BJZCTR029"
    ],
    "parent": "BlockNode/00C7BJZCTR01H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR025/props/StringProp/lk1ba4NjldURWB9X",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR025/props/StringProp/y8qdIFnSXKm1F69H",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "System Taxonomy and Vocabulary",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR026",
    "@type": "BlockNode",
    "title": "00C7BJZCTR026",
    "blockId": "00C7BJZCTR026",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR025",
    "text": "System / Platform: **Aperas** – The unbound environment where structure emerges (“appears”).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR027",
    "@type": "BlockNode",
    "title": "00C7BJZCTR027",
    "blockId": "00C7BJZCTR027",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR025",
    "text": "Fluid Core Substrate: **Apeiron** – The unconditioned, schema-free continuum where thoughts and semantic links flow without artificial boundaries.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR028",
    "@type": "BlockNode",
    "title": "00C7BJZCTR028",
    "blockId": "00C7BJZCTR028",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR025",
    "text": "Boundary Projections / Interfaces: **Peras** – The transient, typed structures (JSON Schema, Zod/Pydantic models, AST trees, DB mutations).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR029",
    "@type": "BlockNode",
    "title": "00C7BJZCTR029",
    "blockId": "00C7BJZCTR029",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR025",
    "text": "Transduction Process: **Aperas** (*to appear / materialize*) – The active emergence of structured Peras out of the unconditioned Apeiron.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02A",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02A",
    "blockId": "00C7BJZCTR02A",
    "children": [
      "BlockNode/00C7BJZCTR02B",
      "BlockNode/00C7BJZCTR02D",
      "BlockNode/00C7BJZCTR02F"
    ],
    "parent": "BlockNode/00C7BJZCTR01H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02A/props/StringProp/PEGt1x0QHCS6Qft5",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02A/props/StringProp/TIi8eD-HtPNnXfEs",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Coding Agent Interface Continuum",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02B",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02B",
    "blockId": "00C7BJZCTR02B",
    "children": [
      "BlockNode/00C7BJZCTR02C"
    ],
    "parent": "BlockNode/00C7BJZCTR02A",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02B/props/StringProp/MGqeNzohSYF-3TRN",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02B/props/StringProp/glHq77lgADZ1m2CL",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Manual skill mode (procedural recipes)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02C",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02C",
    "blockId": "00C7BJZCTR02C",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02B",
    "text": "Direct execution of `SKILL.md` procedures and local scripts without external service layers or extra API token costs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02D",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02D",
    "blockId": "00C7BJZCTR02D",
    "children": [
      "BlockNode/00C7BJZCTR02E"
    ],
    "parent": "BlockNode/00C7BJZCTR02A",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02D/props/StringProp/5F3oewbxbWm40Zxo",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02D/props/StringProp/KNUU2ZuPguJEAXCR",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Active tool mode (on-demand query)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02E",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02E",
    "blockId": "00C7BJZCTR02E",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02D",
    "text": "Explicit tool calling (via service APIs) where the coding agent queries or mutates perata through high-level skills at an abstract level.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02F",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02F",
    "blockId": "00C7BJZCTR02F",
    "children": [
      "BlockNode/00C7BJZCTR02G"
    ],
    "parent": "BlockNode/00C7BJZCTR02A",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02F/props/StringProp/L5L_AhSEu8YZOaoZ",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02F/props/StringProp/pkapLT_ck2kr0cwX",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Automatic hook mode (context engineering)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02G",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02G",
    "blockId": "00C7BJZCTR02G",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02F",
    "text": "Event-driven injection where relevant perata projections are automatically synthesized and placed directly into the coding agent's prompt/context window.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02H",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02H",
    "blockId": "00C7BJZCTR02H",
    "children": [
      "BlockNode/00C7BJZCTR02J",
      "BlockNode/00C7BJZCTR02N",
      "BlockNode/00C7BJZCTR02R"
    ],
    "parent": "BlockNode/00C7BJZCTR01H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02H/props/StringProp/EzwjzlIV2YvDOn5t",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02H/props/StringProp/TX2eJQCjppxu3v1_",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Async Execution and Command Dispatch Mechanics",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02J",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02J",
    "blockId": "00C7BJZCTR02J",
    "children": [
      "BlockNode/00C7BJZCTR02K",
      "BlockNode/00C7BJZCTR02M"
    ],
    "parent": "BlockNode/00C7BJZCTR02H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02J/props/StringProp/9g1xWfjXpcQx--pY",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02J/props/StringProp/Ra5125-79E06LRSt",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Unconstrained reasoning to batch command emission",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02K",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02K",
    "blockId": "00C7BJZCTR02K",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02J",
    "text": "Reasoner agents operate with free-flow, unconstrained thinking to analyze context and draft mutations without suffering from structured output reasoning constraints.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02M",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02M",
    "blockId": "00C7BJZCTR02M",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02J",
    "text": "At turn termination, the agent emits a single batch tool call or tagged payload containing array-based command intents (e.g., `list[CommandIntent]`).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02N",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02N",
    "blockId": "00C7BJZCTR02N",
    "children": [
      "BlockNode/00C7BJZCTR02P",
      "BlockNode/00C7BJZCTR02Q"
    ],
    "parent": "BlockNode/00C7BJZCTR02H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02N/props/StringProp/NsU87sVKih1VBo0o",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02N/props/StringProp/YRmWpOX_KvkmB4Fh",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Event-driven async fan-out",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02P",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02P",
    "blockId": "00C7BJZCTR02P",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02N",
    "text": "Emitted command batches are pushed to an event-driven dispatcher and executed concurrently across worker coroutines and service endpoints.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02Q",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02Q",
    "blockId": "00C7BJZCTR02Q",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02N",
    "text": "Agents remain non-blocking and decoupled from slow, synchronous tool-calling loops.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02R",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02R",
    "blockId": "00C7BJZCTR02R",
    "children": [
      "BlockNode/00C7BJZCTR02S"
    ],
    "parent": "BlockNode/00C7BJZCTR02H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02R/props/StringProp/2i91tNY2WA4M7HDl",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02R/props/StringProp/NSIHthgt7xTwVnsS",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Self-healing boundary validation",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02S",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02S",
    "blockId": "00C7BJZCTR02S",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02R",
    "text": "If a command payload violates boundary schema rules (Peras), type validation tracebacks are fed back to the boundary agent for immediate, localized repair without polluting the fluid core (Apeiron).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02T",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02T",
    "blockId": "00C7BJZCTR02T",
    "children": [
      "BlockNode/00C7BJZCTR02V",
      "BlockNode/00C7BJZCTR030",
      "BlockNode/00C7BJZCTR038",
      "BlockNode/00C7BJZCTR03F"
    ],
    "parent": "BlockNode/00C7BJZCTG004",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02T/props/StringProp/6YY7VpM4xSeukuRw",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02T/props/StringProp/TwIKv97UDS_Zykm0",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Node, AST, and Storage Design in Aperas",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02V",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02V",
    "blockId": "00C7BJZCTR02V",
    "children": [
      "BlockNode/00C7BJZCTR02W"
    ],
    "parent": "BlockNode/00C7BJZCTR02T",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02V/props/StringProp/A0KqkIZM_vAgeNOO",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02V/props/StringProp/VPY9Jg4TN-zZazgi",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "On-demand reification (lazy atomization)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02W",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02W",
    "blockId": "00C7BJZCTR02W",
    "children": [
      "BlockNode/00C7BJZCTR02X",
      "BlockNode/00C7BJZCTR02Y",
      "BlockNode/00C7BJZCTR02Z"
    ],
    "parent": "BlockNode/00C7BJZCTR02V",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR02W/props/StringProp/WOhpycKKtnM_KaHw",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR02W/props/StringProp/ysoZuAAxhnbVvmzX",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Coarse by default, fine when touched",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02X",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02X",
    "blockId": "00C7BJZCTR02X",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02W",
    "text": "Content is preserved at coarse granularity (full paragraph, list item, or document block) without forcing upfront micro-fragmentation into tokens or words.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02Y",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02Y",
    "blockId": "00C7BJZCTR02Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02W",
    "text": "The moment a sub-clause, phrase, word, or punctuation mark is addressed, linked, commented on in the Talk view, or bound to a predicate, that specific slice crystallizes into an addressed node with its own identity (URI or UUID).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR02Z",
    "@type": "BlockNode",
    "title": "00C7BJZCTR02Z",
    "blockId": "00C7BJZCTR02Z",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR02W",
    "text": "Untouched surrounding text remains unfragmented text chunks.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR030",
    "@type": "BlockNode",
    "title": "00C7BJZCTR030",
    "blockId": "00C7BJZCTR030",
    "children": [
      "BlockNode/00C7BJZCTR031",
      "BlockNode/00C7BJZCTR033",
      "BlockNode/00C7BJZCTR036"
    ],
    "parent": "BlockNode/00C7BJZCTR02T",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR030/props/StringProp/ZbuvGk6vzzpf6KkX",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR030/props/StringProp/xKKEJZ6bVbDeebn9",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Three parallel planes of architecture",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR031",
    "@type": "BlockNode",
    "title": "00C7BJZCTR031",
    "blockId": "00C7BJZCTR031",
    "children": [
      "BlockNode/00C7BJZCTR032"
    ],
    "parent": "BlockNode/00C7BJZCTR030",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR031/props/StringProp/-A7rScEa_XbVxENg",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR031/props/StringProp/KpIPasL4uAOJI-1d",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Rendered plane (Artifact / Surface Peras)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR032",
    "@type": "BlockNode",
    "title": "00C7BJZCTR032",
    "blockId": "00C7BJZCTR032",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR031",
    "text": "The continuous, readable Markdown or HTML text flow where prose reads naturally without visual disruption.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR033",
    "@type": "BlockNode",
    "title": "00C7BJZCTR033",
    "blockId": "00C7BJZCTR033",
    "children": [
      "BlockNode/00C7BJZCTR034",
      "BlockNode/00C7BJZCTR035"
    ],
    "parent": "BlockNode/00C7BJZCTR030",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR033/props/StringProp/kJzgzyRAxGvxc9pb",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR033/props/StringProp/q_qAe8ZthmQNZcgi",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Stored plane (Substrate Apeiron)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR034",
    "@type": "BlockNode",
    "title": "00C7BJZCTR034",
    "blockId": "00C7BJZCTR034",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR033",
    "text": "The backing store in TerminusDB preserving content as coarse or fine AST nodes and character offset ranges.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR035",
    "@type": "BlockNode",
    "title": "00C7BJZCTR035",
    "blockId": "00C7BJZCTR035",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR033",
    "text": "Mirrored bidirectionally as plain JSON-LD files under `AperasKG/Apeiron/` (`Aperas-architecture.md` §5) — a portable, engine-agnostic round-trip of the same content, independent of TerminusDB's own storage internals.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR036",
    "@type": "BlockNode",
    "title": "00C7BJZCTR036",
    "blockId": "00C7BJZCTR036",
    "children": [
      "BlockNode/00C7BJZCTR037"
    ],
    "parent": "BlockNode/00C7BJZCTR030",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR036/props/StringProp/_MILzRMY-BsX0bQz",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR036/props/StringProp/pKfNlh5yuwAo1zn8",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Graph plane (Relational Peras)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR037",
    "@type": "BlockNode",
    "title": "00C7BJZCTR037",
    "blockId": "00C7BJZCTR037",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR036",
    "text": "The explicit network of nodes and edges connecting addressed entities (documents, blocks, clauses, words, punctuation) to the rest of the knowledge graph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR038",
    "@type": "BlockNode",
    "title": "00C7BJZCTR038",
    "blockId": "00C7BJZCTR038",
    "children": [
      "BlockNode/00C7BJZCTR039",
      "BlockNode/00C7BJZCTR03B",
      "BlockNode/00C7BJZCTR03D"
    ],
    "parent": "BlockNode/00C7BJZCTR02T",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR038/props/StringProp/CtrU-yb_MfnZucXv",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR038/props/StringProp/zY4M7RiZaCOn7A7y",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Universal inline addressability (`<span>` tag pattern)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR039",
    "@type": "BlockNode",
    "title": "00C7BJZCTR039",
    "blockId": "00C7BJZCTR039",
    "children": [
      "BlockNode/00C7BJZCTR03A"
    ],
    "parent": "BlockNode/00C7BJZCTR038",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR039/props/StringProp/-ZKE5DCXZDgLskFt",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCTR039/props/StringProp/2H0XMvscmcGMxZr3",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Zero layout interference",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03A",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03A",
    "blockId": "00C7BJZCTR03A",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR039",
    "text": "Unlike `<div>` or `<p>`, `<span>` elements introduce no visual breaks or line collapses in the rendered plane.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03B",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03B",
    "blockId": "00C7BJZCTR03B",
    "children": [
      "BlockNode/00C7BJZCTR03C"
    ],
    "parent": "BlockNode/00C7BJZCTR038",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR03B/props/StringProp/5_kzAJr4Ww-yC1du",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR03B/props/StringProp/OiJFlxJVb-IHDkKW",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Attribute anchoring",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03C",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03C",
    "blockId": "00C7BJZCTR03C",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR03B",
    "text": "Acts as an inline hook for unique node identifiers (`id=\"node-123\"`), graph attributes (`data-predicate=\"refutes\"`), and event listeners directly over any target character range.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03D",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03D",
    "blockId": "00C7BJZCTR03D",
    "children": [
      "BlockNode/00C7BJZCTR03E"
    ],
    "parent": "BlockNode/00C7BJZCTR038",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR03D/props/StringProp/Iq_ImTxxYv_VXu9a",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR03D/props/StringProp/hb60Y16IuKvQDns5",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Arbitrary granularity",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03E",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03E",
    "blockId": "00C7BJZCTR03E",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR03D",
    "text": "Can wrap a sentence, phrase, single word, or punctuation mark without disrupting document layout or styling.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR03F",
    "@type": "BlockNode",
    "title": "00C7BJZCTR03F",
    "blockId": "00C7BJZCTR03F",
    "children": [
      "BlockNode/00C7BJZCTR03G",
