    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D0X65RB8006",
    "@type": "BlockNode",
    "title": "00D0X65RB8006",
    "text": "Bulk `store.load` of the same 100k quads took 0.29 s.",
    "parent": "BlockNode:00D0X65RB8004",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D0X65RB8007",
    "@type": "BlockNode",
    "links": [
      {
