  },
  {
    "@id": "BlockNode:00CS1593N002E",
    "@type": "BlockNode",
    "title": "**Determine the Active Turn**",
    "text": "**Determine the Active Turn**:",
    "parent": "BlockNode:00CS1593N0026",
    "type": "listItem",
    "children": [
