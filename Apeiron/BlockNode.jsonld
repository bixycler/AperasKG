    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28014",
    "@type": "BlockNode",
    "blockId": "00C5FPAA28014",
    "children": [],
    "text": "Agent swarm and orchestration layer",
    "title": "00C64YWX6800A",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28015",
    "@type": "BlockNode",
