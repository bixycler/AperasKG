        "key": "startIndex",
        "value": "12"
      }
    ],
    "title": "00CDHSZ05G002",
    "text": "Add `identity.json` (machine-local, gitignored) reader/writer replacing `APERAS_MACHINE_NUMBER` env-var-only lookup in `snowflake.ts`.",
