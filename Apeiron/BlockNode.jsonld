  },
  {
    "@id": "BlockNode/00C64YXFT0024",
    "@type": "BlockNode",
    "blockId": "00C64YXFT0024",
    "children": [],
    "text": "Phase 2+ skills: ingestion-from-arbitrary-sources, graph search skill, refactoring/lazy-atomization skill.",
    "title": "00C64Z9NB800J",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C64YXFT0025",
    "@type": "BlockNode",
    "blockId": "00C64YXFT0025",
    "children": [
      "BlockNode/00C64YXFT0026"
    ],
    "title": "00C64Z9NB800K",
