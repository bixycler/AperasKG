    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04W",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04W:props:StringProp:00CBFDZ4HG002",
