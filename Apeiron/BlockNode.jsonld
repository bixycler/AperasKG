  {
    "@id": "BlockNode:00CTTFFW0G009",
    "@type": "BlockNode",
    "title": "### aperas-orchestrator — Role Scope — native harness artifacts restricted to user communication",
    "parent": "BlockNode:00CTTFFW08001",
