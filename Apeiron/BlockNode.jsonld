      }
    ],
    "tombstonedAt": "2026-09-11T12:40:49.522Z",
    "title": "00CDDBQ9J0005",
    "parent": "BlockNode:00CDD68FE0004",
    "type": "list",
    "children": []
  },
  {
    "@id": "BlockNode:00CDD68FE0006",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00CDD68FE0006:links:Link:00CGRWM6K8000",
