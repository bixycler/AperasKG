  },
  {
    "@id": "BlockNode/00C5FPAA20041",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20041",
    "children": [],
    "text": "The explicit network of nodes and edges connecting addressed entities (documents, blocks, clauses, words, punctuation) to the rest of the knowledge graph.",
    "title": "00C64YWX6000K",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20042",
    "@type": "BlockNode",
