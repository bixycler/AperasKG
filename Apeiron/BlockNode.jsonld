      {
        "@id": "BlockNode:00CE1GW4Y8008:links:Link:00CF11F29G000",
        "@type": "Link",
        "target": "BlockNode:00CDBYV4T8002",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CE1GW4Y8008:links:Link:00CF11F29G000:props:StringProp:00CF11F29G001",
