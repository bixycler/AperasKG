    ]
  },
  {
    "@id": "BlockNode:00CJ6TGSYG006",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00CJ6TGSYG006:links:Link:00CJ6TGT2G002",
        "@type": "Link",
        "target": "BlockNode:00CF2AEMER007",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CJ6TGSYG006:links:Link:00CJ6TGT2G002:props:StringProp:00CJ6TGT2G003",
