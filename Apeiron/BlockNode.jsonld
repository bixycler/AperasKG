    ]
  },
  {
    "@id": "BlockNode:00CS1593NR011",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593NR011:props:StringProp:00CS15989G000",
        "@type": "StringProp",
