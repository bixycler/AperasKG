  },
  {
    "@id": "BlockNode/00C5FPAA2004R",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004R",
    "children": [],
    "text": "Granularity mapping",
    "title": "00C64YWX6001A",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004S",
