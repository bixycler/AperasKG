      {
        "@id": "BlockNode:00CF4RAGDR001:links:Link:00CF4RAHZG000",
        "@type": "Link",
        "target": "BlockNode:00CF4D9XT0001",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CF4RAGDR001:links:Link:00CF4RAHZG000:props:StringProp:00CN3ZSYPR000",
            "@type": "StringProp",
            "key": "position",
