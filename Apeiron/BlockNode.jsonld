            "@type": "StringProp",
            "key": "position",
            "value": "12"
          }
        ]
      }
    ],
    "title": "### Discipline/Mechanics — tombstoned nodes hidden by default, not just tagged",
    "text": "Supersedes: [v2's own \"unfold doesn't mark tombstoned children\" gap note](#id/BlockNode:00CGF613WG00W)",
    "parent": "BlockNode:00CGN8W9M8001",
    "type": "heading",
