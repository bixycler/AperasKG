            "@type": "StringProp",
            "key": "position",
            "value": "160"
          }
        ]
      }
    ],
    "title": "00D3YV43Q0005",
    "text": "Every other declared key is present where the shape asks for it, and no node of the mirror carries a key outside the shapes except the `predicate` of a `Link` ([every `Link` carries a `predicate`](#id/BlockNode:00D3WNBPPG001)).",
    "parent": "BlockNode:00D3YV43Q0002",
    "type": "listItem",
    "children": []
  },
