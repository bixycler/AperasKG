        "target": "BlockNode:00CF1276D0001",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CGMX2YZG001:links:Link:00CGMX3240000:props:StringProp:00CGMX3240001",
