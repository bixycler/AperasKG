  {
    "@id": "BlockNode/00C5FPAA2006E",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2006E",
    "children": [],
    "text": "Surface projections reveal the multi-tab reference model (Article, Source, Talk, History) so humans and agents navigate the exact same operational state.",
    "title": "00C64YWX60030",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2006F",
