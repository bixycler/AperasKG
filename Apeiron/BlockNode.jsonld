        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00D2536E20008:props:StringProp:00D2536SXG002",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D2536E20008",
    "text": "None decided.",
    "parent": "BlockNode:00D2536E20007",
    "type": "listItem",
    "children": []
  },
