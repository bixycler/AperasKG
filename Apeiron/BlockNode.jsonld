  {
    "@id": "BlockNode:00CS1593N002G",
    "@type": "BlockNode",
    "title": "00CS1593N002G",
    "text": "**Never assume work hasn't started** just because a markdown file under `artifacts/` appears empty or unprojected. The graph in Apeiron is the source of truth.",
    "parent": "BlockNode:00CS1593N002E",
