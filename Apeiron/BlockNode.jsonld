        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV000N/props/StringProp/cI76gieq1g3bESWL",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Surface editor and AST parsing layer",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000P",
    "@type": "BlockNode",
    "title": "00C7BJZCV000P",
    "blockId": "00C7BJZCV000P",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000N",
    "text": "**Unified.js** (`remark` / `rehype`) acts as the bidirectional AST parsing engine for Markdown to MDAST conversion, offset tracking, and block extraction.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000Q",
    "@type": "BlockNode",
