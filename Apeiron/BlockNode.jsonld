  {
    "@id": "BlockNode:00CEA56A0G002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CEA56A0G002:props:StringProp:00CEA56B3R000",
        "@type": "StringProp",
