        "@id": "BlockNode:00CE5BVP6R001:links:Link:00CE5BVQAR002",
        "@type": "Link",
        "target": "BlockNode:00CE32GRZG007",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CE5BVP6R001:links:Link:00CE5BVQAR002:props:StringProp:00CE5BVQAR003",
            "@type": "StringProp",
