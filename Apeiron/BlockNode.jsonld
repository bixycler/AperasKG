        "target": "BlockNode:00CF46W4QR00C",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CF5GK5BR002:links:Link:00CN87B94G000:props:StringProp:00CN87B94G001",
            "@type": "StringProp",
            "key": "position",
