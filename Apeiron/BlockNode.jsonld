        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Storage layer",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0011",
    "@type": "BlockNode",
    "title": "00C7BJZCV0011",
    "blockId": "00C7BJZCV0011",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0010",
