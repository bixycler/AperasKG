      },
      {
        "@id": "BlockNode:00CBFDZ41G04W:props:StringProp:00CBFDZ4HG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04W",
    "text": "Canonical graph storage layer (the substrate)",
    "parent": "BlockNode:00CBFDZ41G04V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04X",
      "BlockNode:00CBFDZ41G04Y",
      "BlockNode:00CBFDZ41G04Z"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04X",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04X",
    "text": "**TerminusDB** (chosen primary substrate) provides revision control on knowledge graphs with Git-like branches, delta layers, diffs, and merge requests.",
    "parent": "BlockNode:00CBFDZ41G04W",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04Y",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04Y",
    "text": "**FalkorDB** and **Neo4j Community** offer property graph engines with sub-millisecond Cypher querying.",
    "parent": "BlockNode:00CBFDZ41G04W",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04Z",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04Z",
    "text": "**SQLite** and **DuckDB** with DuckPGQ offer local-first, lightweight deployments.",
    "parent": "BlockNode:00CBFDZ41G04W",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G050",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G050:props:StringProp:00CBFDZ4HR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G050:props:StringProp:00CBFDZ4HR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G050",
    "text": "UI rendering and projection layer",
    "parent": "BlockNode:00CBFDZ41G04V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G051",
      "BlockNode:00CBFDZ41G052"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G051",
    "@type": "BlockNode",
    "title": "00CBFDZ41G051",
    "text": "**SolidJS** (chosen UI framework) provides fine-grained signal-based reactivity without Virtual DOM overhead for rendering deep-read outliners and reified inline spans.",
    "parent": "BlockNode:00CBFDZ41G050",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G052",
    "@type": "BlockNode",
    "title": "00CBFDZ41G052",
    "text": "**React Flow** / **XYFlow** and **Mermaid.js** offer visual graph and diagram rendering utilities.",
    "parent": "BlockNode:00CBFDZ41G050",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G053",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G053:props:StringProp:00CBFDZ4J0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G053:props:StringProp:00CBFDZ4J0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G053",
    "text": "Agent swarm and orchestration layer",
    "parent": "BlockNode:00CBFDZ41G04V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G054",
      "BlockNode:00CBFDZ41G055"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G054",
    "@type": "BlockNode",
    "title": "00CBFDZ41G054",
    "text": "**LangGraph** enables stateful, cyclical multi-agent orchestration to model read–write loops across intake, validation, and impact sweep agents.",
    "parent": "BlockNode:00CBFDZ41G053",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G055",
    "@type": "BlockNode",
    "title": "00CBFDZ41G055",
    "text": "**PydanticAI** provides type-safe, schema-guided agent definitions ensuring outputs adhere to exact block-tree entity schemas.",
    "parent": "BlockNode:00CBFDZ41G053",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G056",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G056:props:StringProp:00CBFDZ4J8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G056:props:StringProp:00CBFDZ4J8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G056",
    "text": "Interoperability, procedures, and boundary validation",
    "parent": "BlockNode:00CBFDZ41G04V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G057",
      "BlockNode:00CBFDZ41G058",
      "BlockNode:00CBFDZ41G059"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G057",
    "@type": "BlockNode",
    "title": "00CBFDZ41G057",
    "text": "**Agent Skills** (`SKILL.md`) serves as an open standard for defining modular, loadable agent instructions and view templates.",
    "parent": "BlockNode:00CBFDZ41G056",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G058",
    "@type": "BlockNode",
    "title": "00CBFDZ41G058",
    "text": "**TypeBox** / **Zod** (TypeScript) and **Pydantic** (Python) serve as boundary transducers enforcing schema contracts at network edges.",
    "parent": "BlockNode:00CBFDZ41G056",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G059",
    "@type": "BlockNode",
    "title": "00CBFDZ41G059",
    "text": "Direct Service APIs (GraphQL or REST) serve as direct communication interfaces between agents and backend services.",
    "parent": "BlockNode:00CBFDZ41G056",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05A",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G05A:props:StringProp:00CBFDZ4JG000",
