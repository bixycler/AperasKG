  },
  {
    "@id": "BlockNode/00C5FPAA18003",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18003",
    "children": [],
    "text": "Aperas Master Architectural Index",
    "title": "00C64YWX58006",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18004",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18004",
    "children": [
      "BlockNode/00C5FPAA18005",
      "BlockNode/00C5FPAA1800C"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX58007",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18005",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18005",
    "children": [
      "BlockNode/00C5FPAA18006",
      "BlockNode/00C5FPAA18007"
    ],
    "title": "00C64YWX58008",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18006",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18006",
    "children": [],
    "text": "Overview",
    "title": "00C64YWX58009",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18007",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18007",
    "children": [
      "BlockNode/00C5FPAA18008",
      "BlockNode/00C5FPAA1800A"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX5800A",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18008",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18008",
    "children": [
      "BlockNode/00C5FPAA18009"
    ],
    "title": "00C64YWX5800B",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18009",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18009",
    "children": [],
    "text": "Aperas is an architecture for agentic knowledge systems operating over a fluid, unconditioned semantic core and crystallizing typed boundaries on demand.",
    "title": "00C64YWX5800C",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800A",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800A",
    "children": [
      "BlockNode/00C5FPAA1800B"
    ],
    "title": "00C64YWX5800D",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800B",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800B",
    "children": [],
    "text": "To maintain modularity and deep clarity, the specification is decomposed into three focused documents.",
    "title": "00C64YWX5800E",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800C",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800C",
    "children": [
      "BlockNode/00C5FPAA1800D",
      "BlockNode/00C5FPAA1800E"
    ],
    "title": "00C64YWX5800F",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800D",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800D",
    "children": [],
    "text": "Core Architecture Suite",
    "title": "00C64YWX5800G",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800E",
    "@type": "BlockNode",
