        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CS1593N800T:props:StringProp:00CS159848003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593N800T",
    "text": "Execute the repo test command (e.g. `npm run verify` from `monorepo/`).",
    "parent": "BlockNode:00CS1593N800S",
