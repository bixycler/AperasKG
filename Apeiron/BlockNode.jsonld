  },
  {
    "@id": "BlockNode/00C5FPAA2006G",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2006G",
    "children": [],
    "text": "Phase 2: Skill expansion and perata maturation",
    "title": "00C64YWX60032",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2006H",
    "@type": "BlockNode",
