        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04V:props:StringProp:00CBFDZ4HG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04V",
    "text": "System architecture layers",
    "parent": "BlockNode:00CBFDZ41G04T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04W",
      "BlockNode:00CBFDZ41G050",
      "BlockNode:00CBFDZ41G053",
      "BlockNode:00CBFDZ41G056",
