    "children": [],
    "text": "Selection: SolidJS",
    "title": "00C64YWX68030",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2803P",
    "@type": "BlockNode",
