      "BlockNode:00CVRWHQ8G002"
    ]
  },
  {
    "@id": "BlockNode:00CVRWHQ8G002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CVRWHQ8G002:props:StringProp:00CVRWJ02R000",
