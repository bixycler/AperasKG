    "blockId": "00C5FPATBG00P",
    "children": [],
    "text": "`terminusdb/terminusdb-server:v12` (Docker image)",
    "title": "00C64YY0C000T",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPATBG00Q",
    "@type": "BlockNode",
