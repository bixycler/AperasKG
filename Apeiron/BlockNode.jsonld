    ],
    "text": "Agent layer",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000W",
    "@type": "BlockNode",
    "title": "00C7BJZCV000W",
    "blockId": "00C7BJZCV000W",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000V",
    "text": "LangGraph and PydanticAI service agents equipped with dynamically loaded Agent Skills.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000X",
    "@type": "BlockNode",
    "title": "00C7BJZCV000X",
    "blockId": "00C7BJZCV000X",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000V",
    "text": "Projection agents read subgraphs via GraphQL or REST and render Markdown or specs according to skill workflows.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000Y",
    "@type": "BlockNode",
    "title": "00C7BJZCV000Y",
    "blockId": "00C7BJZCV000Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000V",
    "text": "Ingestion agents parse unstructured inputs directly into structured block-tree deltas.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000Z",
    "@type": "BlockNode",
    "title": "00C7BJZCV000Z",
    "blockId": "00C7BJZCV000Z",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000V",
    "text": "Impact agents traverse edges and flag stale views.",
