  },
  {
    "@id": "BlockNode/00C5FPAA1800N",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800N",
    "children": [],
    "text": "Conceptual triad: Unbounded – Unbound – Bound.",
    "title": "00C64YWX5800R",
