    "title": "00CBFDZ41R02G",
    "text": "Write ingestion (text to knowledge graph)",
    "parent": "BlockNode:00CBFDZ41R02C",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R02H",
