      }
    ],
    "title": "00CBFDZ41G05T",
    "text": "Immutable delta-layer architecture",
    "parent": "BlockNode:00CBFDZ41G05R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G05V",
      "BlockNode:00CBFDZ41G05W",
      "BlockNode:00CBFDZ41G05X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G05V",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05V",
    "text": "Operates on succinct, bit-packed immutable layers backed by Rust and Prolog, where every mutation appends a diff layer without overwriting past state.",
    "parent": "BlockNode:00CBFDZ41G05T",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05W",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05W",
    "text": "Grants native Git-like time travel, branching, diffing, and merging, allowing agents and humans to draft speculative updates on proposal branches.",
    "parent": "BlockNode:00CBFDZ41G05T",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05X",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05X",
    "text": "Provides strict revision auditability where every assertion and invalidation is intrinsically tied to a commit author, timestamp, and message.",
    "parent": "BlockNode:00CBFDZ41G05T",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G05Y:props:StringProp:00CBFDZ4M0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G05Y:props:StringProp:00CBFDZ4M0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G05Y",
    "text": "Isomorphism with block-tree and hybrid projection models",
    "parent": "BlockNode:00CBFDZ41G05R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G05Z",
      "BlockNode:00CBFDZ41G060"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G05Z",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05Z",
    "text": "Models data as JSON-LD Document Classes, offering direct structural mapping to outliner block-trees (Logseq/Roam style) and nested subdocuments.",
    "parent": "BlockNode:00CBFDZ41G05Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G060",
    "@type": "BlockNode",
    "title": "00CBFDZ41G060",
    "text": "Supports the multi-faceted node reference pattern, storing full Markdown text for human UI rendering alongside structured assertion fields and triple relationships.",
    "parent": "BlockNode:00CBFDZ41G05Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G061",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G061:props:StringProp:00CBFDZ4M8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G061:props:StringProp:00CBFDZ4M8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G061",
    "text": "Dual-query interface capabilities",
    "parent": "BlockNode:00CBFDZ41G05R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G062",
      "BlockNode:00CBFDZ41G063"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G062",
    "@type": "BlockNode",
    "title": "00CBFDZ41G062",
    "text": "Employs WOQL (Web Object Query Language) powered by Datalog for pattern matching, recursive transitive dependency traversals, and impact propagation calculations.",
    "parent": "BlockNode:00CBFDZ41G061",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G063",
    "@type": "BlockNode",
    "title": "00CBFDZ41G063",
    "text": "Exposes automatically generated GraphQL endpoints for projection agents to perform fast, multi-hop contextual fetches during view rendering.",
    "parent": "BlockNode:00CBFDZ41G061",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G064",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G064:props:StringProp:00CBFDZ4MG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G064:props:StringProp:00CBFDZ4MG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G064",
    "text": "Substrate replacement in progress",
    "parent": "BlockNode:00CBFDZ41G05R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G065"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G065",
    "@type": "BlockNode",
    "title": "00CBFDZ41G065",
    "text": "ApeironNgn — a minimal Rust graph engine scoped to exactly what Aperas exercises — is in progress as the replacement; see Development Roadmap \"Phase 0.1: Substrate Evolution\" and `Aperas-apeironngn-design.md`.",
    "parent": "BlockNode:00CBFDZ41G064",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G066",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G066:props:StringProp:00CBFDZ4MR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G066:props:StringProp:00CBFDZ4MR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G066",
    "text": "UI projection layer rationale",
    "parent": "BlockNode:00CBFDZ41G05Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G067",
      "BlockNode:00CBFDZ41G068",
      "BlockNode:00CBFDZ41G06C",
      "BlockNode:00CBFDZ41R001"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G067",
    "@type": "BlockNode",
    "title": "00CBFDZ41G067",
    "text": "Selection: SolidJS",
    "parent": "BlockNode:00CBFDZ41G066",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G068",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G068:props:StringProp:00CBFDZ4MR002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G068:props:StringProp:00CBFDZ4MR003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G068",
    "text": "Fine-grained signal reactivity without Virtual DOM overhead",
    "parent": "BlockNode:00CBFDZ41G066",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G069",
      "BlockNode:00CBFDZ41G06A",
      "BlockNode:00CBFDZ41G06B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G069",
    "@type": "BlockNode",
    "title": "00CBFDZ41G069",
    "text": "Compiles template JSX into direct DOM mutations without virtual DOM reconciliation cascades.",
    "parent": "BlockNode:00CBFDZ41G068",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G06A",
    "@type": "BlockNode",
    "title": "00CBFDZ41G06A",
    "text": "Updating an inline `<span>`, reified node badge, or discourse trail tag updates only the exact target DOM element with near-zero CPU footprint.",
    "parent": "BlockNode:00CBFDZ41G068",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G06B",
    "@type": "BlockNode",
    "title": "00CBFDZ41G06B",
    "text": "Prevents micro-stutters and re-rendering cascades across massive, deeply nested outliner trees.",
    "parent": "BlockNode:00CBFDZ41G068",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G06C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G06C:props:StringProp:00CBFDZ4N0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G06C:props:StringProp:00CBFDZ4N0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G06C",
    "text": "Optimization for agentic deep-read views",
    "parent": "BlockNode:00CBFDZ41G066",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G06D",
      "BlockNode:00CBFDZ41R000"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G06D",
    "@type": "BlockNode",
    "title": "00CBFDZ41G06D",
    "text": "Since AI agents execute structural graph edits via backend transducers, the UI functions primarily as a high-performance **deep-read projection layer** with light human annotation.",
    "parent": "BlockNode:00CBFDZ41G06C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R000",
    "@type": "BlockNode",
    "title": "00CBFDZ41R000",
    "text": "Signals subscribe directly to background streaming deltas, updating rendered views surgically as agents commit updates.",
    "parent": "BlockNode:00CBFDZ41G06C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R001",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R001:props:StringProp:00CBFDZ4N8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R001:props:StringProp:00CBFDZ4N8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R001",
    "text": "Relativistic context ergonomics",
    "parent": "BlockNode:00CBFDZ41G066",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R002"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R002",
    "@type": "BlockNode",
    "title": "00CBFDZ41R002",
    "text": "Solid primitives (`createSignal`, `createContext`, `createStore`) map naturally to relativistic node scoping, allowing child nodes and inline spans to bind locally without triggering parent component re-evaluations.",
    "parent": "BlockNode:00CBFDZ41R001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R003",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R003:props:StringProp:00CBFDZ4NG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R003:props:StringProp:00CBFDZ4NG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R003",
    "text": "Preservation of manual skills & zero-background-API sub-agent execution rationale",
    "parent": "BlockNode:00CBFDZ41G05Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R004",
      "BlockNode:00CBFDZ41R008",
      "BlockNode:00CBFDZ41R00C"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R004",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R004:props:StringProp:00CBFDZ4NG002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R004:props:StringProp:00CBFDZ4NG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R004",
    "text": "Background constraint: Coding-agent-only environment",
    "parent": "BlockNode:00CBFDZ41R003",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R005",
      "BlockNode:00CBFDZ41R006",
      "BlockNode:00CBFDZ41R007"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R005",
    "@type": "BlockNode",
    "title": "00CBFDZ41R005",
    "text": "In enterprise or research lab environments, developers are provided access exclusively to primary coding agents (e.g., Claude Code, Antigravity) via local harnesses, while secondary external LLM API keys are strictly blocked or restricted.",
    "parent": "BlockNode:00CBFDZ41R004",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R006",
    "@type": "BlockNode",
    "title": "00CBFDZ41R006",
    "text": "Traditional agentic memory frameworks (such as Letta/MemGPT, Mem0, or Zep) rely on background API servers running continuous summarization and vector indexing loops, making them unusable under zero-API constraints.",
    "parent": "BlockNode:00CBFDZ41R004",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R007",
    "@type": "BlockNode",
    "title": "00CBFDZ41R007",
    "text": "Basic model-less agent wikis provide local file reading, but lack structured multi-faceted node semantics (Article, Source, Talk, History), on-demand reification, and dependency tracking.",
    "parent": "BlockNode:00CBFDZ41R004",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R008",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R008:props:StringProp:00CBFDZ4NR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R008:props:StringProp:00CBFDZ4NR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R008",
    "text": "Solution: Local sub-agent spawning via standard `SKILL.md` contracts",
    "parent": "BlockNode:00CBFDZ41R003",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R009",
      "BlockNode:00CBFDZ41R00A",
      "BlockNode:00CBFDZ41R00B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R009",
    "@type": "BlockNode",
    "title": "00CBFDZ41R009",
    "text": "Aperas retains the lightweight procedural skill set (`SKILL.md`) in Phase 3 rather than forcing background API dependencies.",
    "parent": "BlockNode:00CBFDZ41R008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00A",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00A",
    "text": "Primary coding agents leverage native CLI primitives (headless process execution like `claude -p`), internal sub-agent tools, or direct local execution scripts to spawn isolated local child agents.",
    "parent": "BlockNode:00CBFDZ41R008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00B",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00B",
    "text": "Child sub-agents execute focused graph operations (AST parsing, WOQL traversals, span reification, Talk ledger updates) using the developer's existing authorized agent harness without incurring secondary API costs.",
    "parent": "BlockNode:00CBFDZ41R008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00C:props:StringProp:00CBFDZ4P0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00C:props:StringProp:00CBFDZ4P0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00C",
    "text": "Cognitive shift: Intelligence in data topology and transducers",
    "parent": "BlockNode:00CBFDZ41R003",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00D"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00D",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00D",
    "text": "Advanced agentic memory is achieved through deterministic TerminusDB schemas, Unified.js transducers, and structured `SKILL.md` instructions rather than perpetual background LLM calls.",
    "parent": "BlockNode:00CBFDZ41R00C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00E",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00E:props:StringProp:00CBFDZ4P8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00E:props:StringProp:00CBFDZ4P8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00E",
    "text": "Boundary validation & schema generation rationale",
    "parent": "BlockNode:00CBFDZ41G05Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00F",
      "BlockNode:00CBFDZ41R00G"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00F",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00F",
    "text": "Selection: TypeBox / Zod (TypeScript) & Pydantic (Python)",
    "parent": "BlockNode:00CBFDZ41R00E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00G",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00G:props:StringProp:00CBFDZ4PG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00G:props:StringProp:00CBFDZ4PG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00G",
    "text": "Role as perimeter transducers",
    "parent": "BlockNode:00CBFDZ41R00E",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00H",
      "BlockNode:00CBFDZ41R00J"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00H",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00H",
    "text": "Enforces strict schema contracts exclusively at external API, LLM tool-calling, and DB mutation boundaries.",
    "parent": "BlockNode:00CBFDZ41R00G",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00J",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00J",
    "text": "Keeps the core graph substrate fluid and unconstrained while guaranteeing type safety when communicating with deterministic runtimes.",
    "parent": "BlockNode:00CBFDZ41R00G",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00K",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00K:props:StringProp:00CBFDZ4PR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00K:props:StringProp:00CBFDZ4PR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00K",
    "text": "AST parsing & surface synchronization rationale",
    "parent": "BlockNode:00CBFDZ41G05Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00M",
      "BlockNode:00CBFDZ41R00N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00M",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00M",
    "text": "Selection: Unified.js (`remark` / `rehype`)",
    "parent": "BlockNode:00CBFDZ41R00K",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00N",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00N:props:StringProp:00CBFDZ4PR002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00N:props:StringProp:00CBFDZ4PR003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00N",
    "text": "Role in surface translation",
    "parent": "BlockNode:00CBFDZ41R00K",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00P"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00P",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00P",
    "text": "Parses Markdown surface views into clean syntax trees (MDAST), enabling bidirectional extraction of block IDs, wikilinks, and metadata tags for sync back to the underlying graph.",
    "parent": "BlockNode:00CBFDZ41R00N",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00Q",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00Q:props:StringProp:00CBFDZ4Q0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00Q:props:StringProp:00CBFDZ4Q0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00Q",
    "text": "Agent procedure and communication layer rationale",
    "parent": "BlockNode:00CBFDZ41G05Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00R",
      "BlockNode:00CBFDZ41R00S",
      "BlockNode:00CBFDZ41R00X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00R",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00R",
    "text": "Selection: Loadable Agent Skills (`SKILL.md`) + Direct Service APIs",
    "parent": "BlockNode:00CBFDZ41R00Q",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00S",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00S:props:StringProp:00CBFDZ4Q0002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00S:props:StringProp:00CBFDZ4Q8000",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00S",
    "text": "Primary role of Agent Skills",
    "parent": "BlockNode:00CBFDZ41R00Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00T",
      "BlockNode:00CBFDZ41R00V",
      "BlockNode:00CBFDZ41R00W"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00T",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00T",
    "text": "Encapsulates procedural knowledge, view-projection templates, sub-agent spawning contracts, and domain rules into human-readable Markdown files.",
    "parent": "BlockNode:00CBFDZ41R00S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00V",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00V",
    "text": "Enables progressive context loading where agents load specific skill definitions dynamically when executing targeted tasks rather than bloating the system prompt.",
    "parent": "BlockNode:00CBFDZ41R00S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00W",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00W",
    "text": "Provides portable, vendor-agnostic behavioral definitions allowing any agent model or framework to execute projection and ingestion routines predictably.",
    "parent": "BlockNode:00CBFDZ41R00S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00X",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R00X:props:StringProp:00CBFDZ4Q8001",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R00X:props:StringProp:00CBFDZ4QG000",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R00X",
    "text": "Elimination of persistent protocol middleware",
    "parent": "BlockNode:00CBFDZ41R00Q",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R00Y",
      "BlockNode:00CBFDZ41R00Z"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R00Y",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00Y",
    "text": "Replaces permanently running RPC servers with direct service calls (GraphQL / REST endpoints) to system service agents.",
    "parent": "BlockNode:00CBFDZ41R00X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R00Z",
    "@type": "BlockNode",
    "title": "00CBFDZ41R00Z",
    "text": "Maintains a clean service boundary between procedural guidance (skills) and backend execution (service endpoints).",
    "parent": "BlockNode:00CBFDZ41R00X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R010",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R010:props:StringProp:00CBFDZ4QR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R010:props:StringProp:00CBFDZ4QR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R010",
    "text": "Multi-Agent Division of Labor on a Knowledge Graph",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R011",
      "BlockNode:00CBFDZ41R016",
      "BlockNode:00CBFDZ41R01A",
      "BlockNode:00CBFDZ41R01P",
      "BlockNode:00CBFDZ41R01V"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R011",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R011:props:StringProp:00CBFDZ4QR002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R011:props:StringProp:00CBFDZ4QR003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R011",
    "text": "Historical precedent and human wetware substrate",
    "parent": "BlockNode:00CBFDZ41R010",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R012",
      "BlockNode:00CBFDZ41R013",
      "BlockNode:00CBFDZ41R014",
      "BlockNode:00CBFDZ41R015"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R012",
    "@type": "BlockNode",
    "title": "00CBFDZ41R012",
    "text": "Multi-faceted reference model: Inspired by long-standing collaborative systems like Wikipedia (Article, Talk, History, Source), human knowledge work has always relied on multi-perspective nodes rather than monolithic text blobs.",
    "parent": "BlockNode:00CBFDZ41R011",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R013",
    "@type": "BlockNode",
    "title": "00CBFDZ41R013",
    "text": "Software engineering and science operate as a distributed graph running across human mental models and neural networks.",
    "parent": "BlockNode:00CBFDZ41R011",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R014",
    "@type": "BlockNode",
    "title": "00CBFDZ41R014",
    "text": "Artifacts like source code, architecture diagrams, and tickets are lossy projections rendered from an underlying mental graph.",
    "parent": "BlockNode:00CBFDZ41R011",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R015",
    "@type": "BlockNode",
    "title": "00CBFDZ41R015",
    "text": "Deep reads historically relied on manual navigation, while deep writes relied on mental impact tracing across dependencies.",
    "parent": "BlockNode:00CBFDZ41R011",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R016",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R016:props:StringProp:00CBFDZ4R0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R016:props:StringProp:00CBFDZ4R0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R016",
    "text": "Role of LLMs and agents in the architecture",
    "parent": "BlockNode:00CBFDZ41R010",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R017",
      "BlockNode:00CBFDZ41R018",
      "BlockNode:00CBFDZ41R019"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R017",
    "@type": "BlockNode",
    "title": "00CBFDZ41R017",
    "text": "LLMs function as bidirectional projection engines rather than the primary enterprise brain.",
    "parent": "BlockNode:00CBFDZ41R016",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R018",
    "@type": "BlockNode",
    "title": "00CBFDZ41R018",
    "text": "The knowledge graph serves as the shared, explicit substrate representing the externalized mental model.",
    "parent": "BlockNode:00CBFDZ41R016",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R019",
    "@type": "BlockNode",
    "title": "00CBFDZ41R019",
    "text": "Specialized agents act as dynamic lenses translating between high-dimensional graph topology and low-dimensional human interfaces.",
    "parent": "BlockNode:00CBFDZ41R016",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01A",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01A:props:StringProp:00CBFDZ4RG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01A:props:StringProp:00CBFDZ4RG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01A",
    "text": "Division of agent roles",
    "parent": "BlockNode:00CBFDZ41R010",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01B",
      "BlockNode:00CBFDZ41R01F",
      "BlockNode:00CBFDZ41R01J"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01B",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01B:props:StringProp:00CBFDZ4RG002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01B:props:StringProp:00CBFDZ4RG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01B",
    "text": "Projection agents (read side / rendering)",
    "parent": "BlockNode:00CBFDZ41R01A",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01C",
      "BlockNode:00CBFDZ41R01D",
      "BlockNode:00CBFDZ41R01E"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01C",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01C",
    "text": "View-specific synthesis extracts subgraphs – such as nodes, edges, evidence, and ADRs – projecting them into target formats like source code, executive summaries, API specs, or Mermaid diagrams.",
    "parent": "BlockNode:00CBFDZ41R01B",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01D",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01D",
    "text": "Context pruning and zoom levels filter graph depth based on the target audience.",
    "parent": "BlockNode:00CBFDZ41R01B",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01E",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01E",
    "text": "Transclusion annotators attach backlink references and provenance pointers to UI elements so readers can drill back into the underlying subgraph.",
    "parent": "BlockNode:00CBFDZ41R01B",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01F",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01F:props:StringProp:00CBFDZ4RR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01F:props:StringProp:00CBFDZ4RR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01F",
    "text": "Intake and ingestion agents (write side / interpretation)",
    "parent": "BlockNode:00CBFDZ41R01A",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01G",
      "BlockNode:00CBFDZ41R01H"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01G",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01G",
    "text": "Input parsing ingests unstructured human artifacts – including PR comments, chat threads, commit messages, and raw notes – resolving them into structured semantic entities and relationships.",
    "parent": "BlockNode:00CBFDZ41R01F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01H",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01H",
    "text": "Reification and provenance create explicit assertion nodes tracking who stated a requirement, when, and under what rationale instead of overwriting nodes.",
    "parent": "BlockNode:00CBFDZ41R01F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01J",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01J:props:StringProp:00CBFDZ4S0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01J:props:StringProp:00CBFDZ4S0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01J",
    "text": "Impact and coherence agents (ripple managers)",
    "parent": "BlockNode:00CBFDZ41R01A",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01K",
      "BlockNode:00CBFDZ41R01M",
      "BlockNode:00CBFDZ41R01N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01K",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01K",
    "text": "Semantic dependency traversal walks the graph along `affects`, `derives_from`, or `constrains` edges to map potential impact zones when a node changes.",
    "parent": "BlockNode:00CBFDZ41R01J",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01M",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01M",
    "text": "Advisory invalidation marks affected views or nodes as “stale” or “questioned”, preparing diff proposals or triage queues for human review rather than blindly rewriting downstream documents.",
    "parent": "BlockNode:00CBFDZ41R01J",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01N",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01N",
    "text": "Contradiction sweeping identifies edge conflicts before they silently pollute other views.",
    "parent": "BlockNode:00CBFDZ41R01J",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01P",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01P:props:StringProp:00CBFDZ4S8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01P:props:StringProp:00CBFDZ4S8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01P",
    "text": "Pitfalls of complete automation",
    "parent": "BlockNode:00CBFDZ41R010",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01Q",
      "BlockNode:00CBFDZ41R01R",
      "BlockNode:00CBFDZ41R01S",
      "BlockNode:00CBFDZ41R01T"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01Q",
    "text": "Full automation creates brittle, over-constrained systems that fight human intuition and fluid workflow context.",
    "parent": "BlockNode:00CBFDZ41R01P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01R",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01R",
    "text": "Human mental graphs handle ambiguity, shifting constraints, and informal consensus seamlessly, which deterministic engines collapse.",
    "parent": "BlockNode:00CBFDZ41R01P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01S",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01S",
    "text": "Complete automated overwriting risks context collapse by treating exploratory comments or questions as hard state updates.",
    "parent": "BlockNode:00CBFDZ41R01P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01T",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01T",
    "text": "The goal is explicit externalization and human-in-the-loop advisory feedback, not autonomous machine control.",
    "parent": "BlockNode:00CBFDZ41R01P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01V",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01V:props:StringProp:00CBFDZ4SG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01V:props:StringProp:00CBFDZ4SG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01V",
    "text": "Key design challenges",
    "parent": "BlockNode:00CBFDZ41R010",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R01W",
      "BlockNode:00CBFDZ41R01X",
      "BlockNode:00CBFDZ41R01Y"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R01W",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01W",
    "text": "Idempotent round-tripping requires updating only the modified delta when an agent parses human edits on rendered Markdown without clobbering unrendered graph metadata.",
    "parent": "BlockNode:00CBFDZ41R01V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01X",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01X",
    "text": "Granularity of nodes requires balancing atomic entities to avoid noise and coarse documents to preserve deep read benefits.",
    "parent": "BlockNode:00CBFDZ41R01V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01Y",
    "@type": "BlockNode",
    "title": "00CBFDZ41R01Y",
    "text": "Loose coupling of agent roles keeps agents stateless and lets the graph own canonical state so any agent can crash or be swapped out seamlessly.",
    "parent": "BlockNode:00CBFDZ41R01V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R01Z",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R01Z:props:StringProp:00CBFDZ4SR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R01Z:props:StringProp:00CBFDZ4T0000",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R01Z",
    "text": "State of the Art in Agentic Knowledge Graphs",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R020",
      "BlockNode:00CBFDZ41R023",
      "BlockNode:00CBFDZ41R02C",
      "BlockNode:00CBFDZ41R02S"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R020",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R020:props:StringProp:00CBFDZ4T0001",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R020:props:StringProp:00CBFDZ4T0002",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R020",
    "text": "Convergence of paradigm",
    "parent": "BlockNode:00CBFDZ41R01Z",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R021",
      "BlockNode:00CBFDZ41R022"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R021",
    "@type": "BlockNode",
    "title": "00CBFDZ41R021",
    "text": "Current frontier systems combine neurosymbolic AI, dynamic GraphRAG, and bidirectional knowledge maintenance.",
    "parent": "BlockNode:00CBFDZ41R020",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R022",
    "@type": "BlockNode",
    "title": "00CBFDZ41R022",
    "text": "Knowledge graphs are treated as living, canonical state machines rather than static retrieval databases, with multi-agent swarms acting as read–write transducers.",
    "parent": "BlockNode:00CBFDZ41R020",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R023",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R023:props:StringProp:00CBFDZ4T8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R023:props:StringProp:00CBFDZ4T8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R023",
    "text": "Key architectural pillars",
    "parent": "BlockNode:00CBFDZ41R01Z",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R024",
      "BlockNode:00CBFDZ41R028"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R024",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R024:props:StringProp:00CBFDZ4T8002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R024:props:StringProp:00CBFDZ4T8003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R024",
    "text": "Temporal and non-destructive graph maintenance",
    "parent": "BlockNode:00CBFDZ41R023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R025",
      "BlockNode:00CBFDZ41R026",
      "BlockNode:00CBFDZ41R027"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R025",
    "@type": "BlockNode",
    "title": "00CBFDZ41R025",
    "text": "Systems attach assertion timestamps and validity intervals rather than mutating or overwriting nodes.",
    "parent": "BlockNode:00CBFDZ41R024",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R026",
    "@type": "BlockNode",
    "title": "00CBFDZ41R026",
    "text": "Reified evidence nodes store assertions alongside provenance pointers like source conversation, commit, and rationale.",
    "parent": "BlockNode:00CBFDZ41R024",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R027",
    "@type": "BlockNode",
    "title": "00CBFDZ41R027",
    "text": "State-of-the-art frameworks maintain continuous memory graphs that track state transitions across multi-hop reasoning paths.",
    "parent": "BlockNode:00CBFDZ41R024",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R028",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R028:props:StringProp:00CBFDZ4TG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41R028:props:StringProp:00CBFDZ4TG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41R028",
    "text": "Multi-agent division of labor",
    "parent": "BlockNode:00CBFDZ41R023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R029",
      "BlockNode:00CBFDZ41R02A",
      "BlockNode:00CBFDZ41R02B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R029",
    "@type": "BlockNode",
    "title": "00CBFDZ41R029",
    "text": "Intent and parsing agents convert unstructured human inputs into structured graph operations.",
    "parent": "BlockNode:00CBFDZ41R028",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R02A",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02A",
    "text": "Graph traversal and subgraph fetchers execute multi-hop traversals to pull contextual clusters including decisions, backlinks, and evidence.",
    "parent": "BlockNode:00CBFDZ41R028",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R02B",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02B",
    "text": "Synthesis and projection agents render retrieved subgraphs into target artifacts like Markdown runbooks, API specs, or Mermaid diagrams.",
    "parent": "BlockNode:00CBFDZ41R028",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R02C",
    "@type": "BlockNode",
