    "title": "00D253J400002",
    "text": "**Root cause** (read from the code)",
    "parent": "BlockNode:00D253J400001",
    "type": "listItem",
    "children": [
      "BlockNode:00D253J400003",
      "BlockNode:00D253J400004",
