    "children": []
  },
  {
    "@id": "BlockNode:00CS1593N800X",
    "@type": "BlockNode",
    "title": "**Never Make Code Corrections Yourself**",
    "text": "**Never Make Code Corrections Yourself**:",
    "parent": "BlockNode:00CS1593N800P",
    "type": "listItem",
    "children": [
      "BlockNode:00CS1593N800Y",
      "BlockNode:00CS1593N800Z"
    ]
  },
  {
    "@id": "BlockNode:00CS1593N800Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593N800Y:props:StringProp:00CS15984G000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CS1593N800Y:props:StringProp:00CS15984G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593N800Y",
    "text": "If a test fails or the diff is incomplete, **DO NOT** edit the source files.",
    "parent": "BlockNode:00CS1593N800X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593N800Z",
    "@type": "BlockNode",
    "title": "00CS1593N800Z",
    "text": "Formulate a follow-up `**Ask**` in `.threads/coder.md` and hand it back to the Coder.",
    "parent": "BlockNode:00CS1593N800X",
    "type": "listItem",
    "children": []
  },
  {
