    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00R",
    "@type": "BlockNode",
    "title": "##### View Triage & Management",
    "parent": "BlockNode:00CS1593MG00R",
    "type": "heading",
    "children": [
      "BlockNode:00CS1593MR00S",
      "BlockNode:00CS1593MR00T",
