    "title": "00CDH8WQV8001",
    "text": "Export `main` from every `kgX.ts` (leaving the existing `if (process.argv[1]?.endsWith(...)) main()` self-invocation guard untouched underneath it).",
    "type": "listItem",
    "children": []
  },
