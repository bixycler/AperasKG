    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00B",
    "@type": "BlockNode",
    "title": "00CS1593MR00B",
    "text": "Deep read follows sources; **deep write is inherently backward** (you must inspect what a change breaks or makes stale).",
    "parent": "BlockNode:00CS1593MR008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00C",
    "@type": "BlockNode",
    "title": "##### Entering the Corpus",
    "text": "Choose an entry strategy based on your starting point:",
