        "target": "BlockNode:00CDBYV4TG007",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CDC0D59000Z:links:Link:00CDC0D8F8003:props:StringProp:00CDC0D8F8004",
