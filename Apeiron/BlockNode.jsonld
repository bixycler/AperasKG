        "@id": "BlockNode:00D2PCFDC0005:props:StringProp:00D2PCFSR8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "The exact moment of the stop",
    "text": "The exact moment of the stop: the shutdown leaves no log line, so it is read from the time of the run directory.",
    "parent": "BlockNode:00D2PCFDC0004",
    "type": "listItem",
    "children": []
  },
