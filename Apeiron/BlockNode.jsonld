  },
  {
    "@id": "BlockNode:00CJ6TGSYR001",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CJ6TGSYR001:props:StringProp:00CJ6TGT1G000",
        "@type": "StringProp",
        "key": "orderedList",
