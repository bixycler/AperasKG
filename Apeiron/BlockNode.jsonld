  {
    "@id": "BlockNode:00D40RVX48000",
    "@type": "BlockNode",
    "title": "**The ghost folder, the double start, and the next decisions, 2026-10-15**",
    "text": "**The ghost folder, the double start, and the next decisions, 2026-10-15**: the user settled the ghost folder, the roots, the tests and the profiles.",
    "parent": "BlockNode:00D3XJ7GTR001",
    "type": "listItem",
    "children": [
      "BlockNode:00D40RVX4G000",
      "BlockNode:00D40RVX5R000",
