    ],
    "title": "00C64YWX6000M",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20043",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20043",
    "children": [],
    "text": "Universal inline addressability (`<span>` tag pattern)",
    "title": "00C64YWX6000N",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20044",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20044",
    "children": [
      "BlockNode/00C5FPAA20045",
      "BlockNode/00C5FPAA2004A",
      "BlockNode/00C5FPAA2004F"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX6000P",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20045",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20045",
    "children": [
