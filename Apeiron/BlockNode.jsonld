  },
  {
    "@id": "BlockNode/00C5FPAA2003Q",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2003Q",
    "children": [],
    "text": "The continuous, readable Markdown or HTML text flow where prose reads naturally without visual disruption.",
    "title": "00C64YWX60007",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2003R",
