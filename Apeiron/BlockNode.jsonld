        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D6HAJNS0003",
    "text": "Which text the Coder followed when it wrote the command; its Report names the redirect and not the source.",
    "parent": "BlockNode:00D6HAJNS0002",
    "type": "listItem",
    "children": []
  },
