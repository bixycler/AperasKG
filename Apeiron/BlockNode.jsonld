        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00D21P0ZP8001:links:Link:00D21P1AYR000:props:StringProp:00D21P1AYR001",
            "@type": "StringProp",
            "key": "position",
            "value": "994"
