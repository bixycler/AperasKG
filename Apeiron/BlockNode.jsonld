  },
  {
    "@id": "BlockNode/00C5FPAA20025",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20025",
    "children": [],
    "text": "Explicit tool calling (via service APIs) where the coding agent queries or mutates perata through high-level skills at an abstract level.",
