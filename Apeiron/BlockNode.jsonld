        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D1A2AY6800B",
    "text": "How it came to be a block with only a link is unknown.",
    "parent": "BlockNode:00D1A2AY6800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D1A2AY6800C",
    "@type": "BlockNode",
    "title": "00D1A2AY6800C",
    "text": "Whether other unreachable blocks of this shape exist is not counted.",
    "parent": "BlockNode:00D1A2AY6800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D1A2AY6800D",
    "@type": "BlockNode",
    "title": "00D1A2AY6800D",
    "text": "**Fix directions**",
    "parent": "BlockNode:00D1A2AY68001",
    "type": "listItem",
    "children": [
      "BlockNode:00D1A2AY6800E"
    ]
  },
  {
    "@id": "BlockNode:00D1A2AY6800E",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D1A2AY6800E:props:StringProp:00D1A2BAEG002",
