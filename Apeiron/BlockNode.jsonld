  },
  {
    "@id": "BlockNode:00CF46W4QG002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CF46W4QG002:props:StringProp:00CF46W5Z8000",
        "@type": "StringProp",
