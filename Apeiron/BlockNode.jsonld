    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NR012",
    "@type": "BlockNode",
    "title": "**Retype in place**",
    "text": "**Retype in place**: Use `aperas retype <ref> --to <type>` to change node kinds without losing identity, backlinks, or history.",
