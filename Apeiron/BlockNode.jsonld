    "children": []
  },
  {
    "@id": "BlockNode:00CDBZ77F000B",
    "@type": "BlockNode",
    "title": "00CDC0RFD800G",
    "text": "**Recognizing `aperas://` and `#fragment` forms** (`astParser.ts` + `apeironNgn/artifacts.ts`)",
    "parent": "BlockNode:00CDBZ77F0002",
    "type": "listItem",
    "children": [
      "BlockNode:00CDBZ77F000C",
      "BlockNode:00CDBZ77F000D",
      "BlockNode:00CDBZ77F000E",
      "BlockNode:00CDBZ77F000F",
      "BlockNode:00CDBZ77F000G",
      "BlockNode:00CDBZ77F000H",
      "BlockNode:00CDBZ77F000J"
    ]
  },
  {
    "@id": "BlockNode:00CDBZ77F000C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CDBZ77F000C:props:StringProp:00CE599VC0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CDBZ77F000C:props:StringProp:00CE599VC0001",
        "@type": "StringProp",
