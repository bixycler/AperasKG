  },
  {
    "@id": "BlockNode:00CE8XWZK0009",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00CE8XWZK0009:links:Link:00CEC1DMD0000",
        "@type": "Link",
        "target": "BlockNode:00CEA5Y5JG003",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CE8XWZK0009:links:Link:00CEC1DMD0000:props:StringProp:00CEC1DMD8000",
