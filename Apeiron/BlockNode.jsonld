        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "UI projection layer rationale",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001J",
    "@type": "BlockNode",
    "title": "00C7BJZCV001J",
    "blockId": "00C7BJZCV001J",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001H",
    "text": "Selection: SolidJS",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001K",
    "@type": "BlockNode",
    "title": "00C7BJZCV001K",
    "blockId": "00C7BJZCV001K",
    "children": [
      "BlockNode/00C7BJZCV001M",
      "BlockNode/00C7BJZCV001N",
      "BlockNode/00C7BJZCV001P"
    ],
    "parent": "BlockNode/00C7BJZCV001H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001K/props/StringProp/4AZ1fSN8twmHtq3s",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV001K/props/StringProp/gWYCEnzVMJHkFeZ3",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Fine-grained signal reactivity without Virtual DOM overhead",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001M",
    "@type": "BlockNode",
    "title": "00C7BJZCV001M",
    "blockId": "00C7BJZCV001M",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001K",
    "text": "Compiles template JSX into direct DOM mutations without virtual DOM reconciliation cascades.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001N",
    "@type": "BlockNode",
    "title": "00C7BJZCV001N",
    "blockId": "00C7BJZCV001N",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001K",
    "text": "Updating an inline `<span>`, reified node badge, or discourse trail tag updates only the exact target DOM element with near-zero CPU footprint.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001P",
    "@type": "BlockNode",
    "title": "00C7BJZCV001P",
    "blockId": "00C7BJZCV001P",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001K",
    "text": "Prevents micro-stutters and re-rendering cascades across massive, deeply nested outliner trees.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001Q",
    "@type": "BlockNode",
    "title": "00C7BJZCV001Q",
    "blockId": "00C7BJZCV001Q",
    "children": [
      "BlockNode/00C7BJZCV001R",
      "BlockNode/00C7BJZCV001S"
    ],
    "parent": "BlockNode/00C7BJZCV001H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001Q/props/StringProp/j4vGd_1IZY14prqu",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV001Q/props/StringProp/qaP1x6snndW9qaTN",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Optimization for agentic deep-read views",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001R",
    "@type": "BlockNode",
    "title": "00C7BJZCV001R",
    "blockId": "00C7BJZCV001R",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001Q",
    "text": "Since AI agents execute structural graph edits via backend transducers, the UI functions primarily as a high-performance **deep-read projection layer** with light human annotation.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001S",
    "@type": "BlockNode",
    "title": "00C7BJZCV001S",
    "blockId": "00C7BJZCV001S",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001Q",
    "text": "Signals subscribe directly to background streaming deltas, updating rendered views surgically as agents commit updates.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001T",
    "@type": "BlockNode",
    "title": "00C7BJZCV001T",
    "blockId": "00C7BJZCV001T",
    "children": [
      "BlockNode/00C7BJZCV001V"
    ],
    "parent": "BlockNode/00C7BJZCV001H",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001T/props/StringProp/0yt6pjuprsvLRiM8",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV001T/props/StringProp/eRDCSPxHLExON03a",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Relativistic context ergonomics",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001V",
    "@type": "BlockNode",
    "title": "00C7BJZCV001V",
    "blockId": "00C7BJZCV001V",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001T",
    "text": "Solid primitives (`createSignal`, `createContext`, `createStore`) map naturally to relativistic node scoping, allowing child nodes and inline spans to bind locally without triggering parent component re-evaluations.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001W",
    "@type": "BlockNode",
    "title": "00C7BJZCV001W",
    "blockId": "00C7BJZCV001W",
    "children": [
      "BlockNode/00C7BJZCV001X",
      "BlockNode/00C7BJZCV0021",
      "BlockNode/00C7BJZCV0025"
    ],
    "parent": "BlockNode/00C7BJZCV0012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001W/props/StringProp/ifgsFN9C7yhKpEEb",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV001W/props/StringProp/ynGnSG0UKKCzYM4V",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Preservation of manual skills & zero-background-API sub-agent execution rationale",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001X",
    "@type": "BlockNode",
    "title": "00C7BJZCV001X",
    "blockId": "00C7BJZCV001X",
    "children": [
      "BlockNode/00C7BJZCV001Y",
      "BlockNode/00C7BJZCV001Z",
      "BlockNode/00C7BJZCV0020"
    ],
    "parent": "BlockNode/00C7BJZCV001W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001X/props/StringProp/agNViLkzF_3al3OL",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV001X/props/StringProp/arszLkxL3H8_SQhG",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Background constraint: Coding-agent-only environment",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001Y",
    "@type": "BlockNode",
    "title": "00C7BJZCV001Y",
    "blockId": "00C7BJZCV001Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001X",
    "text": "In enterprise or research lab environments, developers are provided access exclusively to primary coding agents (e.g., Claude Code, Antigravity) via local harnesses, while secondary external LLM API keys are strictly blocked or restricted.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001Z",
    "@type": "BlockNode",
    "title": "00C7BJZCV001Z",
    "blockId": "00C7BJZCV001Z",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001X",
    "text": "Traditional agentic memory frameworks (such as Letta/MemGPT, Mem0, or Zep) rely on background API servers running continuous summarization and vector indexing loops, making them unusable under zero-API constraints.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0020",
    "@type": "BlockNode",
    "title": "00C7BJZCV0020",
    "blockId": "00C7BJZCV0020",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001X",
    "text": "Basic model-less agent wikis provide local file reading, but lack structured multi-faceted node semantics (Article, Source, Talk, History), on-demand reification, and dependency tracking.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0021",
    "@type": "BlockNode",
    "title": "00C7BJZCV0021",
    "blockId": "00C7BJZCV0021",
    "children": [
      "BlockNode/00C7BJZCV0022",
      "BlockNode/00C7BJZCV0023",
      "BlockNode/00C7BJZCV0024"
    ],
    "parent": "BlockNode/00C7BJZCV001W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0021/props/StringProp/T1_G1HN7iY6bWmZp",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0021/props/StringProp/jszstDf3XB-ZxGBu",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Solution: Local sub-agent spawning via standard `SKILL.md` contracts",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0022",
    "@type": "BlockNode",
    "title": "00C7BJZCV0022",
    "blockId": "00C7BJZCV0022",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0021",
    "text": "Aperas retains the lightweight procedural skill set (`SKILL.md`) in Phase 3 rather than forcing background API dependencies.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0023",
    "@type": "BlockNode",
    "title": "00C7BJZCV0023",
    "blockId": "00C7BJZCV0023",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0021",
    "text": "Primary coding agents leverage native CLI primitives (headless process execution like `claude -p`), internal sub-agent tools, or direct local execution scripts to spawn isolated local child agents.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0024",
    "@type": "BlockNode",
    "title": "00C7BJZCV0024",
    "blockId": "00C7BJZCV0024",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0021",
    "text": "Child sub-agents execute focused graph operations (AST parsing, WOQL traversals, span reification, Talk ledger updates) using the developer's existing authorized agent harness without incurring secondary API costs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0025",
    "@type": "BlockNode",
    "title": "00C7BJZCV0025",
    "blockId": "00C7BJZCV0025",
    "children": [
      "BlockNode/00C7BJZCV0026"
    ],
    "parent": "BlockNode/00C7BJZCV001W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0025/props/StringProp/e-1DeUHTfqwVatqg",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0025/props/StringProp/xMdKYnmu6l7EhBHh",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Cognitive shift: Intelligence in data topology and transducers",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0026",
    "@type": "BlockNode",
    "title": "00C7BJZCV0026",
    "blockId": "00C7BJZCV0026",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0025",
    "text": "Advanced agentic memory is achieved through deterministic TerminusDB schemas, Unified.js transducers, and structured `SKILL.md` instructions rather than perpetual background LLM calls.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0027",
    "@type": "BlockNode",
    "title": "00C7BJZCV0027",
    "blockId": "00C7BJZCV0027",
    "children": [
      "BlockNode/00C7BJZCV0028",
      "BlockNode/00C7BJZCV0029"
    ],
    "parent": "BlockNode/00C7BJZCV0012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0027/props/StringProp/WLABUY3bNiheayS2",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0027/props/StringProp/jjMo9v7o23ryAuxP",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Boundary validation & schema generation rationale",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0028",
    "@type": "BlockNode",
    "title": "00C7BJZCV0028",
    "blockId": "00C7BJZCV0028",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0027",
    "text": "Selection: TypeBox / Zod (TypeScript) & Pydantic (Python)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0029",
    "@type": "BlockNode",
    "title": "00C7BJZCV0029",
    "blockId": "00C7BJZCV0029",
    "children": [
      "BlockNode/00C7BJZCV002A",
      "BlockNode/00C7BJZCV002B"
    ],
    "parent": "BlockNode/00C7BJZCV0027",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0029/props/StringProp/6QsT4Aj9bthM3D_h",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0029/props/StringProp/tmVbxeaXceNoXDbK",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Role as perimeter transducers",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002A",
    "@type": "BlockNode",
    "title": "00C7BJZCV002A",
    "blockId": "00C7BJZCV002A",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0029",
    "text": "Enforces strict schema contracts exclusively at external API, LLM tool-calling, and DB mutation boundaries.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002B",
    "@type": "BlockNode",
    "title": "00C7BJZCV002B",
    "blockId": "00C7BJZCV002B",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0029",
    "text": "Keeps the core graph substrate fluid and unconstrained while guaranteeing type safety when communicating with deterministic runtimes.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002C",
    "@type": "BlockNode",
    "title": "00C7BJZCV002C",
    "blockId": "00C7BJZCV002C",
    "children": [
      "BlockNode/00C7BJZCV002D",
      "BlockNode/00C7BJZCV002E"
    ],
    "parent": "BlockNode/00C7BJZCV0012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002C/props/StringProp/7W1gyCwWTgJzXx-E",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002C/props/StringProp/hH_Hko9wb2f63M9m",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "AST parsing & surface synchronization rationale",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002D",
    "@type": "BlockNode",
    "title": "00C7BJZCV002D",
    "blockId": "00C7BJZCV002D",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002C",
    "text": "Selection: Unified.js (`remark` / `rehype`)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002E",
    "@type": "BlockNode",
    "title": "00C7BJZCV002E",
    "blockId": "00C7BJZCV002E",
    "children": [
      "BlockNode/00C7BJZCV002F"
    ],
    "parent": "BlockNode/00C7BJZCV002C",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002E/props/StringProp/SwEbmej9DtPilhx_",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002E/props/StringProp/y2dlSiZxNboQBu0T",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Role in surface translation",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002F",
    "@type": "BlockNode",
    "title": "00C7BJZCV002F",
    "blockId": "00C7BJZCV002F",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002E",
    "text": "Parses Markdown surface views into clean syntax trees (MDAST), enabling bidirectional extraction of block IDs, wikilinks, and metadata tags for sync back to the underlying graph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002G",
    "@type": "BlockNode",
    "title": "00C7BJZCV002G",
    "blockId": "00C7BJZCV002G",
    "children": [
      "BlockNode/00C7BJZCV002H",
      "BlockNode/00C7BJZCV002J",
      "BlockNode/00C7BJZCV002P"
    ],
    "parent": "BlockNode/00C7BJZCV0012",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002G/props/StringProp/4YrG0m65q6JuwzRc",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002G/props/StringProp/IeBASvrUtiP5_Z8j",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Agent procedure and communication layer rationale",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002H",
    "@type": "BlockNode",
    "title": "00C7BJZCV002H",
    "blockId": "00C7BJZCV002H",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002G",
    "text": "Selection: Loadable Agent Skills (`SKILL.md`) + Direct Service APIs",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002J",
    "@type": "BlockNode",
    "title": "00C7BJZCV002J",
    "blockId": "00C7BJZCV002J",
    "children": [
      "BlockNode/00C7BJZCV002K",
      "BlockNode/00C7BJZCV002M",
      "BlockNode/00C7BJZCV002N"
    ],
    "parent": "BlockNode/00C7BJZCV002G",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002J/props/StringProp/EmQTobFvcWcIgO6Z",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV002J/props/StringProp/_rkpqTax3EYLYbeI",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Primary role of Agent Skills",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002K",
    "@type": "BlockNode",
    "title": "00C7BJZCV002K",
    "blockId": "00C7BJZCV002K",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002J",
    "text": "Encapsulates procedural knowledge, view-projection templates, sub-agent spawning contracts, and domain rules into human-readable Markdown files.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002M",
    "@type": "BlockNode",
    "title": "00C7BJZCV002M",
    "blockId": "00C7BJZCV002M",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002J",
    "text": "Enables progressive context loading where agents load specific skill definitions dynamically when executing targeted tasks rather than bloating the system prompt.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002N",
    "@type": "BlockNode",
    "title": "00C7BJZCV002N",
    "blockId": "00C7BJZCV002N",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002J",
    "text": "Provides portable, vendor-agnostic behavioral definitions allowing any agent model or framework to execute projection and ingestion routines predictably.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002P",
    "@type": "BlockNode",
    "title": "00C7BJZCV002P",
    "blockId": "00C7BJZCV002P",
    "children": [
      "BlockNode/00C7BJZCV002Q",
      "BlockNode/00C7BJZCV002R"
    ],
    "parent": "BlockNode/00C7BJZCV002G",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002P/props/StringProp/2VVEa1sn07A9mJdO",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV002P/props/StringProp/5GiY47doTtG3SI6V",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Elimination of persistent protocol middleware",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002Q",
    "@type": "BlockNode",
    "title": "00C7BJZCV002Q",
    "blockId": "00C7BJZCV002Q",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002P",
    "text": "Replaces permanently running RPC servers with direct service calls (GraphQL / REST endpoints) to system service agents.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002R",
    "@type": "BlockNode",
    "title": "00C7BJZCV002R",
    "blockId": "00C7BJZCV002R",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002P",
    "text": "Maintains a clean service boundary between procedural guidance (skills) and backend execution (service endpoints).",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002S",
    "@type": "BlockNode",
    "title": "00C7BJZCV002S",
    "blockId": "00C7BJZCV002S",
    "children": [
      "BlockNode/00C7BJZCV002T",
      "BlockNode/00C7BJZCV002Z",
      "BlockNode/00C7BJZCV0033",
      "BlockNode/00C7BJZCV003F",
      "BlockNode/00C7BJZCV003M"
    ],
    "parent": "BlockNode/00C7BJZCTG004",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002S/props/StringProp/L247gKdTjTT-Q1Xg",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002S/props/StringProp/yTP-1R0jgA9_s-1C",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Multi-Agent Division of Labor on a Knowledge Graph",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002T",
    "@type": "BlockNode",
    "title": "00C7BJZCV002T",
    "blockId": "00C7BJZCV002T",
    "children": [
      "BlockNode/00C7BJZCV002V",
      "BlockNode/00C7BJZCV002W",
      "BlockNode/00C7BJZCV002X",
      "BlockNode/00C7BJZCV002Y"
    ],
    "parent": "BlockNode/00C7BJZCV002S",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002T/props/StringProp/_9quvsbbvCRlGm4o",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002T/props/StringProp/qccUkYOBx2K8SMau",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Historical precedent and human wetware substrate",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002V",
    "@type": "BlockNode",
    "title": "00C7BJZCV002V",
    "blockId": "00C7BJZCV002V",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002T",
    "text": "Multi-faceted reference model: Inspired by long-standing collaborative systems like Wikipedia (Article, Talk, History, Source), human knowledge work has always relied on multi-perspective nodes rather than monolithic text blobs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002W",
    "@type": "BlockNode",
    "title": "00C7BJZCV002W",
    "blockId": "00C7BJZCV002W",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002T",
    "text": "Software engineering and science operate as a distributed graph running across human mental models and neural networks.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002X",
    "@type": "BlockNode",
    "title": "00C7BJZCV002X",
    "blockId": "00C7BJZCV002X",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002T",
    "text": "Artifacts like source code, architecture diagrams, and tickets are lossy projections rendered from an underlying mental graph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002Y",
    "@type": "BlockNode",
    "title": "00C7BJZCV002Y",
    "blockId": "00C7BJZCV002Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002T",
    "text": "Deep reads historically relied on manual navigation, while deep writes relied on mental impact tracing across dependencies.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV002Z",
    "@type": "BlockNode",
    "title": "00C7BJZCV002Z",
    "blockId": "00C7BJZCV002Z",
    "children": [
      "BlockNode/00C7BJZCV0030",
      "BlockNode/00C7BJZCV0031",
      "BlockNode/00C7BJZCV0032"
    ],
    "parent": "BlockNode/00C7BJZCV002S",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV002Z/props/StringProp/Zxn8sOSOB74XYBoF",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV002Z/props/StringProp/eNOKEYxD_G4bFpP1",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Role of LLMs and agents in the architecture",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0030",
    "@type": "BlockNode",
    "title": "00C7BJZCV0030",
    "blockId": "00C7BJZCV0030",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002Z",
    "text": "LLMs function as bidirectional projection engines rather than the primary enterprise brain.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0031",
    "@type": "BlockNode",
    "title": "00C7BJZCV0031",
    "blockId": "00C7BJZCV0031",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002Z",
    "text": "The knowledge graph serves as the shared, explicit substrate representing the externalized mental model.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0032",
    "@type": "BlockNode",
    "title": "00C7BJZCV0032",
    "blockId": "00C7BJZCV0032",
    "children": [],
    "parent": "BlockNode/00C7BJZCV002Z",
    "text": "Specialized agents act as dynamic lenses translating between high-dimensional graph topology and low-dimensional human interfaces.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0033",
    "@type": "BlockNode",
    "title": "00C7BJZCV0033",
    "blockId": "00C7BJZCV0033",
    "children": [
      "BlockNode/00C7BJZCV0034",
      "BlockNode/00C7BJZCV0038",
      "BlockNode/00C7BJZCV003B"
    ],
    "parent": "BlockNode/00C7BJZCV002S",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0033/props/StringProp/deUzdwE9e9RDjjZN",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0033/props/StringProp/dstreoyYP-p8xGFT",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Division of agent roles",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0034",
    "@type": "BlockNode",
    "title": "00C7BJZCV0034",
    "blockId": "00C7BJZCV0034",
    "children": [
      "BlockNode/00C7BJZCV0035",
      "BlockNode/00C7BJZCV0036",
      "BlockNode/00C7BJZCV0037"
    ],
    "parent": "BlockNode/00C7BJZCV0033",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0034/props/StringProp/HbOdjUzBZwQwk3Hq",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0034/props/StringProp/lTaKLLPE2OVqPObF",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Projection agents (read side / rendering)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0035",
    "@type": "BlockNode",
    "title": "00C7BJZCV0035",
    "blockId": "00C7BJZCV0035",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0034",
    "text": "View-specific synthesis extracts subgraphs – such as nodes, edges, evidence, and ADRs – projecting them into target formats like source code, executive summaries, API specs, or Mermaid diagrams.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0036",
    "@type": "BlockNode",
    "title": "00C7BJZCV0036",
    "blockId": "00C7BJZCV0036",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0034",
    "text": "Context pruning and zoom levels filter graph depth based on the target audience.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0037",
    "@type": "BlockNode",
    "title": "00C7BJZCV0037",
    "blockId": "00C7BJZCV0037",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0034",
    "text": "Transclusion annotators attach backlink references and provenance pointers to UI elements so readers can drill back into the underlying subgraph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0038",
    "@type": "BlockNode",
    "title": "00C7BJZCV0038",
    "blockId": "00C7BJZCV0038",
    "children": [
      "BlockNode/00C7BJZCV0039",
      "BlockNode/00C7BJZCV003A"
    ],
    "parent": "BlockNode/00C7BJZCV0033",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0038/props/StringProp/NyEBmchFvSLpYYtH",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0038/props/StringProp/dmUkA7KJBC40It_o",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Intake and ingestion agents (write side / interpretation)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0039",
    "@type": "BlockNode",
    "title": "00C7BJZCV0039",
    "blockId": "00C7BJZCV0039",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0038",
    "text": "Input parsing ingests unstructured human artifacts – including PR comments, chat threads, commit messages, and raw notes – resolving them into structured semantic entities and relationships.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003A",
    "@type": "BlockNode",
    "title": "00C7BJZCV003A",
    "blockId": "00C7BJZCV003A",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0038",
    "text": "Reification and provenance create explicit assertion nodes tracking who stated a requirement, when, and under what rationale instead of overwriting nodes.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003B",
    "@type": "BlockNode",
    "title": "00C7BJZCV003B",
    "blockId": "00C7BJZCV003B",
    "children": [
      "BlockNode/00C7BJZCV003C",
      "BlockNode/00C7BJZCV003D",
      "BlockNode/00C7BJZCV003E"
    ],
    "parent": "BlockNode/00C7BJZCV0033",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003B/props/StringProp/-aIaMtXfN2xmYWsq",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV003B/props/StringProp/lUkQTk41ucjyQjOB",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Impact and coherence agents (ripple managers)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003C",
    "@type": "BlockNode",
    "title": "00C7BJZCV003C",
    "blockId": "00C7BJZCV003C",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003B",
    "text": "Semantic dependency traversal walks the graph along `affects`, `derives_from`, or `constrains` edges to map potential impact zones when a node changes.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003D",
    "@type": "BlockNode",
    "title": "00C7BJZCV003D",
    "blockId": "00C7BJZCV003D",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003B",
    "text": "Advisory invalidation marks affected views or nodes as “stale” or “questioned”, preparing diff proposals or triage queues for human review rather than blindly rewriting downstream documents.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003E",
    "@type": "BlockNode",
    "title": "00C7BJZCV003E",
    "blockId": "00C7BJZCV003E",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003B",
    "text": "Contradiction sweeping identifies edge conflicts before they silently pollute other views.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003F",
    "@type": "BlockNode",
    "title": "00C7BJZCV003F",
    "blockId": "00C7BJZCV003F",
    "children": [
      "BlockNode/00C7BJZCV003G",
      "BlockNode/00C7BJZCV003H",
      "BlockNode/00C7BJZCV003J",
      "BlockNode/00C7BJZCV003K"
    ],
    "parent": "BlockNode/00C7BJZCV002S",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003F/props/StringProp/fbeMHWjrK-N6gcLk",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV003F/props/StringProp/vwn6BF1HHDv90Q--",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Pitfalls of complete automation",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003G",
    "@type": "BlockNode",
    "title": "00C7BJZCV003G",
    "blockId": "00C7BJZCV003G",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003F",
    "text": "Full automation creates brittle, over-constrained systems that fight human intuition and fluid workflow context.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003H",
    "@type": "BlockNode",
    "title": "00C7BJZCV003H",
    "blockId": "00C7BJZCV003H",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003F",
    "text": "Human mental graphs handle ambiguity, shifting constraints, and informal consensus seamlessly, which deterministic engines collapse.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003J",
    "@type": "BlockNode",
    "title": "00C7BJZCV003J",
    "blockId": "00C7BJZCV003J",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003F",
    "text": "Complete automated overwriting risks context collapse by treating exploratory comments or questions as hard state updates.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003K",
    "@type": "BlockNode",
    "title": "00C7BJZCV003K",
    "blockId": "00C7BJZCV003K",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003F",
    "text": "The goal is explicit externalization and human-in-the-loop advisory feedback, not autonomous machine control.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003M",
    "@type": "BlockNode",
    "title": "00C7BJZCV003M",
    "blockId": "00C7BJZCV003M",
    "children": [
      "BlockNode/00C7BJZCV003N",
      "BlockNode/00C7BJZCV003P",
      "BlockNode/00C7BJZCV003Q"
    ],
    "parent": "BlockNode/00C7BJZCV002S",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003M/props/StringProp/fA0O9v-UJzrhBX3X",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV003M/props/StringProp/rCiIwU_H45hSKbFK",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Key design challenges",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003N",
    "@type": "BlockNode",
    "title": "00C7BJZCV003N",
    "blockId": "00C7BJZCV003N",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003M",
    "text": "Idempotent round-tripping requires updating only the modified delta when an agent parses human edits on rendered Markdown without clobbering unrendered graph metadata.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003P",
    "@type": "BlockNode",
    "title": "00C7BJZCV003P",
    "blockId": "00C7BJZCV003P",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003M",
    "text": "Granularity of nodes requires balancing atomic entities to avoid noise and coarse documents to preserve deep read benefits.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003Q",
    "@type": "BlockNode",
    "title": "00C7BJZCV003Q",
    "blockId": "00C7BJZCV003Q",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003M",
    "text": "Loose coupling of agent roles keeps agents stateless and lets the graph own canonical state so any agent can crash or be swapped out seamlessly.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003R",
    "@type": "BlockNode",
    "title": "00C7BJZCV003R",
    "blockId": "00C7BJZCV003R",
    "children": [
      "BlockNode/00C7BJZCV003S",
      "BlockNode/00C7BJZCV003W",
      "BlockNode/00C7BJZCV0045",
      "BlockNode/00C7BJZCV004J"
    ],
    "parent": "BlockNode/00C7BJZCTG004",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003R/props/StringProp/PC_p2ENu_CMwp19P",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV003R/props/StringProp/aAOrIMDv7RnKhkA1",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "State of the Art in Agentic Knowledge Graphs",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003S",
    "@type": "BlockNode",
    "title": "00C7BJZCV003S",
    "blockId": "00C7BJZCV003S",
    "children": [
      "BlockNode/00C7BJZCV003T",
      "BlockNode/00C7BJZCV003V"
    ],
    "parent": "BlockNode/00C7BJZCV003R",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003S/props/StringProp/ez0KgFofOscH0VkE",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV003S/props/StringProp/os3ReuV73rFpslN4",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Convergence of paradigm",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003T",
    "@type": "BlockNode",
    "title": "00C7BJZCV003T",
    "blockId": "00C7BJZCV003T",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003S",
    "text": "Current frontier systems combine neurosymbolic AI, dynamic GraphRAG, and bidirectional knowledge maintenance.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003V",
    "@type": "BlockNode",
    "title": "00C7BJZCV003V",
    "blockId": "00C7BJZCV003V",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003S",
    "text": "Knowledge graphs are treated as living, canonical state machines rather than static retrieval databases, with multi-agent swarms acting as read–write transducers.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003W",
    "@type": "BlockNode",
    "title": "00C7BJZCV003W",
    "blockId": "00C7BJZCV003W",
    "children": [
      "BlockNode/00C7BJZCV003X",
      "BlockNode/00C7BJZCV0041"
    ],
    "parent": "BlockNode/00C7BJZCV003R",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003W/props/StringProp/1y9Ckq5wj9pyvkdX",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV003W/props/StringProp/ecWopOlPMx6Bh9C7",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Key architectural pillars",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003X",
    "@type": "BlockNode",
    "title": "00C7BJZCV003X",
    "blockId": "00C7BJZCV003X",
    "children": [
      "BlockNode/00C7BJZCV003Y",
      "BlockNode/00C7BJZCV003Z",
      "BlockNode/00C7BJZCV0040"
    ],
    "parent": "BlockNode/00C7BJZCV003W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV003X/props/StringProp/360owJqX1lMZdn3Q",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV003X/props/StringProp/8hBAoH3c6d2n7fGv",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Temporal and non-destructive graph maintenance",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003Y",
    "@type": "BlockNode",
    "title": "00C7BJZCV003Y",
    "blockId": "00C7BJZCV003Y",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003X",
    "text": "Systems attach assertion timestamps and validity intervals rather than mutating or overwriting nodes.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV003Z",
    "@type": "BlockNode",
    "title": "00C7BJZCV003Z",
    "blockId": "00C7BJZCV003Z",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003X",
    "text": "Reified evidence nodes store assertions alongside provenance pointers like source conversation, commit, and rationale.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0040",
    "@type": "BlockNode",
    "title": "00C7BJZCV0040",
    "blockId": "00C7BJZCV0040",
    "children": [],
    "parent": "BlockNode/00C7BJZCV003X",
    "text": "State-of-the-art frameworks maintain continuous memory graphs that track state transitions across multi-hop reasoning paths.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0041",
    "@type": "BlockNode",
    "title": "00C7BJZCV0041",
    "blockId": "00C7BJZCV0041",
    "children": [
      "BlockNode/00C7BJZCV0042",
      "BlockNode/00C7BJZCV0043",
      "BlockNode/00C7BJZCV0044"
    ],
    "parent": "BlockNode/00C7BJZCV003W",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0041/props/StringProp/QZOdQqPZ3RdU8pk2",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV0041/props/StringProp/SfnaA87L2NSKY82J",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Multi-agent division of labor",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0042",
    "@type": "BlockNode",
    "title": "00C7BJZCV0042",
    "blockId": "00C7BJZCV0042",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0041",
    "text": "Intent and parsing agents convert unstructured human inputs into structured graph operations.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0043",
    "@type": "BlockNode",
    "title": "00C7BJZCV0043",
    "blockId": "00C7BJZCV0043",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0041",
    "text": "Graph traversal and subgraph fetchers execute multi-hop traversals to pull contextual clusters including decisions, backlinks, and evidence.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0044",
    "@type": "BlockNode",
    "title": "00C7BJZCV0044",
    "blockId": "00C7BJZCV0044",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0041",
    "text": "Synthesis and projection agents render retrieved subgraphs into target artifacts like Markdown runbooks, API specs, or Mermaid diagrams.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0045",
    "@type": "BlockNode",
    "title": "00C7BJZCV0045",
    "blockId": "00C7BJZCV0045",
    "children": [
      "BlockNode/00C7BJZCV0046",
      "BlockNode/00C7BJZCV0049",
      "BlockNode/00C7BJZCV004C",
      "BlockNode/00C7BJZCV004F"
    ],
    "parent": "BlockNode/00C7BJZCV003R",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0045/props/StringProp/A1Zd4koE4AMcm_ms",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0045/props/StringProp/Q2zWIjnzELaYEjVQ",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Spectrum of maturity across read–write capabilities",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0046",
    "@type": "BlockNode",
    "title": "00C7BJZCV0046",
    "blockId": "00C7BJZCV0046",
    "children": [
      "BlockNode/00C7BJZCV0047",
      "BlockNode/00C7BJZCV0048"
    ],
    "parent": "BlockNode/00C7BJZCV0045",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0046/props/StringProp/WRe7oUXqK6zRQjBM",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0046/props/StringProp/c1Za48TahlOa0dzs",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Deep read (provenance projection)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0047",
    "@type": "BlockNode",
    "title": "00C7BJZCV0047",
    "blockId": "00C7BJZCV0047",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0046",
    "text": "Uses subgraph extraction and multi-hop GraphRAG.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0048",
    "@type": "BlockNode",
    "title": "00C7BJZCV0048",
    "blockId": "00C7BJZCV0048",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0046",
    "text": "Reached high maturity in frameworks like Microsoft GraphRAG, Neo4j Agentic ADK, and HippoRAG.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0049",
    "@type": "BlockNode",
    "title": "00C7BJZCV0049",
    "blockId": "00C7BJZCV0049",
    "children": [
      "BlockNode/00C7BJZCV004A",
      "BlockNode/00C7BJZCV004B"
    ],
    "parent": "BlockNode/00C7BJZCV0045",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0049/props/StringProp/yvRcYIuxRgJp0Lhf",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0049/props/StringProp/zazabWxrCfYh4ZUM",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Write ingestion (text to knowledge graph)",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004A",
    "@type": "BlockNode",
    "title": "00C7BJZCV004A",
    "blockId": "00C7BJZCV004A",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0049",
    "text": "Uses schema-guided extraction with human-intent agents.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004B",
    "@type": "BlockNode",
    "title": "00C7BJZCV004B",
    "blockId": "00C7BJZCV004B",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0049",
    "text": "Reached medium–high maturity in systems like AGENTiGraph and LlamaIndex Property Graphs.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004C",
    "@type": "BlockNode",
    "title": "00C7BJZCV004C",
    "blockId": "00C7BJZCV004C",
    "children": [
      "BlockNode/00C7BJZCV004D",
      "BlockNode/00C7BJZCV004E"
    ],
    "parent": "BlockNode/00C7BJZCV0045",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV004C/props/StringProp/JxYESUiJOTi1V1Fn",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV004C/props/StringProp/b0qxp8aZmgF4ANy7",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Advisory impact propagation",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004D",
    "@type": "BlockNode",
    "title": "00C7BJZCV004D",
    "blockId": "00C7BJZCV004D",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004C",
    "text": "Uses dependency traversal flagging stale nodes or diff queues.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004E",
    "@type": "BlockNode",
    "title": "00C7BJZCV004E",
    "blockId": "00C7BJZCV004E",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004C",
    "text": "Reached medium maturity in temporal KG agents and reactive engines.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004F",
    "@type": "BlockNode",
    "title": "00C7BJZCV004F",
    "blockId": "00C7BJZCV004F",
    "children": [
      "BlockNode/00C7BJZCV004G",
      "BlockNode/00C7BJZCV004H"
    ],
    "parent": "BlockNode/00C7BJZCV0045",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV004F/props/StringProp/dMFzx3oBZ4gwNrPH",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV004F/props/StringProp/eMsgWmdfIVTsdDtP",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Bidirectional round-tripping",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004G",
    "@type": "BlockNode",
    "title": "00C7BJZCV004G",
    "blockId": "00C7BJZCV004G",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004F",
    "text": "Edits a rendered view to update only delta nodes in the knowledge graph.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004H",
    "@type": "BlockNode",
    "title": "00C7BJZCV004H",
    "blockId": "00C7BJZCV004H",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004F",
    "text": "Remains an emerging bleeding-edge capability explored in moldable development and project lenses.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004J",
    "@type": "BlockNode",
    "title": "00C7BJZCV004J",
    "blockId": "00C7BJZCV004J",
    "children": [
      "BlockNode/00C7BJZCV004K",
      "BlockNode/00C7BJZCV004M",
      "BlockNode/00C7BJZCV004N"
    ],
    "parent": "BlockNode/00C7BJZCV003R",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV004J/props/StringProp/GvBK4LQsGGwSSVMD",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV004J/props/StringProp/W3HZ5uT4VxNyFkSX",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Open challenges on the bleeding edge",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004K",
    "@type": "BlockNode",
    "title": "00C7BJZCV004K",
    "blockId": "00C7BJZCV004K",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004J",
    "text": "Lossless round-trip synchronization struggles to parse human edits on high-level summaries back into exact graph diffs without dropping unrendered metadata.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004M",
    "@type": "BlockNode",
    "title": "00C7BJZCV004M",
    "blockId": "00C7BJZCV004M",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004J",
    "text": "Granularity calibration frequently pulls too much AST-level noise or too little contextual rationale during subgraph extraction.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV004N",
    "@type": "BlockNode",
    "title": "00C7BJZCV004N",
    "blockId": "00C7BJZCV004N",
    "children": [],
    "parent": "BlockNode/00C7BJZCV004J",
    "text": "Human–agent advisory loops shift away from autonomous destructive overwrites toward advisory invalidation, generating visual diffs and triage queues for human verification.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZHS0000",
    "@type": "BlockNode",
    "title": "Document Root",
    "blockId": "00C7BJZHS0000",
    "children": [
      "BlockNode/00C7BJZHS0001"
    ],
    "parent": "ArtifactNode/00C7BJHG4G000",
    "type": "root",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZHS0001",
    "@type": "BlockNode",
    "title": "00C7BJZHS0001",
    "blockId": "00C7BJZHS0001",
    "children": [
      "BlockNode/00C7BJZHS0002"
    ],
    "parent": "BlockNode/00C7BJZHS0000",
    "props": [
      {
        "@id": "BlockNode/00C7BJZHS0001/props/StringProp/HJsT-HOhX8_u4H3w",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZHS0001/props/StringProp/L4-TxA3ymOkDgb8d",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "- ## Aperas Development Status\n\t- See `Aperas-architecture.md` for how everything below is actually built (schema, CRUD, WOQL/GraphQL, version control, artifact ingestion, KG backup/restore, cross-machine remotes).\n\t- Phase 0: Substrate and Core Skills — **Done**. Every roadmap item (`Aperas-design.md`'s Development Roadmap, Phase 0) is implemented and live-verified: direct database integration, `npm run verify:phase0 -- --db` + `npm run build` both clean, basic assertion authoring, and agentic query tools. The two loose ends open as of the last full review — cross-machine push/pull/rebase reconciliation, and Stage 2 item 5's title/text split — are both closed below. \"Not yet started\" (further down) carries nothing Phase-0-scoped anymore, only Phase 1/2 items.\n\t\t- Schema initialization — done.\n\t\t- Artifact tracking & on-demand ingestion (`kg:track`/`kg:ingest`) — done, re-verified live against the new fractal-ontology schema.\n\t\t- **Fixed**: `kg:ingest` used to double-ingest `README.md`. `listArtifactFiles` (`artifacts.ts`) walked every `.md` file with no README exclusion, so `ingestAllArtifacts` ingested a directory's `README.md` as an ordinary `ArtifactNode`+`BlockNode` tree — in addition to, and completely independently of, `folders.ts`'s `buildFolderTree`, which separately parses the same file and correctly folds its content into the owning `FolderNode`. Reproduced live before fixing: a real `README.md` produced both a correct `FolderNode`-absorbed copy and a separate stray `ArtifactNode`. Root cause: `artifacts.ts` and `folders.ts` each walked `AperasKG/artifacts/` with their own file-listing logic, only one of which knew to skip README files. Fixed by factoring one shared `isReadmeFilename` predicate into `artifacts.ts` (which `folders.ts` now imports instead of its own local constant) and applying it in `listArtifactFiles` — plus the same guard added to `kg:track`'s explicit single-file path (`kgCli.ts`), which bypasses that list entirely and needed its own check.\n\t\t- Automated tracking trigger (`AperasKG/.githooks/post-commit`, `post-index-change`) — done: `post-commit` auto-runs a scoped `kg:track` on commit, `post-index-change` auto-runs a full `kg:track` sweep on branch checkout / `git reset` (including `--hard`, which fires no hook of its own) — `post-checkout` was tried too but dropped as redundant once `post-index-change` was confirmed to fire alongside it with equivalent coverage.\n\t\t- Temporal commit management — done (`versionControl.ts` is class-agnostic — branch/commit/diff/reset operations, unaffected by the schema redesign below).\n\t\t- Cross-machine remotes — **done**: reciprocal SSH-tunneled TerminusDB remotes (reciprocal remote endpoints), `fetch` confirmed both directions. `push`/`pull` themselves only fast-forward and fail with `no_common_history` once both sides have diverged past their common point (no `--force` flag exists either) — reconciliation is `rebase` (replays one side's divergent commits onto a base built from the other, see `tdb-cli-status-walkthrough.md` §6) or, for a deliberate discard-and-replace sync, `reset` directly onto a fetched commit id (§7, reciprocal in both directions, no intermediate branch needed). Both live-verified against the real `aperas` DB: rebased a 9-commit remote-derived branch onto local `main`'s 1120 commits (zero conflicts; the reverse direction hangs — direction matters, see §6.2), then promoted `main` to the reconciled 1129-commit tip via `reset`.\n\t\t- Reference tooling — `skills/terminusdb/references/cli.md` audited end-to-end against a live server and the official CLI docs.\n\t- KG backup/restore — `restore.sh`/`tdb-log.sh`/`tdb-doc.sh` relocated to `Aperas/scripts/` and re-scoped as Core-Engine infra (documented in `Aperas-architecture.md` §1/§8), not domain-KG-specific — `db/` itself is gone from `AperasKG/`. `tdb-cross-diff.sh` was *not* migrated with them (its own hash-gated rewrite was already pending the ID-identity fix); genuinely gone, not relocated.\n\t- **RESOLVED** Design issue: \"AperasKG stores the KG\" was answered with a DB backup, not a KG export — corrected\n\t\t- `AperasKG` was designed to hold both the domain artifacts and the KG itself, but the KG lives in a DB — so the earlier approach to fulfilling that second half was to associate whole-TerminusDB-volume/bundle backups (`restore.sh`, briefly stored under `AperasKG/db/`) with the domain-KG repo. That coupling was the wrong move: a git-tracked repo has no good way to diff, merge, or meaningfully version an opaque binary DB snapshot, and (per the `#2509` investigation above) those snapshots turned out not to even be portable between independent TerminusDB stores — so it wasn't a viable backup path for `AperasKG` even setting the git-coupling problem aside.\n\t\t- Corrected via the JSON-LD import/export round-trip (`web/src/lib/export.ts`, `kg:export`/`kg:import`, `Aperas-architecture.md` §5): `AperasKG/Apeiron/` holds the canonical graph content as plain, diffable JSON-LD text, committed to the same repo as `AperasKG/artifacts/` — an ordinary `git commit` over that directory is now the KG's backup, `kg:import` is the restore path.\n\t\t- `restore.sh`'s whole-volume/bundle mechanism (§6) is unaffected and stays as-is — it's TerminusDB server infrastructure (Docker-volume disaster recovery), a different, unrelated concern from how `AperasKG` records its own content. Likewise, the SSH-tunneled TerminusDB remotes (§7) are unrelated to `AperasKG` — that's cross-machine sync for the TerminusDB server itself, not something this redesign touches.\n\t- **Fixed**: TerminusDB database renamed `aperas_apeiron` → `aperas` — the `aperas_` prefix was project-namespacing for a database name that already only ever means one thing on this dedicated instance, and `Apeiron` names a philosophical/architectural role (the fluid core substrate), not a resource identifier; naming the database after the project itself was simpler and avoided that mismatch. Migrated live via the JSON-LD round-trip rather than any TerminusDB-native rename (there isn't one — only `createDatabase`/`deleteDatabase`): `kg:export` from the old database, `kg:import` into a freshly created `aperas`, content parity verified class-by-class via the same order-independent `hashDocSet` hash `kg:import`'s own skip-if-unchanged check uses (all 5 matched: schema, `ArtifactNode`, `BlockNode`, `FolderNode`, `Assertion`), then the old `aperas_apeiron` database deleted. All defaults (`client.ts`, `tdb-log.sh`, `tdb-doc.sh`, `restore.sh`) and doc mentions updated to match.\n\t- **Fixed**: full migration to the fractal ontology, `FolderNode` implemented, `npm run verify:phase0 -- --db` and `npm run build` both passing (see \"RESOLVED\" entries below for detail).\n\t- **Fixed**: `ArtifactNode` missing `@inherits: [\"BaseNode\"]` in `schema.json` — added, live and verified (`kg:track`/`kg:ingest` run cleanly against it).\n\t- **RESOLVED** Design issue: Positional identity replaced by Fractal Ontology\n\t\t- The legacy flat `DocumentNode` / `BlockNode` / `SpanNode` schema was entirely eliminated.\n\t\t- Designed and implemented a universal, recursive `BlockNode` topology (Fractal Ontology) rooted in `ArtifactNode`.\n\t\t- Schema updated to pure JSON-LD (`schema.json`), avoiding TypeScript interface duplication.\n\t\t- IDs & content fingerprint — **implemented and live-verified** (`Aperas-core-ontology-design.md` §1). `web/src/lib/snowflake.ts` generates the 64-bit Snowflake-style identifier (timestamp + machine identity w/ personal failover + sequence counter, 13-char Crockford Base32); `astParser.ts` uses it for every `blockId` instead of the old content hash. `ArtifactNode.contentHash` renamed to `fileHash` throughout (`artifacts.ts`, `schema.json`) to match §1.B's file-domain-only fingerprint — no structural/recursive hash. Verified live: cleared stale pre-redesign `ArtifactNode`/`BlockNode` docs, ran `kg:track`+`kg:ingest` across all 8 artifacts (1144 blocks total, including a 648-block single-artifact burst), zero id collisions. Also found and fixed a real pre-existing bug while verifying: `getArtifactRecord` treated a missing document's raw 404 response (a string, not a thrown error) as a valid record, so untracked artifacts silently reported \"unchanged\" instead of erroring. Reconciliation (best-effort content matching, §1.C history in Appendix F) remains unimplemented — no code needed it yet, since ingestion so far has only ever run against uningested artifacts.\n\t\t- Ingestion (`astParser.ts` and `artifacts.ts`) now parses Markdown into a deeply nested tree structure and commits the entire fractal tree via `ArtifactNode.root` in a single TerminusDB operation. Note: a plain `getDocument` read only ever returns `root`/`children` as reference ids, not the nested tree, so full-tree reads go through `getArtifactTreeViaGraphQL` (`graphql.ts`) instead — deliberately, not because the Document API is incapable of it (see `Aperas-architecture.md` §2's \"Read-path note\" for the full investigation, including a filed upstream bug, [terminusdb/terminusdb#2512](https://github.com/terminusdb/terminusdb/issues/2512)).\n\t\t- `FolderNode` — **implemented and live-verified** (`Aperas-core-ontology-design.md` §4.A). `web/src/lib/folders.ts` walks `AperasKG/artifacts/`, builds one `FolderNode` per directory, absorbs each directory's own `README.md` (parsed blocks become the folder's children; the file itself is never exposed as a separate `ArtifactNode`), and references nested `FolderNode`s/`ArtifactNode`s by id. Wired into `npm run kg:ingest`, which now rebuilds the whole folder tree in the same run as artifact ingestion. Added one concrete `Assertion` class (inherits the previously-uninstantiable abstract `BaseEdge`) to `schema.json`, needed to let `crud.ts`/`woql.ts` actually write/query extrinsic edges — documented in `Aperas-core-ontology-design.md` §2.D. `FolderNode`/`ArtifactNode` are now Snowflake-keyed (`folderId`/`artifactId`), `path` a plain mutable field — see the \"Reconciliation matching\" entry below for the full migration.\n\t\t- `crud.ts`/`woql.ts`/`graphql.ts`/`verifyPhase0.ts` — **migrated off the dead pre-redesign schema and live-verified**. `crud.ts` now provides `insertAssertion`/`deleteAssertionsInvolvingNode` for the new `Assertion` type; `woql.ts` queries `Assertion.source`/`predicate`/`target` (node-typed, not the old flat `xsd:string` `subjectId`/`objectId`) in both directions plus one-hop impact propagation; `graphql.ts` replaced the removed `docId`-scoped block query with `getArtifactTreeViaGraphQL` (bounded-depth nested `root`/`children` selection — GraphQL has no native recursion, so depth is generated explicitly, default 10). `verifyPhase0.ts` was rewritten into a full idempotent, self-cleaning live test of the whole pipeline (AST parsing → track/ingest → GraphQL tree read → `FolderNode` ingestion → `Assertion` CRUD + WOQL traversal → temporal commit management); `npm run verify:phase0 -- --db` and `npm run build` both confirmed passing.\n\t\t- **Discovered while wiring this up**: TerminusDB enforces referential integrity on document delete — deleting a still-referenced document (e.g. an `ArtifactNode` still listed in a `FolderNode.children`, or a `BlockNode` still pointed to by `ArtifactNode.root`) fails with a `SchemaCheckFailure`, not silently. The best-effort delete helpers in `crud.ts` (`deleteDocumentIfExists`/`deleteDocumentsIfExist`) used to swallow *all* errors on the assumption only \"not found\" could occur — that assumption was wrong and masked this failure mode; they now log instead of swallowing silently, and any caller managing referenced state (like `verifyPhase0.ts`'s cleanup) has to delete in reverse-reference order.\n\t\t- **Heading levels now define tree structure** — **implemented and live-verified**. `astParser.ts` gained `groupByHeadings`, a one-pass depth-stack transform run on every flat mdast sibling list before conversion: each heading becomes the parent of everything until a heading of depth <= its own. A doc with `# Title` / `## Section A` / `## Section B` now parses as nested (`Title` containing `Section A`, `Section B`, each with their own body), not a flat list under the root. Alongside this: every `BlockNode` now carries its raw mdast `type` (needed by reconciliation's leaf/container split below), and `list`/`listItem`/`blockquote` no longer carry the full-subtree-duplicate `text` they used to (confirmed live pre-fix: a `listItem`'s `text` byte-for-byte duplicated its own paragraph child's) — containers now carry no content of their own, by design.\n\t\t- **Reconciliation matching for re-ingestion** — **implemented and live-verified** (`Aperas-reconciliation-matching-design.md`, `Aperas-core-ontology-design.md` §1.B/§4.A/§4.B/Appendix G). New `web/src/lib/reconcile.ts`: a Gestalt (Ratcliff/Obershelp) tree diff — the longest-common-run algorithm behind Python's `difflib` — applied two-stage per level (Stage A anchors on leaf content by `heading XOR text`; Stage B aligns containers by type within the segments Stage A's anchors define), with ambiguous same-content duplicates declined rather than guessed. Matched `BlockNode`s reuse their old `blockId`; unmatched old ones get an explicit `tombstonedAt` (new field on `BaseNode`, inherited everywhere) rather than being silently orphaned; a block relocated to a different section is detected as a cross-parent move via the same mechanism, one level up from per-parent matching. `ArtifactNode`/`FolderNode` moved off `Lexical`-on-`path` to Snowflake ids (`artifactId`/`folderId`, same scheme as `BlockNode.blockId`), `path` now a plain mutable field with `title`/`text` added to `ArtifactNode` (filename / naive first-paragraph abstract, matching `FolderNode`'s existing shape) — this is what makes a file/folder rename a field update instead of a delete-and-recreate. Rename detection reuses the identical Gestalt-matching primitive one level up: on every `kg:track`/`kg:ingest` sweep, disk-only and DB-only leftover paths are matched by abstract-text similarity (`matchLeftoverByAbstract`) before falling back to plain add/remove. Wired into `ingestArtifact` (fires whenever a prior ingestion exists), `trackAllArtifacts`, and `ingestFolderTree`; `kgCli.ts` reports renamed/removed/reconciled counts alongside the existing tracked/ingested counts. Live-verified via `verifyPhase0.ts` (edit-and-reingest keeps unrelated `blockId`s stable, reports sane unchanged/added counts) and a manual rename test against a throwaway artifact (`artifactId` and `blockId`s survived a real on-disk move). Migrating the key scheme required clearing all pre-existing `ArtifactNode`/`FolderNode`/`BlockNode` documents first, since TerminusDB rejects a schema whose new required fields the old instance data doesn't have — the whole KG was then rebuilt from `AperasKG/artifacts/` via a full `kg:track` + `kg:ingest` sweep, per the project's disk-is-source-of-truth model.\n\t\t- **Artifact Projection** — **implemented and live-verified** (`Aperas-artifact-projection-design.md`, `Aperas-core-ontology-design.md` §5.A mode 1 of 3). New `web/src/lib/project.ts` serializes an `ArtifactNode`'s ingested `BlockNode` tree back into Markdown — canonical regeneration, not byte-exact: headings/paragraphs/code round-trip via their raw `title`/`text`, while `list`/`blockquote` are regenerated as clean Markdown (list items always blank-line-separated regardless of original tight/loose style; blockquote `> ` re-prefixed uniformly rather than trusting what the raw text happens to carry). Needed two new captured fields on `BlockNode` — `ordered`/`start` (list numbering) and `checked` (task-list checkbox) — both `Optional`, so unlike the `artifactId`/`type` migration this needed no DB wipe. Exposed via `npm run kg:project -- <path>`. Verified two ways: `verifyPhase0.ts`'s synthetic sample (every branch: ordered/unordered/task lists, nested list, blockquote, code) round-trips with zero drift by reusing `reconcile.ts`'s own matcher as the equivalence check; and, more usefully, running the same check against all 11 real artifacts in `AperasKG/artifacts/` surfaced two genuine bugs no synthetic sample had exercised — a nested code fence's closing `` ``` `` desyncing from its opening one because only a multi-line leaf's *first* line has container-required indentation stripped (every later line keeps its literal original-file column; fixed with a `dedent` normalization), and an *indented* (4-space) code block silently degrading into an ordinary paragraph because its raw slice carries no fence to re-emit (fixed by re-fencing it). After those two fixes, 9 of 11 real artifacts round-trip with zero drift; the other 2 each show one accepted, disclosed difference (absolute code-indentation depth normalized to the minimum; indented-style converted to fenced-style) — real content changes under exact-key matching, not bugs, per the design doc §8.\n\t\t- **Basic Assertion Authoring** — **implemented and live-verified** (`Aperas-basic-assertion-skill-design.md`). New `kg:assert`/`kg:assertions`/`kg:unassert` CLI commands (`kgCli.ts`) let a human or agent actually write and inspect a real `Assertion` — previously the only thing that ever called `insertAssertion` was a hardcoded synthetic edge in `verifyPhase0.ts`'s test harness. `source`/`target` accept either a full node id (direct addressing) or a bare artifact/folder path (query-based addressing, resolved via `getArtifactRecord`/the new `getFolderRecord`, artifact tried first since the two never collide) — block-level assertions stay direct-id-only; closing that gap became its own effort, see \"Agentic Query Tools\" below. New narrow `deleteAssertion` (`crud.ts`) does exact source/predicate/target deletion, distinct from the existing blunt `deleteAssertionsInvolvingNode` (kept for demo/reset cleanup only). Live end-to-end test against two real artifacts (assert → list → unassert → list-empty) surfaced one real bug: WOQL binds a literal-typed field (`predicate`, `xsd:string`) as a wrapped `{\"@type\", \"@value\"}` object rather than a plain string, unlike node-typed `source`/`target` bindings — `kg:assertions` printed `[object Object]` until fixed with an `unwrapLiteral` helper in `woql.ts`'s `queryNodeAssertions`. Never caught by `verifyPhase0.ts`'s existing Assertion test because that only checks binding presence/membership, never a literal field's actual value. Reordered from Phase 2 into Phase 0 itself (not merely Phase 1) per `Aperas-design.md`'s roadmap, so Phase 1 skill-building starts with it already available.\n\t\t- **Agentic Query Tools** — reordered from Phase 1 into Phase 0, design settled (`Aperas-agentic-query-tools-design.md`) — **implemented and live-verified**. Three CLI tools closing the block-level addressing gap Basic Assertion Authoring (above) left open, and making mode 3 of `Aperas-core-ontology-design.md` §5.A concrete for the first time: `kg:tree` (a deep structural map — depth-first with an optional depth bound; title-only by default), `kg:unfold`/`kg:fold` (the actual breadth-first primitive: one level, full content, the first code to ever give the long-inert `unfolded` flag a real effect), and `kg:search` (keyword/regex content search via `WOQL.re` — two unrestricted `title`/`text` queries rather than one per class, since the property names are shared across all three node classes and the id prefix alone already reveals kind). Smoke-tested against the real KG (`kg:tree`, `kg:search`, an `unfold`/`fold` round-trip on a real `BlockNode`, `kg:project`).\n\t\t  - **`unfolded` promoted from `BlockNode` to `BaseNode`** (§4.1) — the field had only ever lived on `BlockNode`, a leftover from before `ArtifactNode`/`FolderNode` existed as separate concrete classes rather than a deliberate restriction. `kg:unfold`/`kg:fold` now persist real state against any node kind, not just display normally with nothing to save for the other two. `kg:tree --unfolded` renders the *combined* shape a sequence of `kg:fold`/`kg:unfold` calls leaves behind in one walk instead of separate scrollback: a node prints full `text` instead of `title` exactly when its own parent has `unfolded === true`, recursion stops at a folded node (with a `(folded — kg:unfold <id> to expand)` hint naming the exact fix), and the walk's own root always stays title-only — composes with `--depth`/`--no-holders` unchanged.\n\t\t  - **Real bug found live during this promotion**: `trackArtifact`'s (`artifacts.ts`) and `buildFolderTree`'s (`folders.ts`) record-rebuild paths already carry forward fields like `text`/`root`/`ingestedHash` from the previous document on every re-track/re-ingest, but neither had ever needed to carry forward a *view-state* field before — `unfolded` would have been silently reset to folded on the very next `kg:track`/`kg:ingest` of an `ArtifactNode`/`FolderNode`, the same class of regression `reconcile.ts` was already fixed for on `BlockNode`. Fixed by adding `unfolded` to `normalizeArtifactDoc`'s carried-forward field set and threading `existingByPath` into `buildFolderTree` (which, unlike `ArtifactNode`, rebuilds its whole tree fresh from disk every run rather than reusing a stored record, so it has nothing to carry forward from without an explicit lookup). Confirmed live: unfolded an `ArtifactNode`, forced a real re-track (content hash change), and it stayed unfolded; same for a `FolderNode` across a direct `ingestFolderTree` re-run.\n\t\t- **Markdown → Fractal Tree Mapping** (`Aperas-markdown-fractal-mapping-design.md`) — **implemented and live-verified**: `heading`/`listItem` now *consume* (not copy) their leading paragraph as `text`, shallow, one node fewer per section; a `list` now dissolves into whichever `paragraph`/`listItem`/`heading` immediately precedes it (`orderedList`/`startIndex` becoming that adopting node's own `props`) rather than remaining a standalone node, orphaned only when nothing valid precedes it — including the case, found while implementing this, where two lists sit directly adjacent to each other (the second is orphaned, since a `list` itself is never a valid adoption anchor); a new generic `Prop`/`StringProp` mechanism (`BaseNode.props: Set<Prop>`, `props.ts`'s shared `getProp`/`setProp`) replaces the one-field-per-feature pattern, `orderedList`/`startIndex`/`checked` all migrated onto it; YAML frontmatter is extracted via `remark-frontmatter` and stored as one `props` entry on both `ArtifactNode` and `FolderNode` (`parseMarkdownTree` now returns `{root, frontmatter?}`); `folders.ts`'s README absorption got the same copy-to-consume fix. `project.ts`'s serializer was generalized to match: `heading`/`listItem` emit their consumed `text` before their children, and `renderChildren` scans for contiguous `listItem` runs anywhere in a node's children (not just a dedicated `list` case) using that node's own `props` for numbering. One real GraphQL wrinkle surfaced and fixed: `props: Set<Prop>` can't be queried with an inline fragment on `StringProp` (TerminusDB's generated GraphQL schema makes `Prop` its own concrete type, not an interface `StringProp` implements) — worked around via the generic `_json` field every generated type carries, parsed back into `{key, value}` by `graphql.ts`'s `normalizeProps`. `verify:phase0 -- --db` and `npm run build` both clean. Same known limitation as Artifact Projection/Agentic Query Tools above: already-ingested real artifacts won't reflect any of this until something forces their re-ingestion.\n\t- **Interactive Title & Cross-Link Authoring** (`Aperas-interactive-summarization-design.md`) — **implemented and live-verified**. Resolves Stage 2 item 5 below (`Aperas-fractal-ontology-implementation-plan.md`, \"AI-driven summarization... splitting blocks into `title` vs `text`\") — reframed per the project's own zero-background-API principle (`Aperas-design.md` Phase 3 rationale): no LLM call, the CLI just asks whoever is running it (human or an already-in-the-loop coding agent) directly. New `kg:title`/`kg:link` (`kgCli.ts`) prompt interactively for a real title on any still-unlabeled `BlockNode`, or cross-links a block's prose makes that wikilink-syntax extraction (`astParser.ts:92-106`) doesn't catch; both share a new `updateBlockNode` fetch-merge-replace primitive (`crud.ts`) since none existed before. A real regression this design surfaced and fixed before it could ship: `reconcileNode` (`reconcile.ts`) only carried `blockId` forward for a matched (content-unchanged) pair, so a title/link set today would've silently reverted on the artifact's next re-ingest — now carries `title`/`unfolded`/`links` forward too (`carryForwardFields`), and `resolveBlockLinks` (`artifacts.ts`) merges freshly-resolved wikilinks onto that carried-forward `links` instead of overwriting it. Two more bugs found live during this work, both fixed: `graphql.ts`'s block field selection never included `links` at all (so the carry-forward had nothing to carry — added a `links { _id }` selection plus a `normalizeLinks` step converting GraphQL's full-IRI `_id` to the short ref-id form `updateDocument` expects, mirroring the existing `_json`/`normalizeProps` pattern); and `rl.question()` (readline/promises) races against stream-end once real `await`s happen between prompts, which piped/non-interactive stdin (a coding agent driving the tool with pre-computed answers) hits — fixed by consuming the readline interface's own async iterator (`createLineReader`) instead. Live-verified end-to-end: a title and a cross-link set via these commands both survived a real re-ingestion round-trip, confirmed via direct `doc get`, not just the tools' own reported output.\n\t- **Deep Path Resolution** (`Aperas-deep-path-resolution-design.md`) — **implemented and live-verified**, both directions. `kg:path <id>` (id→path): a new `parent: Optional<BaseNode>` field on `BlockNode` (`astParser.ts`'s `stampParents`, re-run post-reconciliation since `carryForwardFields` reassigns `blockId`s), walked upward by `nodeRef.ts`'s `resolveIdToPath` to the owning `ArtifactNode`/`FolderNode`. `kg:resolve <path>` (path→id, the reverse): extends `nodeRef.ts`'s `resolveNodeRefOrNull` with the full deep-path grammar — `.`/`..`/leading `/` (Linux-flavored relative addressing, `--base <path>` for batch resolution), exact-then-prefix title matching with \"decline rather than guess\" on ambiguity, and `--create-holder` (a tombstone-like placeholder for a target that doesn't exist yet, tail-aligned `--titles` so a caller only supplies titles for segments actually being created) reaching all the way from a single heading up through imagining whole new `FolderNode`/`ArtifactNode` chains from nothing. Wired into `artifacts.ts`'s wikilink extractor (forward references to not-yet-written headings now resolve to a holder instead of being silently dropped) and backported into `kg:tree`/`kg:search` (a `(holder)` mark, `--no-holders` to filter — transparent for indentation in `kg:tree`, not a subtree prune, since a holder is per-node not per-branch). New `holder: Optional<xsd:boolean>` field on `BaseNode` (not a `Prop` — a first-class concept needed on every node kind, not parser-derived per-node metadata); `ArtifactNode.fileHash`/`lastTrackedAt` made `Optional` to let a holder `ArtifactNode` exist with no real file behind it yet.\n\n\t  Several real bugs found live during implementation, none of them the original design's own text (all consistent with what `Aperas-deep-path-resolution-design.md` itself now documents inline, §4/§7): a heading's leading `#`/`##` slugifying to leading dashes made prefix matching dead on arrival until the candidate's dashes were stripped before the `startsWith` check; writing a holder directly under an `ArtifactNode` failed schema check because its one child is the singular `root` field, not a `children` List; and, most fundamentally, resolving wikilinks *before* the tree's own write was a genuine chicken-and-egg bug (the implicit base needs an already-persisted `.parent` chain, so anything brand-new in the current edit would resolve against the *previous* ingestion's stale tree) — fixed by moving link resolution to a separate pass after the write, extracting/stripping each block's raw `linkCodes` beforehand since `schema.json` has no such field and leaving it in fails the write itself. `verifyPhase0.ts`'s wikilink test extended to cover all three shapes end-to-end (a bare snowflake code, a forward reference that becomes a real holder, and a still-genuinely-unresolvable one that correctly declines) rather than just the original single self-link case.\n\t- Not yet started\n\t\t- **Projection Engines (Phase 1)**: the Human UI (SolidJS read-projection, 'Hover Preview' link mechanism) remains undesigned — of the three modes in `Aperas-core-ontology-design.md` §5.A, mode 1 (Artifact Projection, now covering both `ArtifactNode` and `FolderNode` — see \"Markdown → Fractal Tree Mapping\" above) is implemented and mode 3 (Agentic Interface) is designed (Phase 0, above); only mode 2 (Human UI) is still untouched. Mode 1 now also writes to disk by default (`kg:project`, `--dry-run` to print instead) rather than print-only, per `Aperas-core-ontology-design.md` §1.B's \"the DB becomes the source of truth\" model.\n\t\t- **Assertion skill(s) (Phase 1)**: a loadable `SKILL.md` teaching a coding agent when/how to use the `kg:assert`/`kg:assertions`/`kg:unassert` CLI (built in Phase 0, above) — not yet designed.\n\t\t- Phase 2+ skills: ingestion-from-arbitrary-sources, *automated* graph search skill (the manual assertion primitive moved to Phase 0, see below), refactoring/lazy-atomization skill.\n\t- ## Appendix: cross-store `bundle`/`unbundle` incompatibility investigation\n\t\t- Historical record — the `restore.sh`/`bundle` workflow this investigation covers predates its relocation to `Aperas/scripts/` (see \"KG backup/restore\" above); kept for reference in case a similar mechanism is reintroduced.\n\t\t- Symptom: `aperas_apeiron_snapshot_A.bundle` (made on Host A) and `aperas_apeiron_snapshot_B.bundle` (made on Host B) each verify cleanly **only on their own origin machine**, and fail deterministically with `error(unknown_layer_reference(<hash>))` on the other — a different specific missing-layer hash each time.\n\t\t- An earlier pass at this investigation, run on a single host in isolation, found a byte pattern in a snapshot that looked like Latin-1/UTF-8 mojibake corruption (reversing it produced a plausible gzip header) and concluded the file was corrupted. **That conclusion was wrong and has been retracted** — the same file was later shown to unbundle perfectly on its own origin host, which a genuinely corrupted file cannot do. The byte pattern was a coincidental artifact, not evidence of corruption.\n\t\t- Ruled out version mismatch: both machines confirmed running byte-identical `TerminusDB v12.0.7 (57f2093baeafd65e16004e84b7b58e0c5cf72858)` / `terminusdb-store v0.19.8`.\n\t\t- Ruled out the `auto-optimize` community plugin (`/plugins/auto-optimize.pl`, a probabilistic post-commit layer squash/GC): disabled on both machines (moved the plugin file out, restarted), re-tested with a brand-new minimal scratch database — still failed cross-host identically.\n\t\t- Ruled out store \"age\": reproduced with a store `store init`'d seconds before the test, same as the destination.\n\t\t- **Decisive isolation, no second machine needed**: ran two independent TerminusDB containers (`terminusdb` and a throwaway `terminusdb-freshtest`, same image, same physical host, plugin off on both) and bundled/unbundled between them. Same failure. A positive control — unbundling the same file back into a *different database within its own originating container* — succeeded every time. This isolates the variable precisely: **it's not host A vs. host B, or even separate machines at all — it's any two independent TerminusDB stores (server instances/storage directories), even side-by-side on one host.**\n\t\t- Cross-checked against prior art: [terminusdb/terminusdb#1147](https://github.com/terminusdb/terminusdb/issues/1147) reports the identical symptom moving a bundle between two instances, never reproduced by the maintainer, closed stale/not-planned. [terminusdb/terminusdb#1235](https://github.com/terminusdb/terminusdb/pull/1235) (\"an initial effort to figure out #1147 without success\") added CLI bundle/unbundle tests that call `store.init()` exactly once and share that one store across every test — so its test suite never actually exercises the cross-store case, which is the one that fails.\n\t\t- The official [\"move a database between servers\" backup/restore guide](https://terminusdb.org/docs/enterprise-backup-restore/) is scoped to **Enterprise edition** (different mechanism: `/api/bundle` + `/api/unbundle` REST endpoints, target pre-created) — not a documented guarantee for the Community-edition CLI commands we're using.\n\t\t- Filed as [terminusdb/terminusdb#2509](https://github.com/terminusdb/terminusdb/issues/2509), including the two-store repro and a note about the test-coverage gap in #1235. Draft/record kept at `terminusdb-issue-bundle-cross-store.md`.\n\t\t- Conclusion for this project: `bundle`/`unbundle`/`restore.sh` remain valid for same-store snapshot/rollback, but are not to be relied on for cross-machine transfer.",
