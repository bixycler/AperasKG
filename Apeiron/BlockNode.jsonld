      },
      {
        "@id": "BlockNode:00CJ3Z5DM0001:links:Link:00CN1KQR00000",
        "@type": "Link",
        "target": "BlockNode:00CJ2WQ1SR001",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CJ3Z5DM0001:links:Link:00CN1KQR00000:props:StringProp:00CN1KQR00001",
            "@type": "StringProp",
            "key": "position",
            "value": "1271"
