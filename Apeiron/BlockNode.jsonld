  },
  {
    "@id": "BlockNode/00C5FPAA1800K",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1800K",
    "children": [],
    "text": "Metaphysical foundation: Apeiron (macrocosm), Aperas (microcosm), and Peras (interface).",
    "title": "00C64YWX5800P",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800M",
