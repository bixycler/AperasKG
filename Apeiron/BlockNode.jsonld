    ],
    "title": "**Inspect the Code Diff**",
    "text": "**Inspect the Code Diff**:",
    "parent": "BlockNode:00CS1593N800P",
    "type": "listItem",
    "children": [
      "BlockNode:00CS1593N800R"
    ]
  },
  {
    "@id": "BlockNode:00CS1593N800R",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593N800R:props:StringProp:00CS159848000",
        "@type": "StringProp",
