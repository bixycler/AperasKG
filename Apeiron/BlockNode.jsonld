    "children": [
      "BlockNode/00C66H7NS005W",
      "BlockNode/00C66H7NS005X"
    ],
    "text": "Pitfalls of complete automation",
    "title": "00C6HQACJG011",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C66H7NS005W",
    "@type": "BlockNode",
    "blockId": "00C66H7NS005W",
    "children": [],
    "text": "Pitfalls of complete automation",
    "title": "00C6HQACJG012",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C66H7NS005X",
    "@type": "BlockNode",
    "blockId": "00C66H7NS005X",
    "children": [
      "BlockNode/00C66H7NS005Y",
      "BlockNode/00C66H7NS0060",
      "BlockNode/00C66H7NS0062",
      "BlockNode/00C66H7NS0064"
    ],
    "ordered": false,
