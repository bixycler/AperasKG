      },
      {
        "@id": "BlockNode/00C7BJZCV0015/props/StringProp/liTGx74rpz7zCkIs",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Immutable delta-layer architecture",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0016",
    "@type": "BlockNode",
    "title": "00C7BJZCV0016",
    "blockId": "00C7BJZCV0016",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0015",
    "text": "Operates on succinct, bit-packed immutable layers backed by Rust and Prolog, where every mutation appends a diff layer without overwriting past state.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0017",
    "@type": "BlockNode",
    "title": "00C7BJZCV0017",
    "blockId": "00C7BJZCV0017",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0015",
    "text": "Grants native Git-like time travel, branching, diffing, and merging, allowing agents and humans to draft speculative updates on proposal branches.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0018",
    "@type": "BlockNode",
    "title": "00C7BJZCV0018",
    "blockId": "00C7BJZCV0018",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0015",
    "text": "Provides strict revision auditability where every assertion and invalidation is intrinsically tied to a commit author, timestamp, and message.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV0019",
    "@type": "BlockNode",
    "title": "00C7BJZCV0019",
    "blockId": "00C7BJZCV0019",
    "children": [
      "BlockNode/00C7BJZCV001A",
