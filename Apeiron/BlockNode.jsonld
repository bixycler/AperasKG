      {
        "@id": "BlockNode:00CS1593MR00E:props:StringProp:00CS1597V8002",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593MR00E",
    "text": "Start at `design/<concern>.md` for settled architecture.",
    "parent": "BlockNode:00CS1593MR00D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00F",
    "@type": "BlockNode",
    "title": "00CS1593MR00F",
    "text": "Move through `issues/` and `history/` for open and landed items.",
    "parent": "BlockNode:00CS1593MR00D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00G",
    "@type": "BlockNode",
    "title": "00CS1593MR00G",
    "text": "Check `discussion/` for reasoning trails before looking at code.",
    "parent": "BlockNode:00CS1593MR00D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MR00H",
    "@type": "BlockNode",
    "title": "**Bottom-Up (Pinpoint, then zoom out)**",
    "text": "**Bottom-Up (Pinpoint, then zoom out)**:",
    "parent": "BlockNode:00CS1593MR00C",
    "type": "listItem",
    "children": [
      "BlockNode:00CS1593MR00J",
      "BlockNode:00CS1593MR00N",
      "BlockNode:00CS1593MR00P"
    ]
  },
  {
    "@id": "BlockNode:00CS1593MR00J",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593MR00J:props:StringProp:00CS1597V8003",
        "@type": "StringProp",
