    ],
    "parent": "BlockNode/00C7BJZCTR001",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCTR00C/props/StringProp/UJNNVUkyVj4w4vM0",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCTR00C/props/StringProp/p7uACdL8jdCXZ7JP",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Node, AST, and Storage Design in Aperas",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00D",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00D",
    "blockId": "00C7BJZCTR00D",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00C",
    "text": "On-demand reification and lazy atomization mechanics.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00E",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00E",
    "blockId": "00C7BJZCTR00E",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00C",
    "text": "Three parallel planes: Rendered plane, Stored plane, and Graph plane.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00F",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00F",
    "blockId": "00C7BJZCTR00F",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00C",
    "text": "Universal inline boundary: `<span>` tag addressability and offset tracking.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00G",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00G",
    "blockId": "00C7BJZCTR00G",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR00C",
    "text": "Unified.js AST mapping to TerminusDB storage substrate.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00H",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00H",
