    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G05E",
      "BlockNode:00CBFDZ41G05F"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G05E",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05E",
    "text": "SolidJS reactive tree views render projected subgraphs and inline `<span>` addressability.",
    "parent": "BlockNode:00CBFDZ41G05D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05F",
    "@type": "BlockNode",
