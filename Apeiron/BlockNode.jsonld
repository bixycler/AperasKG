      },
      {
        "@id": "BlockNode:00D0X8VQZR00N:props:StringProp:00D0X8W1RG005",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D0X8VQZR00N",
    "text": "No fix has been tried.",
    "parent": "BlockNode:00D0X8VQZR00M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D0X8VQZR00P",
