        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "For every tool batch, write a subturn recording",
    "text": "For every tool batch, write a subturn recording:",
    "parent": "BlockNode:00CS1593N801M",
