      {
        "@id": "BlockNode/00C7BJZCTR007/props/StringProp/EJoShjfPYV5RUqsA",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "System Architecture and Mechanics of Aperas",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR008",
    "@type": "BlockNode",
    "title": "00C7BJZCTR008",
    "blockId": "00C7BJZCTR008",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR007",
    "text": "Architectural philosophy: Fluid core vs. crystallized interfaces.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR009",
    "@type": "BlockNode",
    "title": "00C7BJZCTR009",
    "blockId": "00C7BJZCTR009",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR007",
    "text": "Multi-Agent Projection Pattern and dynamic read–write transducers.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00A",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00A",
    "blockId": "00C7BJZCTR00A",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR007",
    "text": "System taxonomy and component boundaries.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00B",
    "@type": "BlockNode",
    "title": "00C7BJZCTR00B",
    "blockId": "00C7BJZCTR00B",
    "children": [],
    "parent": "BlockNode/00C7BJZCTR007",
    "text": "Async execution model, command dispatch, and self-healing boundary validation.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCTR00C",
    "@type": "BlockNode",
