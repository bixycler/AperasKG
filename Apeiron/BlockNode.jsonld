  {
    "@id": "BlockNode/00C5FPAA2005R",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2005R",
    "children": [],
    "text": "The primary coding agent connects directly to the **TerminusDB** substrate without any intermediate UI layer.",
    "title": "00C64YWX6002A",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2005S",
