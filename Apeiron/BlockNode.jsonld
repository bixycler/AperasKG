    "title": "00D0X8XR9R00J",
    "text": "**Related**",
    "parent": "BlockNode:00D0W00YCR001",
    "type": "listItem",
    "children": [
      "BlockNode:00D0X8XR9R00K",
      "BlockNode:00D0X8XR9R00M"
    ]
  },
  {
    "@id": "BlockNode:00D0X8XR9R00K",
    "@type": "BlockNode",
