    ],
    "parent": "BlockNode/00C7BJZCV0013",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV0019/props/StringProp/TqeGIVuILPYkBuku",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV0019/props/StringProp/hG28TY89TFgRW7Qe",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Isomorphism with block-tree and hybrid projection models",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001A",
    "@type": "BlockNode",
    "title": "00C7BJZCV001A",
    "blockId": "00C7BJZCV001A",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0019",
    "text": "Models data as JSON-LD Document Classes, offering direct structural mapping to outliner block-trees (Logseq/Roam style) and nested subdocuments.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001B",
    "@type": "BlockNode",
    "title": "00C7BJZCV001B",
    "blockId": "00C7BJZCV001B",
    "children": [],
    "parent": "BlockNode/00C7BJZCV0019",
    "text": "Supports the multi-faceted node reference pattern, storing full Markdown text for human UI rendering alongside structured assertion fields and triple relationships.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001C",
    "@type": "BlockNode",
    "title": "00C7BJZCV001C",
    "blockId": "00C7BJZCV001C",
    "children": [
      "BlockNode/00C7BJZCV001D",
      "BlockNode/00C7BJZCV001E"
    ],
    "parent": "BlockNode/00C7BJZCV0013",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001C/props/StringProp/FD-ko-malKobp1cW",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      },
      {
        "@id": "BlockNode/00C7BJZCV001C/props/StringProp/Uu7fhtP_FyJtzADU",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      }
    ],
    "text": "Dual-query interface capabilities",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001D",
    "@type": "BlockNode",
    "title": "00C7BJZCV001D",
    "blockId": "00C7BJZCV001D",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001C",
    "text": "Employs WOQL (Web Object Query Language) powered by Datalog for pattern matching, recursive transitive dependency traversals, and impact propagation calculations.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001E",
    "@type": "BlockNode",
    "title": "00C7BJZCV001E",
    "blockId": "00C7BJZCV001E",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001C",
    "text": "Exposes automatically generated GraphQL endpoints for projection agents to perform fast, multi-hop contextual fetches during view rendering.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001F",
    "@type": "BlockNode",
    "title": "00C7BJZCV001F",
    "blockId": "00C7BJZCV001F",
    "children": [
      "BlockNode/00C7BJZCV001G"
    ],
    "parent": "BlockNode/00C7BJZCV0013",
    "props": [
      {
        "@id": "BlockNode/00C7BJZCV001F/props/StringProp/O4ax2JK1zEoP1MAn",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode/00C7BJZCV001F/props/StringProp/bUndlppMF21lDUTG",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "text": "Future substrate alternative under consideration",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001G",
    "@type": "BlockNode",
    "title": "00C7BJZCV001G",
    "blockId": "00C7BJZCV001G",
    "children": [],
    "parent": "BlockNode/00C7BJZCV001F",
    "text": "ApeironNgn — a minimal Rust graph engine scoped to exactly what Aperas exercises — is sketched as a speculative future replacement; see Development Roadmap \"Phase 4: Substrate Evolution\".",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV001H",
    "@type": "BlockNode",
    "title": "00C7BJZCV001H",
