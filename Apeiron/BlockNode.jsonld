      },
      {
        "@id": "BlockNode:00CS1593N800R:props:StringProp:00CS159848001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593N800R",
    "text": "Run `git diff` in the code repo to examine exact line changes.",
