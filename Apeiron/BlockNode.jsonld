  {
    "@id": "BlockNode:00D22ZK7C8005",
    "@type": "BlockNode",
    "title": "00D22ZK7C8005",
    "text": "**Root cause**",
    "parent": "BlockNode:00D22ZK7C8001",
    "type": "listItem",
    "children": [
      "BlockNode:00D22ZK7C8006",
      "BlockNode:00D22ZK7C8007",
      "BlockNode:00D22ZK7C8008"
