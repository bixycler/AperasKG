  {
    "@id": "BlockNode:00CBFDZ028001",
    "@type": "BlockNode",
    "title": "# Apeiron Node CRUD — Design",
    "parent": "ArtifactNode:00CBFDW94R000",
    "type": "heading",
    "children": [
      "BlockNode:00CBFDZ028002",
      "BlockNode:00CBFDZ028004",
      "BlockNode:00CBFDZ02800B",
      "BlockNode:00CBFDZ02800D",
      "BlockNode:00CBFDZ02800R",
      "BlockNode:00CBFDZ028013",
      "BlockNode:00CBFDZ02801F",
      "BlockNode:00CBFDZ02801N",
      "BlockNode:00CBFDZ028022",
      "BlockNode:00CBFDZ028027",
      "BlockNode:00CBFDZ028028",
      "BlockNode:00CBFDZ028029",
      "BlockNode:00CBFDZ02802E",
