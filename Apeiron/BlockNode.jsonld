  {
    "@id": "BlockNode/00C5FPAA20020",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20020",
    "children": [],
    "text": "Direct execution of `SKILL.md` procedures and local scripts without external service layers or extra API token costs.",
