  },
  {
    "@id": "BlockNode:00CS1593NG01X",
    "@type": "BlockNode",
    "title": "##### A. Survey Turn (First Turn of Every Task)",
    "parent": "BlockNode:00CS1593NG01W",
    "type": "heading",
    "children": [
      "BlockNode:00CS1593NG01Y",
      "BlockNode:00CS1593NG01Z",
      "BlockNode:00CS1593NG020",
      "BlockNode:00CS1593NG021",
      "BlockNode:00CS1593NG022"
    ]
  },
  {
    "@id": "BlockNode:00CS1593NG01Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593NG01Y:props:StringProp:00CS15987R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CS1593NG01Y:props:StringProp:00CS15987R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "Perform deep read for the task",
    "text": "Perform deep read for the task: enter top-down and bottom-up (base: *Entering the corpus*).",
    "parent": "BlockNode:00CS1593NG01X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG01Z",
    "@type": "BlockNode",
    "title": "00CS1593NG01Z",
    "text": "Climb every pinpointed node until it reaches `design/`.",
    "parent": "BlockNode:00CS1593NG01X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG020",
    "@type": "BlockNode",
    "title": "00CS1593NG020",
    "text": "Cite governing design blocks, open issues, planned items, and prior history in your Report.",
    "parent": "BlockNode:00CS1593NG01X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG021",
    "@type": "BlockNode",
    "title": "00CS1593NG021",
    "text": "Note any drift between design and code.",
    "parent": "BlockNode:00CS1593NG01X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG022",
    "@type": "BlockNode",
    "title": "**Scope**",
    "text": "**Scope**: Graph side only. Touch source code only to pinpoint entry points; mapping code execution is the Coder's survey.",
    "parent": "BlockNode:00CS1593NG01X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG023",
    "@type": "BlockNode",
    "title": "##### B. Filing Turn (After Each Coder Turn)",
    "parent": "BlockNode:00CS1593NG01W",
    "type": "heading",
    "children": [
      "BlockNode:00CS1593NG024",
      "BlockNode:00CS1593NG025",
      "BlockNode:00CS1593NG026",
      "BlockNode:00CS1593NG027",
      "BlockNode:00CS1593NG028"
    ]
  },
  {
    "@id": "BlockNode:00CS1593NG024",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CS1593NG024:props:StringProp:00CS159880000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CS1593NG024:props:StringProp:00CS159880001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593NG024",
    "text": "Read the Coder's latest Report in `.threads/coder.md`.",
    "parent": "BlockNode:00CS1593NG023",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG025",
    "@type": "BlockNode",
    "title": "00CS1593NG025",
    "text": "Record findings into the task's `discussion` Freeflow, then promote to `issues/`/`history/`/`design/` as earned.",
    "parent": "BlockNode:00CS1593NG023",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG026",
    "@type": "BlockNode",
    "title": "**Copy content up**",
    "text": "**Copy content up**: Never link down into a thread from the graph above it.",
    "parent": "BlockNode:00CS1593NG023",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG027",
    "@type": "BlockNode",
    "title": "00CS1593NG027",
    "text": "Record any discrepancies between code and design as new findings.",
    "parent": "BlockNode:00CS1593NG023",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NG028",
    "@type": "BlockNode",
    "title": "00CS1593NG028",
    "text": "File every tool gap reported by either role under the appropriate tool concern.",
    "parent": "BlockNode:00CS1593NG023",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593NR000",
    "@type": "BlockNode",
    "title": "##### C. Finishing Turn (Last Turn of a Task)",
    "parent": "BlockNode:00CS1593NG01W",
