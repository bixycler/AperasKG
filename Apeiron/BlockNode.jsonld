  },
  {
    "@id": "BlockNode/00C5FPAA20027",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20027",
    "children": [],
    "text": "Automatic hook mode (context engineering)",
    "title": "00C64YWX5R016",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20028",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20028",
    "children": [
      "BlockNode/00C5FPAA20029"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX5R017",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20029",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20029",
    "children": [
      "BlockNode/00C5FPAA2002A"
    ],
    "title": "00C64YWX5R018",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2002A",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2002A",
    "children": [],
    "text": "Event-driven injection where relevant perata projections are automatically synthesized and placed directly into the coding agent's prompt/context window.",
    "title": "00C64YWX5R019",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2002B",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2002B",
    "children": [
      "BlockNode/00C5FPAA2002C",
      "BlockNode/00C5FPAA2002D"
    ],
    "title": "00C64YWX5R01A",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2002C",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2002C",
    "children": [],
    "text": "Async Execution and Command Dispatch Mechanics",
    "title": "00C64YWX5R01B",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2002D",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2002D",
    "children": [
      "BlockNode/00C5FPAA2002E",
