            "@type": "StringProp",
            "key": "position",
            "value": "99"
          }
        ]
      }
    ],
    "title": "**The index is private**",
    "text": "**The index is private**: the shell sees plain strings, numbers and booleans and never a pair (see [The engine's interface](#id/BlockNode:00D24N87T0003)).",
    "parent": "BlockNode:00D24N87SR015",
    "type": "listItem",
    "children": []
