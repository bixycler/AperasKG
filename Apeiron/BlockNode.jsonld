  },
  {
    "@id": "BlockNode:00CS1593MR005",
    "@type": "BlockNode",
    "title": "**Upward (Surrounding Context)**",
    "text": "**Upward (Surrounding Context)**:",
    "parent": "BlockNode:00CS1593MR001",
