        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CS1593N002F",
    "text": "Check which step of the 9-step loop was last completed in the graph.",
    "parent": "BlockNode:00CS1593N002E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593N002G",
    "@type": "BlockNode",
    "title": "00CS1593N002G",
    "text": "**Never assume work hasn't started** just because a markdown file under `artifacts/` appears empty or unprojected. The graph in Apeiron is the source of truth.",
    "parent": "BlockNode:00CS1593N002E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CS1593N002H",
