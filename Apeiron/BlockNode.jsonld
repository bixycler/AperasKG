      }
    ],
    "title": "00D7710E58008",
    "text": "Whether the default mode of `runUpdate` with several blocks clears the heading's text as well.",
    "parent": "BlockNode:00D7710E58007",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D7710E58009",
    "@type": "BlockNode",
    "title": "00D7710E58009",
    "text": "Where the deep-path wikilink is lost in the ingest, and whether it is the parser or the resolution.",
    "parent": "BlockNode:00D7710E58007",
    "type": "listItem",
    "children": []
