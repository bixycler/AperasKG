        "@id": "BlockNode:00CBFDZ41G05C:props:StringProp:00CBFDZ4JR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G05C",
    "text": "Minimal prototype architecture",
    "parent": "BlockNode:00CBFDZ41G04T",
    "type": "listItem",
    "children": [
