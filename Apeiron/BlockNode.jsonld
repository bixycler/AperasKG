    "blockId": "00C5FPAA1800G",
    "children": [],
    "text": "Philosophy and Ontology of Aperas",
    "title": "00C64YWX5800K",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1800H",
    "@type": "BlockNode",
