      "BlockNode:00D0X8VQZR00N"
    ]
  },
  {
    "@id": "BlockNode:00D0X8VQZR00N",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D0X8VQZR00N:props:StringProp:00D0X8W1RG004",
