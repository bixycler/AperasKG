  },
  {
    "@id": "BlockNode:00CBFDZ41R02F",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02F",
    "text": "Reached high maturity in frameworks like Microsoft GraphRAG, Neo4j Agentic ADK, and HippoRAG.",
    "parent": "BlockNode:00CBFDZ41R02D",
    "type": "listItem",
    "children": []
  },
  {
