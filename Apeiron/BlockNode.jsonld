    "type": "listItem",
    "children": [
      "BlockNode:00D4SRT8KR008"
    ]
  },
  {
    "@id": "BlockNode:00D4SRT8KR008",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D4SRT8KR008:props:StringProp:00D4SRTQZR000",
