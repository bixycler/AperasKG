        "target": "BlockNode:00CVNX6A3R000",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00D1EZNJ30001:links:Link:00D1EZP0BR004:props:StringProp:00D1F1TBR8001",
            "@type": "StringProp",
            "key": "position",
