  {
    "@id": "BlockNode/00C5FPAA20035",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20035",
    "children": [],
    "text": "On-demand reification (lazy atomization)",
    "title": "00C64YWX5R024",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20036",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20036",
