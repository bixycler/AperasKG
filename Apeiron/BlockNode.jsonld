      },
      {
        "@id": "BlockNode:00CBFDZ418009:props:StringProp:00CBFDZ42G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ418009",
    "text": "Core Architecture Suite",
    "parent": "BlockNode:00CBFDZ418005",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800A",
      "BlockNode:00CBFDZ41800F",
      "BlockNode:00CBFDZ41800M"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800A",
