      "BlockNode/00C64YWX60057"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C6HQACJ005K",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C64YWX6004J",
    "@type": "BlockNode",
