            "@id": "BlockNode:00CVPG6108001:links:Link:00CVQ71BJ0000:props:StringProp:00CVQ71BJ0001",
            "@type": "StringProp",
            "key": "position",
            "value": "455"
          }
        ]
      }
    ],
    "props": [
