  {
    "@id": "BlockNode:00D1EZNJ30001",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00D1EZNJ30001:links:Link:00D1EZP0BR000",
        "@type": "Link",
        "target": "BlockNode:00D1D5F63R001",
        "predicate": "[[wikilink]]",
