        "target": "BlockNode:00D24N87SR01Y",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00D24N87SR018:links:Link:00D5B402R8000:props:StringProp:00D5B402R8001",
