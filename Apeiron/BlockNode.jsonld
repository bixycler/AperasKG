  {
    "@id": "BlockNode/00C5FPAA18010",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18010",
    "children": [],
    "text": "Multi-Agent Projection Pattern and dynamic read–write transducers.",
    "title": "00C64YWX58013",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA18011",
    "@type": "BlockNode",
    "blockId": "00C5FPAA18011",
    "children": [
      "BlockNode/00C5FPAA18012"
    ],
