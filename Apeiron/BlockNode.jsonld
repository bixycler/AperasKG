  },
  {
    "@id": "BlockNode:00D0X1SZ3R002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D0X1SZ3R002:props:StringProp:00D0X1T83R002",
        "@type": "StringProp",
        "key": "orderedList",
