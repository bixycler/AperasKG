  },
  {
    "@id": "BlockNode/00C5FPAA20022",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20022",
    "children": [],
    "text": "Active tool mode (on-demand query)",
    "title": "00C64YWX5R011",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20023",
    "@type": "BlockNode",
