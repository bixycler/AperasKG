    ],
    "props": [
      {
        "@id": "BlockNode:00CG9MPGVG001:props:StringProp:00CG9MPJPG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CG9MPGVG001:props:StringProp:00CG9MPJPG001",
        "@type": "StringProp",
