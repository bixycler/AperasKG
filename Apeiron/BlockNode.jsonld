        "target": "BlockNode:00CGFE4SV0002",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CGF83D4G001:links:Link:00CGFED88G000:props:StringProp:00CGFED88G001",
            "@type": "StringProp",
            "key": "position",
