      {
        "@id": "BlockNode:00CR3XZ220001:links:Link:00CR3XZ4Z0002",
        "@type": "Link",
        "target": "BlockNode:00CR3XQKNG001",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CR3XZ220001:links:Link:00CR3XZ4Z0002:props:StringProp:00CR3Y7TZ8000",
