      "BlockNode:00CVQ1FTCR001"
    ]
  },
  {
    "@id": "BlockNode:00CVPQFW6G001",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CVPQFW6G001:props:StringProp:00CVPQG3T8000",
