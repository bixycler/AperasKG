      {
        "@id": "BlockNode:00CGA4ZN8800P:links:Link:00CGRVAYSR002",
        "@type": "Link",
        "target": "BlockNode:00CF46W4QR00A",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CGA4ZN8800P:links:Link:00CGRVAYSR002:props:StringProp:00CGRVAYSR003",
            "@type": "StringProp",
