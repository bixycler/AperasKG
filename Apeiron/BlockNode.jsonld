    "blockId": "00C5FPA5PG00S",
    "children": [],
    "text": "**Scope**: **Cross-Machine Host Transfer**.",
    "title": "00C5FPA5PG00S",
    "tombstonedAt": "2026-08-30T02:02:19.881Z",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPA5PG00T",
