        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00D7T3XZA800B:links:Link:00D7T3YJRR004:props:StringProp:00D7T3YJRR005",
            "@type": "StringProp",
            "key": "position",
            "value": "534"
          }
        ]
