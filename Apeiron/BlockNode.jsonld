    "children": []
  },
  {
    "@id": "BlockNode:00D40RVX6G000",
    "@type": "BlockNode",
    "title": "**Roots**",
    "text": "**Roots**: running `tsx` from the clone's directory is enough; `aperas.config.json` is portable, so the symlink is not worth more work.",
    "parent": "BlockNode:00D40RVX48000",
