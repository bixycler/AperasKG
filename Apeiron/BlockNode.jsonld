  },
  {
    "@id": "BlockNode/00C7BJZCV000S",
    "@type": "BlockNode",
    "title": "00C7BJZCV000S",
    "blockId": "00C7BJZCV000S",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000R",
    "text": "SolidJS reactive tree views render projected subgraphs and inline `<span>` addressability.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000T",
    "@type": "BlockNode",
    "title": "00C7BJZCV000T",
    "blockId": "00C7BJZCV000T",
    "children": [],
    "parent": "BlockNode/00C7BJZCV000R",
    "text": "Unified.js converts raw Markdown into structural AST nodes for extraction and offset tracking.",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C7BJZCV000V",
    "@type": "BlockNode",
