        "@type": "StringProp",
        "key": "checked",
        "value": "false"
      }
    ],
    "title": "**2. Embedded nodes**",
    "text": "**2. Embedded nodes**: an embedded node is removed outright and never tombstoned (see Batch 5).",
    "parent": "BlockNode:00D3XQQ2VR014",
    "type": "listItem",
    "children": []
