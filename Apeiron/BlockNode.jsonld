  },
  {
    "@id": "BlockNode/00C5FPAA1802R",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802R",
    "children": [],
    "text": "Historical precedent in collaborative knowledge work",
    "title": "00C64YWX5G01E",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802S",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802S",
    "children": [
      "BlockNode/00C5FPAA1802T",
      "BlockNode/00C5FPAA1802W"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX5G01F",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802T",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802T",
    "children": [
      "BlockNode/00C5FPAA1802V"
    ],
    "title": "00C64YWX5G01G",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802V",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802V",
    "children": [],
    "text": "Systems like Wikipedia demonstrate that knowledge nodes are multi-perspective entities rather than flat text blobs.",
    "title": "00C64YWX5G01H",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802W",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802W",
    "children": [
      "BlockNode/00C5FPAA1802X"
    ],
    "title": "00C64YWX5G01J",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802X",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802X",
    "children": [],
    "text": "Aperas adopts this multi-tab structure as an illustrative reference model for node projections.",
    "title": "00C64YWX5G01K",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1802Y",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1802Y",
    "children": [
      "BlockNode/00C5FPAA1802Z",
