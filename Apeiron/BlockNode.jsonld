      }
    ],
    "title": "00D22ZV0FG003",
    "text": "`cli/src/apeironNgnSmokeTest.ts` (lines 99 to 106) calls `backlinks(store, artifact['@id'], '__parent')` and compares the result with `artifact.children`. `__parent` was renamed `parent`, so the call asks for a predicate that no node carries.",
    "parent": "BlockNode:00D22ZV0FG002",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D22ZV0FR000",
    "@type": "BlockNode",
    "title": "Nothing runs the file",
    "text": "Nothing runs the file: no script, suite or import names it (checked by `grep` over `monorepo/packages`; only the compiler's `tsconfig.tsbuildinfo` lists it). Whether it passes or fails today was not run.",
    "parent": "BlockNode:00D22ZV0FG002",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D22ZV0FR001",
    "@type": "BlockNode",
    "title": "00D22ZV0FR001",
    "text": "**Root cause**",
    "parent": "BlockNode:00D22ZV0FG001",
    "type": "listItem",
    "children": [
      "BlockNode:00D22ZV0FR002"
    ]
  },
  {
    "@id": "BlockNode:00D22ZV0FR002",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00D22ZV0FR002:links:Link:00D22ZVBTR000",
        "@type": "Link",
        "target": "BlockNode:00CVQHD7CR001",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00D22ZV0FR002:links:Link:00D22ZVBTR000:props:StringProp:00D22ZVBTR001",
            "@type": "StringProp",
            "key": "position",
            "value": "111"
          }
        ]
      }
    ],
    "props": [
      {
        "@id": "BlockNode:00D22ZV0FR002:props:StringProp:00D22ZVBTG000",
        "@type": "StringProp",
        "key": "orderedList",
