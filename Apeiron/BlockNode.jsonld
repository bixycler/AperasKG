      }
    ],
    "title": "00CBFDZ41800F",
    "text": "System Architecture and Mechanics of Aperas",
    "parent": "BlockNode:00CBFDZ418009",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800G",
      "BlockNode:00CBFDZ41800H",
      "BlockNode:00CBFDZ41800J",
      "BlockNode:00CBFDZ41800K"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800G",
    "@type": "BlockNode",
    "title": "00CBFDZ41800G",
    "text": "Architectural philosophy: Fluid core vs. crystallized interfaces.",
    "parent": "BlockNode:00CBFDZ41800F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800H",
    "@type": "BlockNode",
    "title": "00CBFDZ41800H",
    "text": "Multi-Agent Projection Pattern and dynamic read–write transducers.",
    "parent": "BlockNode:00CBFDZ41800F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800J",
    "@type": "BlockNode",
    "title": "00CBFDZ41800J",
    "text": "System taxonomy and component boundaries.",
    "parent": "BlockNode:00CBFDZ41800F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800K",
    "@type": "BlockNode",
    "title": "00CBFDZ41800K",
    "text": "Async execution model, command dispatch, and self-healing boundary validation.",
    "parent": "BlockNode:00CBFDZ41800F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800M:props:StringProp:00CBFDZ438000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41800M:props:StringProp:00CBFDZ438001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41800M",
    "text": "Node, AST, and Storage Design in Aperas",
    "parent": "BlockNode:00CBFDZ418009",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800N",
      "BlockNode:00CBFDZ41800P",
      "BlockNode:00CBFDZ41800Q",
      "BlockNode:00CBFDZ41800R"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800N",
    "@type": "BlockNode",
    "title": "00CBFDZ41800N",
    "text": "On-demand reification and lazy atomization mechanics.",
    "parent": "BlockNode:00CBFDZ41800M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800P",
    "@type": "BlockNode",
    "title": "00CBFDZ41800P",
    "text": "Three parallel planes: Rendered plane, Stored plane, and Graph plane.",
    "parent": "BlockNode:00CBFDZ41800M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41800Q",
    "text": "Universal inline boundary: `<span>` tag addressability and offset tracking.",
    "parent": "BlockNode:00CBFDZ41800M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800R",
    "@type": "BlockNode",
    "title": "00CBFDZ41800R",
    "text": "Unified.js AST mapping to TerminusDB storage substrate.",
    "parent": "BlockNode:00CBFDZ41800M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800S",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800S:props:StringProp:00CBFDZ43R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41800S:props:StringProp:00CBFDZ43R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41800S",
    "text": "Philosophy and Ontology of Aperas",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800T",
      "BlockNode:00CBFDZ41G00B",
      "BlockNode:00CBFDZ41G00M"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800T:props:StringProp:00CBFDZ43R002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41800T:props:StringProp:00CBFDZ43R003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41800T",
    "text": "Metaphysics of Form and Freedom (Unbounded – Unbound – Bound)",
    "parent": "BlockNode:00CBFDZ41800S",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800V",
      "BlockNode:00CBFDZ41800Y",
      "BlockNode:00CBFDZ41G008"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800V",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800V:props:StringProp:00CBFDZ440000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41800V:props:StringProp:00CBFDZ440001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41800V",
    "text": "Apeiron – Unbounded (Macrocosm – Objective Infinite)",
    "parent": "BlockNode:00CBFDZ41800T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800W",
      "BlockNode:00CBFDZ41800X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800W",
    "@type": "BlockNode",
    "title": "00CBFDZ41800W",
    "text": "The outer universe existing in a state of infinite, unmanifested potential.",
    "parent": "BlockNode:00CBFDZ41800V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800X",
    "@type": "BlockNode",
    "title": "00CBFDZ41800X",
    "text": "Represents the unconditioned, boundless origin – an inexhaustible, schema-free field holding all possibilities without being trapped by any single form.",
    "parent": "BlockNode:00CBFDZ41800V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800Y:props:StringProp:00CBFDZ440002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41800Y:props:StringProp:00CBFDZ440003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41800Y",
    "text": "Aperas – Unbound (Microcosm – Subjective Liberation)",
    "parent": "BlockNode:00CBFDZ41800T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G000",
      "BlockNode:00CBFDZ41G001",
      "BlockNode:00CBFDZ41G007"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G000",
    "@type": "BlockNode",
    "title": "00CBFDZ41G000",
    "text": "The inner human spirit achieving freedom through the liberation of the soul.",
    "parent": "BlockNode:00CBFDZ41800Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G001",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G001:props:StringProp:00CBFDZ448000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G001:props:StringProp:00CBFDZ448001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G001",
    "text": "Etymologically layered:",
    "parent": "BlockNode:00CBFDZ41800Y",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G002",
      "BlockNode:00CBFDZ41G003",
      "BlockNode:00CBFDZ41G004",
      "BlockNode:00CBFDZ41G005",
      "BlockNode:00CBFDZ41G006"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G002",
    "@type": "BlockNode",
    "title": "00CBFDZ41G002",
    "text": "*A-* (without) + *Peras* (limit) = **Unbound**: Not merely “unlimited” in size, but intrinsically free from rigid constraints.",
    "parent": "BlockNode:00CBFDZ41G001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G003",
    "@type": "BlockNode",
    "title": "00CBFDZ41G003",
    "text": "*Aperas* in Esperanto = “Appears / Emerges”: The active manifestation where structured forms materialize out of the fluid core on demand.",
    "parent": "BlockNode:00CBFDZ41G001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G004",
    "@type": "BlockNode",
    "title": "00CBFDZ41G004",
    "text": "*Aperas* (Spanish verb meaning “equip, harness”): The functional act of provisioning an agent with the vital instruments, tools, and memory required to navigate and execute operations.",
    "parent": "BlockNode:00CBFDZ41G001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G005",
    "@type": "BlockNode",
    "title": "00CBFDZ41G005",
    "text": "*Apera* (Botanical Genus / [Windgrass](https://en.wikipedia.org/wiki/Apera)): The organic paradigm of fluid resilience, the ability to keep wholeness (*a-pēros*) by gracefully bending and naturalizing across any environment without breaking.",
    "parent": "BlockNode:00CBFDZ41G001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G006",
    "@type": "BlockNode",
    "title": "00CBFDZ41G006",
    "text": "*Aperis* (Latin verb meaning “open, uncover”): The open-source act of laying knowledge bare, mirroring its legal fluidity under [The Unlicense](https://unlicense.org/) by refusing rigid cages or ownership.",
    "parent": "BlockNode:00CBFDZ41G001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G007",
    "@type": "BlockNode",
    "title": "00CBFDZ41G007",
    "text": "While daily interaction imposes limits and fixed roles, the liberated soul breaks through the illusion of rigid division, realizing its inner ground is identical in essence to the boundless Apeiron.",
    "parent": "BlockNode:00CBFDZ41800Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G008",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G008:props:StringProp:00CBFDZ44R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G008:props:StringProp:00CBFDZ44R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G008",
    "text": "Peras – Bound (The Interface – Transient Boundary)",
    "parent": "BlockNode:00CBFDZ41800T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G009",
      "BlockNode:00CBFDZ41G00A"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G009",
    "@type": "BlockNode",
    "title": "00CBFDZ41G009",
    "text": "The limit, boundary, or transient interface where interaction occurs.",
    "parent": "BlockNode:00CBFDZ41G008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00A",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00A",
    "text": "Form is not a rigid cage, but a temporary, playful instrument. Content remains formless (Apeiron), while the interface solidifies temporarily into defined structures (Peras) to accelerate interaction, then dissolves effortlessly back into the origin.",
    "parent": "BlockNode:00CBFDZ41G008",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00B",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00B:props:StringProp:00CBFDZ450000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00B:props:StringProp:00CBFDZ450001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00B",
    "text": "Multi-Faceted Node Epistemology (The Wikipedia Reference Model)",
    "parent": "BlockNode:00CBFDZ41800S",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00C",
      "BlockNode:00CBFDZ41G00F"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00C:props:StringProp:00CBFDZ450002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00C:props:StringProp:00CBFDZ450003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00C",
    "text": "Historical precedent in collaborative knowledge work",
    "parent": "BlockNode:00CBFDZ41G00B",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00D",
      "BlockNode:00CBFDZ41G00E"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00D",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00D",
    "text": "Systems like Wikipedia demonstrate that knowledge nodes are multi-perspective entities rather than flat text blobs.",
    "parent": "BlockNode:00CBFDZ41G00C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00E",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00E",
    "text": "Aperas adopts this multi-tab structure as an illustrative reference model for node projections.",
    "parent": "BlockNode:00CBFDZ41G00C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00F",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00F:props:StringProp:00CBFDZ458000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00F:props:StringProp:00CBFDZ458001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00F",
    "text": "Projection faces of a node",
    "parent": "BlockNode:00CBFDZ41G00B",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00G",
      "BlockNode:00CBFDZ41G00H",
      "BlockNode:00CBFDZ41G00J",
      "BlockNode:00CBFDZ41G00K"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00G",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00G",
    "text": "Surface view (Article – Peras projection): Markdown and HTML outliner blocks rendered for human reading and fast LLM context window ingestion.",
    "parent": "BlockNode:00CBFDZ41G00F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00H",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00H",
    "text": "Graph view (Source – Canonical triples): Semantic graph triples, explicit parent-child hierarchies, typed predicates (`impacts`, `verifies`, `derived_from`), and IRI references.",
    "parent": "BlockNode:00CBFDZ41G00F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00J",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00J",
    "text": "Discourse view (Talk – Agent trails): Agent trails, deliberations, conflicting perspectives, and reasoning traces behind decision states.",
    "parent": "BlockNode:00CBFDZ41G00F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00K",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00K",
    "text": "Provenance view (History – Audit deltas): Immutable commit logs, author signatures (human or agent ID), and atomic revision deltas.",
    "parent": "BlockNode:00CBFDZ41G00F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00M:props:StringProp:00CBFDZ45R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00M:props:StringProp:00CBFDZ45R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00M",
    "text": "Meta-Aperas / Self-Aperas (Recursive Methodology)",
    "parent": "BlockNode:00CBFDZ41800S",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00N",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00N:props:StringProp:00CBFDZ45R002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00N:props:StringProp:00CBFDZ45R003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00N",
    "text": "System evolution as ontological practice",
    "parent": "BlockNode:00CBFDZ41G00M",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00P",
      "BlockNode:00CBFDZ41G00Q",
      "BlockNode:00CBFDZ41G00R",
      "BlockNode:00CBFDZ41G00S"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00P",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00P",
    "text": "The engineering roadmap of Aperas is itself a self-instantiation of its underlying philosophy.",
    "parent": "BlockNode:00CBFDZ41G00N",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00Q",
    "text": "Phase 0 begins in the uncarved, schema-free substrate (Apeiron), avoiding premature interfaces or heavy abstractions.",
    "parent": "BlockNode:00CBFDZ41G00N",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00R",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00R",
    "text": "Projections, skills, and tools (Perata) crystallize organically on demand only as concrete human–agent coordination points emerge.",
    "parent": "BlockNode:00CBFDZ41G00N",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00S",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00S",
    "text": "The platform builds itself using the exact principles it uses to manage knowledge: fluid at rest, bound and structured when touched.",
    "parent": "BlockNode:00CBFDZ41G00N",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00T:props:StringProp:00CBFDZ468000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00T:props:StringProp:00CBFDZ468001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00T",
    "text": "System Architecture and Mechanics of Aperas",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00V",
      "BlockNode:00CBFDZ41G015",
      "BlockNode:00CBFDZ41G01E",
      "BlockNode:00CBFDZ41G01K",
      "BlockNode:00CBFDZ41G01T"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00V",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00V:props:StringProp:00CBFDZ468002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00V:props:StringProp:00CBFDZ468003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00V",
    "text": "Architectural Philosophy: Fluid Core vs. Crystallized Interfaces",
    "parent": "BlockNode:00CBFDZ41G00T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00W",
      "BlockNode:00CBFDZ41G00Z",
      "BlockNode:00CBFDZ41G012"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00W",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00W:props:StringProp:00CBFDZ468004",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00W:props:StringProp:00CBFDZ468005",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00W",
    "text": "Fluid core substrate (Apeiron – formless content)",
    "parent": "BlockNode:00CBFDZ41G00V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G00X",
      "BlockNode:00CBFDZ41G00Y"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G00X",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00X",
    "text": "The canonical state substrate remains a continuous, unconditioned semantic field – a rich graph of associations, atomic assertions, decisions, and raw evidence without rigid schema impedance.",
    "parent": "BlockNode:00CBFDZ41G00W",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00Y",
    "@type": "BlockNode",
    "title": "00CBFDZ41G00Y",
    "text": "Avoids premature schema-on-write constraints that destroy nuance or cause friction during exploratory thought and multi-agent reasoning.",
    "parent": "BlockNode:00CBFDZ41G00W",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G00Z",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G00Z:props:StringProp:00CBFDZ46G000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G00Z:props:StringProp:00CBFDZ46G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G00Z",
    "text": "Schema-as-projection (Peras – crystallized interfaces)",
    "parent": "BlockNode:00CBFDZ41G00V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G010",
      "BlockNode:00CBFDZ41G011"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G010",
    "@type": "BlockNode",
    "title": "00CBFDZ41G010",
    "text": "Schemas, types, enums, and unique identifiers are not intrinsic properties of the data substrate; they are temporary, disposable crystallizations generated on demand.",
    "parent": "BlockNode:00CBFDZ41G00Z",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G011",
    "@type": "BlockNode",
    "title": "00CBFDZ41G011",
    "text": "Interfaces represent agreed-upon, lossy compressions between two parties (agents, APIs, UI engines) designed to minimize interaction friction and maximize transaction speed.",
    "parent": "BlockNode:00CBFDZ41G00Z",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G012",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G012:props:StringProp:00CBFDZ46R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G012:props:StringProp:00CBFDZ46R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G012",
    "text": "Perimeter boundary transducers",
    "parent": "BlockNode:00CBFDZ41G00V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G013",
      "BlockNode:00CBFDZ41G014"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G013",
    "@type": "BlockNode",
    "title": "00CBFDZ41G013",
    "text": "Type systems (e.g., Pydantic in Python, Zod/TypeBox in TypeScript) live strictly at the system perimeter (boundary transducers) rather than polluting the core graph engine.",
    "parent": "BlockNode:00CBFDZ41G012",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G014",
    "@type": "BlockNode",
    "title": "00CBFDZ41G014",
    "text": "Boundary agents sample the fluid core (Apeiron) and project it into rigid, type-safe structures (Peras) strictly when interacting with deterministic runtimes (databases, AST compilers, UI outliners, or structured LLM tool endpoints).",
    "parent": "BlockNode:00CBFDZ41G012",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G015",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G015:props:StringProp:00CBFDZ470000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G015:props:StringProp:00CBFDZ470001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G015",
    "text": "Multi-Agent Projection Pattern",
    "parent": "BlockNode:00CBFDZ41G00T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G016",
      "BlockNode:00CBFDZ41G018",
      "BlockNode:00CBFDZ41G01B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G016",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G016:props:StringProp:00CBFDZ470002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G016:props:StringProp:00CBFDZ470003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G016",
    "text": "Pattern definition",
    "parent": "BlockNode:00CBFDZ41G015",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G017"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G017",
    "@type": "BlockNode",
    "title": "00CBFDZ41G017",
    "text": "An architectural paradigm where a high-dimensional, fluid state graph (Apeiron) acts as the single source of truth, while specialized agents act as bidirectional transducers (lenses) mediating human and machine interactions.",
    "parent": "BlockNode:00CBFDZ41G016",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G018",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G018:props:StringProp:00CBFDZ478000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G018:props:StringProp:00CBFDZ478001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G018",
    "text": "Read-side projection lenses (deep read)",
    "parent": "BlockNode:00CBFDZ41G015",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G019",
      "BlockNode:00CBFDZ41G01A"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G019",
    "@type": "BlockNode",
    "title": "00CBFDZ41G019",
    "text": "Specialized projection agents extract subgraphs and crystallize them into low-dimensional, context-specific interfaces (Peras) like Markdown outliners, source code ASTs, or sequence diagrams.",
    "parent": "BlockNode:00CBFDZ41G018",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01A",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01A",
    "text": "Enables deep read capabilities where every rendered element retains provenance anchors and backlinks, allowing readers to drill down into the supporting evidence subgraph.",
    "parent": "BlockNode:00CBFDZ41G018",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01B",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01B:props:StringProp:00CBFDZ47G000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01B:props:StringProp:00CBFDZ47G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01B",
    "text": "Write-side control and delta ingestion (deep write)",
    "parent": "BlockNode:00CBFDZ41G015",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01C",
      "BlockNode:00CBFDZ41G01D"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01C",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01C",
    "text": "Intake and impact agents parse view-level edits, calculate semantic diffs, and commit reified assertion nodes or validity updates back to the substrate.",
    "parent": "BlockNode:00CBFDZ41G01B",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01D",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01D",
    "text": "Enables deep write capabilities where edits trigger impact traversals along `affects` or `constrains` edges, calculating downstream ripple effects and queuing advisory invalidations.",
    "parent": "BlockNode:00CBFDZ41G01B",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01E",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01E:props:StringProp:00CBFDZ47R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01E:props:StringProp:00CBFDZ47R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01E",
    "text": "System Taxonomy and Vocabulary",
    "parent": "BlockNode:00CBFDZ41G00T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01F",
      "BlockNode:00CBFDZ41G01G",
      "BlockNode:00CBFDZ41G01H",
      "BlockNode:00CBFDZ41G01J"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01F",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01F",
    "text": "System / Platform: **Aperas** – The unbound environment where structure emerges (“appears”).",
    "parent": "BlockNode:00CBFDZ41G01E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01G",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01G",
    "text": "Fluid Core Substrate: **Apeiron** – The unconditioned, schema-free continuum where thoughts and semantic links flow without artificial boundaries.",
    "parent": "BlockNode:00CBFDZ41G01E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01H",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01H",
    "text": "Boundary Projections / Interfaces: **Peras** – The transient, typed structures (JSON Schema, Zod/Pydantic models, AST trees, DB mutations).",
    "parent": "BlockNode:00CBFDZ41G01E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01J",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01J",
    "text": "Transduction Process: **Aperas** (*to appear / materialize*) – The active emergence of structured Peras out of the unconditioned Apeiron.",
    "parent": "BlockNode:00CBFDZ41G01E",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01K",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01K:props:StringProp:00CBFDZ480000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01K:props:StringProp:00CBFDZ480001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01K",
    "text": "Coding Agent Interface Continuum",
    "parent": "BlockNode:00CBFDZ41G00T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01M",
      "BlockNode:00CBFDZ41G01P",
      "BlockNode:00CBFDZ41G01R"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01M:props:StringProp:00CBFDZ488000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01M:props:StringProp:00CBFDZ488001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01M",
    "text": "Manual skill mode (procedural recipes)",
    "parent": "BlockNode:00CBFDZ41G01K",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01N",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01N",
    "text": "Direct execution of `SKILL.md` procedures and local scripts without external service layers or extra API token costs.",
    "parent": "BlockNode:00CBFDZ41G01M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01P",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01P:props:StringProp:00CBFDZ488002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01P:props:StringProp:00CBFDZ488003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01P",
    "text": "Active tool mode (on-demand query)",
    "parent": "BlockNode:00CBFDZ41G01K",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01Q"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01Q",
    "text": "Explicit tool calling (via service APIs) where the coding agent queries or mutates perata through high-level skills at an abstract level.",
    "parent": "BlockNode:00CBFDZ41G01P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01R",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01R:props:StringProp:00CBFDZ48G000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01R:props:StringProp:00CBFDZ48G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01R",
    "text": "Automatic hook mode (context engineering)",
    "parent": "BlockNode:00CBFDZ41G01K",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01S"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01S",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01S",
    "text": "Event-driven injection where relevant perata projections are automatically synthesized and placed directly into the coding agent's prompt/context window.",
    "parent": "BlockNode:00CBFDZ41G01R",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01T:props:StringProp:00CBFDZ48R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01T:props:StringProp:00CBFDZ48R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01T",
    "text": "Async Execution and Command Dispatch Mechanics",
    "parent": "BlockNode:00CBFDZ41G00T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01V",
      "BlockNode:00CBFDZ41G01Y",
      "BlockNode:00CBFDZ41G021"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01V",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01V:props:StringProp:00CBFDZ48R002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01V:props:StringProp:00CBFDZ48R003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01V",
    "text": "Unconstrained reasoning to batch command emission",
    "parent": "BlockNode:00CBFDZ41G01T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01W",
      "BlockNode:00CBFDZ41G01X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01W",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01W",
    "text": "Reasoner agents operate with free-flow, unconstrained thinking to analyze context and draft mutations without suffering from structured output reasoning constraints.",
    "parent": "BlockNode:00CBFDZ41G01V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01X",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01X",
    "text": "At turn termination, the agent emits a single batch tool call or tagged payload containing array-based command intents (e.g., `list[CommandIntent]`).",
    "parent": "BlockNode:00CBFDZ41G01V",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G01Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G01Y:props:StringProp:00CBFDZ490000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G01Y:props:StringProp:00CBFDZ490001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G01Y",
    "text": "Event-driven async fan-out",
    "parent": "BlockNode:00CBFDZ41G01T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G01Z",
      "BlockNode:00CBFDZ41G020"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G01Z",
    "@type": "BlockNode",
    "title": "00CBFDZ41G01Z",
    "text": "Emitted command batches are pushed to an event-driven dispatcher and executed concurrently across worker coroutines and service endpoints.",
    "parent": "BlockNode:00CBFDZ41G01Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G020",
    "@type": "BlockNode",
    "title": "00CBFDZ41G020",
    "text": "Agents remain non-blocking and decoupled from slow, synchronous tool-calling loops.",
    "parent": "BlockNode:00CBFDZ41G01Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G021",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G021:props:StringProp:00CBFDZ498000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G021:props:StringProp:00CBFDZ498001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G021",
    "text": "Self-healing boundary validation",
    "parent": "BlockNode:00CBFDZ41G01T",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G022"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G022",
    "@type": "BlockNode",
    "title": "00CBFDZ41G022",
    "text": "If a command payload violates boundary schema rules (Peras), type validation tracebacks are fed back to the boundary agent for immediate, localized repair without polluting the fluid core (Apeiron).",
    "parent": "BlockNode:00CBFDZ41G021",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G023",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G023:props:StringProp:00CBFDZ49G000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G023:props:StringProp:00CBFDZ49G001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G023",
    "text": "Node, AST, and Storage Design in Aperas",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G024",
      "BlockNode:00CBFDZ41G029",
      "BlockNode:00CBFDZ41G02H",
      "BlockNode:00CBFDZ41G02R"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G024",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G024:props:StringProp:00CBFDZ49G002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G024:props:StringProp:00CBFDZ49G003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G024",
    "text": "On-demand reification (lazy atomization)",
    "parent": "BlockNode:00CBFDZ41G023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G025"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G025",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G025:props:StringProp:00CBFDZ49G004",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G025:props:StringProp:00CBFDZ49G005",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G025",
    "text": "Coarse by default, fine when touched",
    "parent": "BlockNode:00CBFDZ41G024",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G026",
      "BlockNode:00CBFDZ41G027",
      "BlockNode:00CBFDZ41G028"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G026",
    "@type": "BlockNode",
    "title": "00CBFDZ41G026",
    "text": "Content is preserved at coarse granularity (full paragraph, list item, or document block) without forcing upfront micro-fragmentation into tokens or words.",
    "parent": "BlockNode:00CBFDZ41G025",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G027",
    "@type": "BlockNode",
    "title": "00CBFDZ41G027",
    "text": "The moment a sub-clause, phrase, word, or punctuation mark is addressed, linked, commented on in the Talk view, or bound to a predicate, that specific slice crystallizes into an addressed node with its own identity (URI or UUID).",
    "parent": "BlockNode:00CBFDZ41G025",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G028",
    "@type": "BlockNode",
    "title": "00CBFDZ41G028",
    "text": "Untouched surrounding text remains unfragmented text chunks.",
    "parent": "BlockNode:00CBFDZ41G025",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G029",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G029:props:StringProp:00CBFDZ49R000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G029:props:StringProp:00CBFDZ49R001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G029",
    "text": "Three parallel planes of architecture",
    "parent": "BlockNode:00CBFDZ41G023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02A",
      "BlockNode:00CBFDZ41G02C",
      "BlockNode:00CBFDZ41G02F"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02A",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02A:props:StringProp:00CBFDZ4A0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02A:props:StringProp:00CBFDZ4A0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02A",
    "text": "Rendered plane (Artifact / Surface Peras)",
    "parent": "BlockNode:00CBFDZ41G029",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02B",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02B",
    "text": "The continuous, readable Markdown or HTML text flow where prose reads naturally without visual disruption.",
    "parent": "BlockNode:00CBFDZ41G02A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02C:props:StringProp:00CBFDZ4A0002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02C:props:StringProp:00CBFDZ4A0003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02C",
    "text": "Stored plane (Substrate Apeiron)",
    "parent": "BlockNode:00CBFDZ41G029",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02D",
      "BlockNode:00CBFDZ41G02E"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02D",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02D",
    "text": "The backing store in TerminusDB preserving content as coarse or fine AST nodes and character offset ranges.",
    "parent": "BlockNode:00CBFDZ41G02C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02E",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02E",
    "text": "Mirrored bidirectionally as plain JSON-LD files under `AperasKG/Apeiron/` (`Aperas-architecture.md` §5) — a portable, engine-agnostic round-trip of the same content, independent of TerminusDB's own storage internals.",
    "parent": "BlockNode:00CBFDZ41G02C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02F",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02F:props:StringProp:00CBFDZ4A8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02F:props:StringProp:00CBFDZ4A8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02F",
    "text": "Graph plane (Relational Peras)",
    "parent": "BlockNode:00CBFDZ41G029",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02G"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02G",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02G",
    "text": "The explicit network of nodes and edges connecting addressed entities (documents, blocks, clauses, words, punctuation) to the rest of the knowledge graph.",
    "parent": "BlockNode:00CBFDZ41G02F",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02H",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02H:props:StringProp:00CBFDZ4AG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02H:props:StringProp:00CBFDZ4AG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02H",
    "text": "Universal inline addressability (`<span>` tag pattern)",
    "parent": "BlockNode:00CBFDZ41G023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02J",
      "BlockNode:00CBFDZ41G02M",
      "BlockNode:00CBFDZ41G02P"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02J",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02J:props:StringProp:00CBFDZ4AG002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02J:props:StringProp:00CBFDZ4AG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02J",
    "text": "Zero layout interference",
    "parent": "BlockNode:00CBFDZ41G02H",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02K"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02K",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02K",
    "text": "Unlike `<div>` or `<p>`, `<span>` elements introduce no visual breaks or line collapses in the rendered plane.",
    "parent": "BlockNode:00CBFDZ41G02J",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02M:props:StringProp:00CBFDZ4B8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02M:props:StringProp:00CBFDZ4B8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02M",
    "text": "Attribute anchoring",
    "parent": "BlockNode:00CBFDZ41G02H",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02N",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02N",
    "text": "Acts as an inline hook for unique node identifiers (`id=\"node-123\"`), graph attributes (`data-predicate=\"refutes\"`), and event listeners directly over any target character range.",
    "parent": "BlockNode:00CBFDZ41G02M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02P",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02P:props:StringProp:00CBFDZ4B8002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02P:props:StringProp:00CBFDZ4B8003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02P",
    "text": "Arbitrary granularity",
    "parent": "BlockNode:00CBFDZ41G02H",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02Q"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02Q",
    "text": "Can wrap a sentence, phrase, single word, or punctuation mark without disrupting document layout or styling.",
    "parent": "BlockNode:00CBFDZ41G02P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02R",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02R:props:StringProp:00CBFDZ4C0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02R:props:StringProp:00CBFDZ4C0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02R",
    "text": "Unified.js AST mapping to TerminusDB substrate",
    "parent": "BlockNode:00CBFDZ41G023",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02S",
      "BlockNode:00CBFDZ41G02Y"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02S",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02S:props:StringProp:00CBFDZ4C0002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02S:props:StringProp:00CBFDZ4C0003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02S",
    "text": "Granularity mapping",
    "parent": "BlockNode:00CBFDZ41G02R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02T",
      "BlockNode:00CBFDZ41G02V",
      "BlockNode:00CBFDZ41G02W",
      "BlockNode:00CBFDZ41G02X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02T",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02T",
    "text": "Document level (`root` in mdast) corresponds to the page or section document container node.",
    "parent": "BlockNode:00CBFDZ41G02S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02V",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02V",
    "text": "Block level (`listItem` / `paragraph` in mdast) corresponds to individual outliner blocks with parent-child graph edges.",
    "parent": "BlockNode:00CBFDZ41G02S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02W",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02W",
    "text": "Phrase or entity level (`link` / `span` in hast) corresponds to on-demand reified nodes for addressed inline spans.",
    "parent": "BlockNode:00CBFDZ41G02S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02X",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02X",
    "text": "Word or token level (`nlcst`) acts as ephemeral parser nodes used strictly during transduction passes, reified into graph nodes only when explicitly touched.",
    "parent": "BlockNode:00CBFDZ41G02S",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G02Y",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G02Y:props:StringProp:00CBFDZ4CG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G02Y:props:StringProp:00CBFDZ4CG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G02Y",
    "text": "Offset tracking and synchronization",
    "parent": "BlockNode:00CBFDZ41G02R",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G02Z",
      "BlockNode:00CBFDZ41G030"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G02Z",
    "@type": "BlockNode",
    "title": "00CBFDZ41G02Z",
    "text": "Unified tracks exact source offsets (`position: {start, end}`) across all AST nodes.",
    "parent": "BlockNode:00CBFDZ41G02Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G030",
    "@type": "BlockNode",
    "title": "00CBFDZ41G030",
    "text": "When an inline span is addressed, the transducer uses offsets to split the parent AST text node and assign an ID to the newly created span node without disturbing surrounding text.",
    "parent": "BlockNode:00CBFDZ41G02Y",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G031",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G031:props:StringProp:00CBFDZ4CR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G031:props:StringProp:00CBFDZ4CR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G031",
    "text": "Development Roadmap of Aperas",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G032",
      "BlockNode:00CBFDZ41G034",
      "BlockNode:00CBFDZ41G03G",
      "BlockNode:00CBFDZ41G03Z",
      "BlockNode:00CBFDZ41G047",
      "BlockNode:00CBFDZ41G04G"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G032",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G032:props:StringProp:00CBFDZ4CR002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G032:props:StringProp:00CBFDZ4CR003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G032",
    "text": "Meta-Aperas Ontological Alignment",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G033"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G033",
    "@type": "BlockNode",
    "title": "00CBFDZ41G033",
    "text": "The engineering roadmap is itself a self-instantiation of the Aperas ontology: starting in the unconditioned substrate (Apeiron) and crystallizing typed interfaces (Perata) on demand as human–agent coordination needs emerge.",
    "parent": "BlockNode:00CBFDZ41G032",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G034",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G034:props:StringProp:00CBFDZ4D0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G034:props:StringProp:00CBFDZ4D0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G034",
    "text": "Phase 0: Infrastructure and basic tools (Apeiron direct)",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G035",
      "BlockNode:00CBFDZ41G038",
      "BlockNode:00CBFDZ41G03A",
      "BlockNode:00CBFDZ41G03D"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G035",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G035:props:StringProp:00CBFDZ4D0002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G035:props:StringProp:00CBFDZ4D0003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G035",
    "text": "Direct database integration",
    "parent": "BlockNode:00CBFDZ41G034",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G036",
      "BlockNode:00CBFDZ41G037"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G036",
    "@type": "BlockNode",
    "title": "00CBFDZ41G036",
    "text": "The primary coding agent connects directly to the **TerminusDB** substrate without any intermediate UI layer.",
    "parent": "BlockNode:00CBFDZ41G035",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G037",
    "@type": "BlockNode",
    "title": "00CBFDZ41G037",
    "text": "System provides baseline skill definitions (`SKILL.md`) covering schema initialization, document CRUD, WOQL and GraphQL query execution, and temporal commit management.",
    "parent": "BlockNode:00CBFDZ41G035",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G038",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G038:props:StringProp:00CBFDZ4D8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G038:props:StringProp:00CBFDZ4D8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G038",
    "text": "Verification without UI overhead",
    "parent": "BlockNode:00CBFDZ41G034",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G039"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G039",
    "@type": "BlockNode",
    "title": "00CBFDZ41G039",
    "text": "Validates core graph operations, transaction safety, and agent reasoning loops directly against the canonical store.",
    "parent": "BlockNode:00CBFDZ41G038",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03A",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03A:props:StringProp:00CBFDZ4DG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03A:props:StringProp:00CBFDZ4DG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03A",
    "text": "Basic assertion authoring (moved earlier from Phase 2, see `Aperas-basic-assertion-skill-design.md`)",
    "parent": "BlockNode:00CBFDZ41G034",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03B",
      "BlockNode:00CBFDZ41G03C"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03B",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03B",
    "text": "`Assertion` (the concrete `BaseEdge`) was already a working CRUD/WOQL primitive; this adds manual CLI commands (`kg:assert`/`kg:assertions`/`kg:unassert`) so a human or agent can actually write and inspect a real one, with no automated traversal or agent behavior attached.",
    "parent": "BlockNode:00CBFDZ41G03A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03C",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03C",
    "text": "Built here rather than waiting for Phase 1, so Phase 1's skill-building work starts with it already available instead of blocked on it — and ahead of the SolidJS UI, since Artifact Projection (mode 1 of §5.A) already covers the monitoring need the UI was originally assumed to be required for.",
    "parent": "BlockNode:00CBFDZ41G03A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03D",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03D:props:StringProp:00CBFDZ4DR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03D:props:StringProp:00CBFDZ4DR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03D",
    "text": "Agentic query tools (moved earlier from Phase 1, see `Aperas-agentic-query-tools-design.md`)",
    "parent": "BlockNode:00CBFDZ41G034",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03E",
      "BlockNode:00CBFDZ41G03F"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03E",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03E",
    "text": "Mode 3 of §5.A (\"Agentic Interface, BFS Traversal\") made concrete as three CLI tools: `kg:tree` (a deep, title-only structural map — depth-first, not BFS despite the mode's name), `kg:unfold`/`kg:fold` (the real breadth-first primitive — one level, full content, persisting the long-inert `BlockNode.unfolded` flag for the first time), and `kg:search` (keyword/regex content search via WOQL, closing a previously-unfilled gap).",
    "parent": "BlockNode:00CBFDZ41G03D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03F",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03F",
    "text": "Moved here for the same reason as basic assertion authoring: closes the block-level addressing gap that authoring left open, and doesn't need the UI to exist first.",
    "parent": "BlockNode:00CBFDZ41G03D",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03G",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03G:props:StringProp:00CBFDZ4E0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03G:props:StringProp:00CBFDZ4E0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03G",
    "text": "Phase 0.1: Substrate Evolution — ApeironNgn (native Rust successor, in progress)",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03H",
      "BlockNode:00CBFDZ41G03M",
      "BlockNode:00CBFDZ41G03Q",
      "BlockNode:00CBFDZ41G03T",
      "BlockNode:00CBFDZ41G03X"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03H",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03H:props:StringProp:00CBFDZ4E0002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03H:props:StringProp:00CBFDZ4E0003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03H",
    "text": "Motivation: right-sizing the substrate to what Aperas actually exercises",
    "parent": "BlockNode:00CBFDZ41G03G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03J",
      "BlockNode:00CBFDZ41G03K"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03J",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03J",
    "text": "TerminusDB Community brings a general-purpose Prolog/WOQL Datalog engine, enterprise-oriented tooling, and its own bundle/layer format for versioning — capability well beyond what Phase 0-3 skills exercise (document CRUD, one-hop impact traversal, branch/commit/merge as a review workflow).",
    "parent": "BlockNode:00CBFDZ41G03H",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03K",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03K",
    "text": "The bidirectional JSON-LD mirror (`AperasKG/Apeiron/`, `Aperas-architecture.md` §5) demonstrates this directly: the canonical graph content already round-trips as plain JSON-LD files, decoupled from TerminusDB's own storage internals — nothing about the substrate's actual content depends on TerminusDB being the engine underneath it.",
    "parent": "BlockNode:00CBFDZ41G03H",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03M:props:StringProp:00CBFDZ4E8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03M:props:StringProp:00CBFDZ4E8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03M",
    "text": "ApeironNgn: a minimal engine sized to exactly what Aperas needs",
    "parent": "BlockNode:00CBFDZ41G03G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03N",
      "BlockNode:00CBFDZ41G03P"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03N",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03N",
    "text": "A small, embeddable Rust graph engine scoped to the primitives Phase 0-3 actually use: the `BaseNode`/`BaseLink`/`BaseEdge` document model and simple pattern-match queries (source/predicate/target lookups, bounded-depth traversal) — no general Datalog/Prolog solver, no auto-generated GraphQL schema, no multi-tenant/enterprise surface.",
    "parent": "BlockNode:00CBFDZ41G03M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03P",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03P",
    "text": "No separate commit-layer engine to build: `AperasKG/Apeiron/` already lives inside a real git repository, so a JSON-LD write followed by an ordinary `git commit` over that directory *is* the version control — immutable history, diffing, and branching all come from git itself, not a bespoke bundle/layer format ApeironNgn would otherwise have to reimplement. TerminusDB needed its own commit-layer machinery because it owns an opaque store with no git underneath it; once Aperas is managing history directly against `AperasKG/Apeiron/`, ApeironNgn doesn't need to.",
    "parent": "BlockNode:00CBFDZ41G03M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03Q",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03Q:props:StringProp:00CBFDZ4EG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03Q:props:StringProp:00CBFDZ4EG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03Q",
    "text": "Migration surface: the same modules stand in for the same role, one changing shape",
    "parent": "BlockNode:00CBFDZ41G03G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03R",
      "BlockNode:00CBFDZ41G03S"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03R",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03R",
    "text": "`client.ts`, `crud.ts`, `woql.ts`, and `graphql.ts` (`Aperas-architecture.md` §3) already isolate every TerminusDB-specific call behind a small, named set of modules — that boundary is what ApeironNgn would need to implement to stand in for TerminusDB, with `AperasKG/Apeiron/` as the on-disk state `kg:export`/`kg:import` already round-trip through.",
    "parent": "BlockNode:00CBFDZ41G03Q",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03S",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03S",
    "text": "`versionControl.ts` doesn't carry over as-is — its branch/commit/diff/merge calls would delegate straight to real `git` operations on the `AperasKG` repository instead of TerminusDB's git-like API, since the KG's \"commit\" *is* a git commit once ApeironNgn is the engine.",
    "parent": "BlockNode:00CBFDZ41G03Q",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03T:props:StringProp:00CBFDZ4ER000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03T:props:StringProp:00CBFDZ4ER001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03T",
    "text": "Status: in progress — see `Aperas-apeironngn-design.md`",
    "parent": "BlockNode:00CBFDZ41G03G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03V",
      "BlockNode:00CBFDZ41G03W"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03V",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03V",
    "text": "The original contingency — Phase 0-3 confirming that TerminusDB Community edition's rough edges (cross-store `bundle`/`unbundle` incompatibility, `terminusdb/terminusdb#2509`; the `List`-typed `@unfold` gap, `terminusdb/terminusdb#2512`, both documented in `Aperas-dev-status.md`) are structural rather than incidental — is now resolved rather than open: live-verified against the real database (`Aperas-kg-foundational-design.md`, `Aperas-apeironngn-design.md` §2), `List` gives no shortcut in either traversal direction, the abstract-class GraphQL gap is structural, and node-by-node reconstruction loses to bulk fetch by 47–240x. Moved up from the originally-speculative Phase 4 slot accordingly — not deferred substrate evolution, active work.",
    "parent": "BlockNode:00CBFDZ41G03T",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03W",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03W",
    "text": "`Aperas-apeironngn-design.md` names a concrete candidate engine (Oxigraph, embeddable Rust RDF store) and design (reified-triple ordered containment instead of `rdf:List`, the OOP class as schema, `a.b.c` as lazy composed traversal, git-native versioning already free per above, no concurrent access by design — cross-instance sync via `git merge` instead).",
    "parent": "BlockNode:00CBFDZ41G03T",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03X",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03X:props:StringProp:00CBFDZ4ER002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03X:props:StringProp:00CBFDZ4F0000",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03X",
    "text": "Rollout: incremental, not a cutover — see `Aperas-apeironngn-design.md` §4",
    "parent": "BlockNode:00CBFDZ41G03G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G03Y"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G03Y",
    "@type": "BlockNode",
    "title": "00CBFDZ41G03Y",
    "text": "Build the engine (in-memory-only Oxigraph store, rehydrated from `AperasKG/Apeiron/`'s JSON-LD at process start — no RocksDB tier in the Node/WASM build, no separate JS-level cache on top — plus the `a.b.c` prop-access interface), migrate `kgCli.ts` scripts one by one against the same real data with each one diffed against its existing TerminusDB output before being considered done, then archive (not delete) the TerminusDB-based scripts once every one has migrated clean.",
    "parent": "BlockNode:00CBFDZ41G03X",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G03Z",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G03Z:props:StringProp:00CBFDZ4F0001",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G03Z:props:StringProp:00CBFDZ4F0002",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G03Z",
    "text": "Phase 1: Core skills & UI Peras (Human–agent co-navigation)",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G040",
      "BlockNode:00CBFDZ41G042",
      "BlockNode:00CBFDZ41G045"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G040",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G040:props:StringProp:00CBFDZ4F8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G040:props:StringProp:00CBFDZ4F8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G040",
    "text": "Apeiron operating skills",
    "parent": "BlockNode:00CBFDZ41G03Z",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G041"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G041",
    "@type": "BlockNode",
    "title": "00CBFDZ41G041",
    "text": "Agent Skills (`SKILL.md`) teaching a coding agent how to use the CLI to operate and manage the KG.",
    "parent": "BlockNode:00CBFDZ41G040",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G042",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G042:props:StringProp:00CBFDZ4F8002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G042:props:StringProp:00CBFDZ4F8003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G042",
    "text": "SolidJS read projection",
    "parent": "BlockNode:00CBFDZ41G03Z",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G043",
      "BlockNode:00CBFDZ41G044"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G043",
    "@type": "BlockNode",
    "title": "00CBFDZ41G043",
    "text": "Constructs the initial **SolidJS + Unified.js** projection interface for deep-read human inspection.",
    "parent": "BlockNode:00CBFDZ41G042",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G044",
    "@type": "BlockNode",
    "title": "00CBFDZ41G044",
    "text": "Renders continuous Markdown outliner trees directly from TerminusDB AST nodes.",
    "parent": "BlockNode:00CBFDZ41G042",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G045",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G045:props:StringProp:00CBFDZ4FG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G045:props:StringProp:00CBFDZ4FG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G045",
    "text": "Multi-faceted node interface",
    "parent": "BlockNode:00CBFDZ41G03Z",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G046"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G046",
    "@type": "BlockNode",
    "title": "00CBFDZ41G046",
    "text": "Surface projections reveal the multi-tab reference model (Article, Source, Talk, History) so humans and agents navigate the exact same operational state.",
    "parent": "BlockNode:00CBFDZ41G045",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G047",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G047:props:StringProp:00CBFDZ4FR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G047:props:StringProp:00CBFDZ4FR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G047",
    "text": "Phase 2: Skill expansion and perata maturation",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G048",
      "BlockNode:00CBFDZ41G04A",
      "BlockNode:00CBFDZ41G04C"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G048",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G048:props:StringProp:00CBFDZ4FR002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G048:props:StringProp:00CBFDZ4FR003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G048",
    "text": "Incremental capability growth",
    "parent": "BlockNode:00CBFDZ41G047",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G049"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G049",
    "@type": "BlockNode",
    "title": "00CBFDZ41G049",
    "text": "Develops specialized procedural skills including ingestion (parsing external text into AST nodes), *automated* graph search (structural traversals and WOQL/GraphQL pattern matching, with vector support evaluated later — the manual assertion primitive itself moved to Phase 1, above), and refactoring (lazy atomization of spans and node merging).",
    "parent": "BlockNode:00CBFDZ41G048",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04A",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04A:props:StringProp:00CBFDZ4G0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04A:props:StringProp:00CBFDZ4G0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04A",
    "text": "Co-evolution of tools and perata",
    "parent": "BlockNode:00CBFDZ41G047",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04B",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04B",
    "text": "Each new skill definition naturally introduces corresponding tooling and new **perata** (specialized view projections).",
    "parent": "BlockNode:00CBFDZ41G04A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04C:props:StringProp:00CBFDZ4G8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04C:props:StringProp:00CBFDZ4G8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04C",
    "text": "Collaboration perata: review/merge-request workflow",
    "parent": "BlockNode:00CBFDZ41G047",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04D",
      "BlockNode:00CBFDZ41G04E",
      "BlockNode:00CBFDZ41G04F"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04D",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04D",
    "text": "TerminusDB's `rebase`/`apply` give branch reconciliation but no GitHub-style review layer — no proposal-with-discussion, approval state, or inline comment thread sits between \"diverged branches\" and \"merged.\"",
    "parent": "BlockNode:00CBFDZ41G04C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04E",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04E",
    "text": "Aperas extends the multi-faceted node model (Discourse view / Talk) to a first-class review document type: a proposal node wrapping a source/target branch pair, with discussion threads, review state, and conflict-resolution notes stored as subdocuments in the KG rather than in an external tool.",
    "parent": "BlockNode:00CBFDZ41G04C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04F",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04F",
    "text": "Keeps Aperas GitHub-like as well as Git-like: comments, issues, and review decisions become graph-native, queryable, and provenance-tracked alongside the commits they discuss, instead of living in a bolted-on external system.",
    "parent": "BlockNode:00CBFDZ41G04C",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04G",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04G:props:StringProp:00CBFDZ4GG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04G:props:StringProp:00CBFDZ4GG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04G",
    "text": "Phase 3: Multi-agent specialization and Aperas Agent interfaces",
    "parent": "BlockNode:00CBFDZ41G031",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04H",
      "BlockNode:00CBFDZ41G04M",
      "BlockNode:00CBFDZ41G04P"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04H",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04H:props:StringProp:00CBFDZ4GG002",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04H:props:StringProp:00CBFDZ4GG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04H",
    "text": "Sub-agent spawning for coding agents without background API access",
    "parent": "BlockNode:00CBFDZ41G04G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04J",
      "BlockNode:00CBFDZ41G04K"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04J",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04J",
    "text": "Equips primary coding agents with specialized `SKILL.md` definitions that allow them to spawn local sub-agents via headless CLI calls, native sub-agent tools, or local execution scripts.",
    "parent": "BlockNode:00CBFDZ41G04H",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04K",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04K",
    "text": "Preserves the direct Phase 0/2 skill set so local coding agents perform deep structural graph operations, AST transductions, and multi-node updates using existing lab harnesses without secondary API costs.",
    "parent": "BlockNode:00CBFDZ41G04H",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04M",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04M:props:StringProp:00CBFDZ4GR000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04M:props:StringProp:00CBFDZ4GR001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04M",
    "text": "Dedicated agent swarms (API-enabled environments)",
    "parent": "BlockNode:00CBFDZ41G04G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04N",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04N",
    "text": "For environments with secondary API access, specialized multi-agent subgraphs (built with **LangGraph**) run on dedicated model endpoints for complex background tasks.",
    "parent": "BlockNode:00CBFDZ41G04M",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04P",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04P:props:StringProp:00CBFDZ4H0000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04P:props:StringProp:00CBFDZ4H0001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04P",
    "text": "Triple interface continuum for user coding agents",
    "parent": "BlockNode:00CBFDZ41G04G",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04Q",
      "BlockNode:00CBFDZ41G04R",
      "BlockNode:00CBFDZ41G04S"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04Q",
    "text": "**Manual skill mode (procedural / CLI execution):** The coding agent executes raw procedural skills (`SKILL.md`) directly against the substrate, preserving full operational autonomy without API dependencies.",
    "parent": "BlockNode:00CBFDZ41G04P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04R",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04R",
    "text": "**Tool mode (active query):** Exposes high-level perata tools and service endpoints for the coding agent to interact directly with the Aperas Agent on demand.",
    "parent": "BlockNode:00CBFDZ41G04P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04S",
    "@type": "BlockNode",
    "title": "00CBFDZ41G04S",
    "text": "**Hook mode (automatic context engineering):** Injects perata and context projections directly into the context window of the coding agent via background events and triggers.",
    "parent": "BlockNode:00CBFDZ41G04P",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G04T",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04T:props:StringProp:00CBFDZ4H8000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
        "@id": "BlockNode:00CBFDZ41G04T:props:StringProp:00CBFDZ4H8001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G04T",
    "text": "Open-Source Stack for Agentic Knowledge Graph Architectures",
    "parent": "BlockNode:00CBFDZ418004",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G04V",
      "BlockNode:00CBFDZ41G05C"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G04V",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G04V:props:StringProp:00CBFDZ4HG000",
