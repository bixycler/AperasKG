    ],
    "title": "00C64YWX6000W",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004B",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004B",
    "children": [],
    "text": "Attribute anchoring",
    "title": "00C64YWX6000X",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004C",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004C",
    "children": [
      "BlockNode/00C5FPAA2004D"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX6000Y",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004D",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004D",
    "children": [
      "BlockNode/00C5FPAA2004E"
    ],
    "title": "00C64YWX6000Z",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004E",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004E",
    "children": [],
    "text": "Acts as an inline hook for unique node identifiers (`id=\"node-123\"`), graph attributes (`data-predicate=\"refutes\"`), and event listeners directly over any target character range.",
    "title": "00C64YWX60010",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004F",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004F",
    "children": [
      "BlockNode/00C5FPAA2004G",
      "BlockNode/00C5FPAA2004H"
    ],
    "title": "00C64YWX60011",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004G",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004G",
    "children": [],
    "text": "Arbitrary granularity",
    "title": "00C64YWX60012",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004H",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004H",
    "children": [
      "BlockNode/00C5FPAA2004J"
    ],
    "ordered": false,
    "start": 1,
    "title": "00C64YWX60013",
    "type": "list",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004J",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004J",
    "children": [
      "BlockNode/00C5FPAA2004K"
    ],
    "title": "00C64YWX60014",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004K",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004K",
    "children": [],
    "text": "Can wrap a sentence, phrase, single word, or punctuation mark without disrupting document layout or styling.",
    "title": "00C64YWX60015",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004M",
    "@type": "BlockNode",
