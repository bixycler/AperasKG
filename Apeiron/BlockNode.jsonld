    "parent": "BlockNode:00CBFDZ41R02C",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R02M",
      "BlockNode:00CBFDZ41R02N"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R02M",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02M",
    "text": "Uses dependency traversal flagging stale nodes or diff queues.",
    "parent": "BlockNode:00CBFDZ41R02K",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R02N",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02N",
    "text": "Reached medium maturity in temporal KG agents and reactive engines.",
    "parent": "BlockNode:00CBFDZ41R02K",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41R02P",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41R02P:props:StringProp:00CBFDZ4VG000",
