  },
  {
    "@id": "BlockNode/00C5FPAA2003S",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2003S",
    "children": [],
    "text": "Stored plane (Substrate Apeiron)",
    "title": "00C64YWX60009",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2003T",
