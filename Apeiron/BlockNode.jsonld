        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00CBFDZ41G05A",
    "text": "Surface editor and AST parsing layer",
    "parent": "BlockNode:00CBFDZ41G04V",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41G05B"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41G05B",
    "@type": "BlockNode",
    "title": "00CBFDZ41G05B",
    "text": "**Unified.js** (`remark` / `rehype`) acts as the bidirectional AST parsing engine for Markdown to MDAST conversion, offset tracking, and block extraction.",
    "parent": "BlockNode:00CBFDZ41G05A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41G05C",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41G05C:props:StringProp:00CBFDZ4JR000",
