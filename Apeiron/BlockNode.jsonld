    "children": []
  },
  {
    "@id": "BlockNode:00CS1593MG00R",
    "@type": "BlockNode",
    "title": "#### 2. Orientation",
    "parent": "BlockNode:00CS1593MG002",
    "type": "heading",
    "children": [
      "BlockNode:00CS1593MG00S",
      "BlockNode:00CS1593MR001",
