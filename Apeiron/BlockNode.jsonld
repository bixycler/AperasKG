      }
    ],
    "title": "00CBFDZ41800A",
    "text": "Philosophy and Ontology of Aperas",
    "parent": "BlockNode:00CBFDZ418009",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41800B",
      "BlockNode:00CBFDZ41800C",
      "BlockNode:00CBFDZ41800D",
      "BlockNode:00CBFDZ41800E"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41800B",
    "@type": "BlockNode",
    "title": "00CBFDZ41800B",
    "text": "Metaphysical foundation: Apeiron (macrocosm), Aperas (microcosm), and Peras (interface).",
    "parent": "BlockNode:00CBFDZ41800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800C",
    "@type": "BlockNode",
    "title": "00CBFDZ41800C",
    "text": "Conceptual triad: Unbounded – Unbound – Bound.",
    "parent": "BlockNode:00CBFDZ41800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800D",
    "@type": "BlockNode",
    "title": "00CBFDZ41800D",
    "text": "Flatbread metaphor and linguistic emergence.",
    "parent": "BlockNode:00CBFDZ41800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800E",
    "@type": "BlockNode",
    "title": "00CBFDZ41800E",
    "text": "Multi-faceted node epistemology: Wikipedia reference model (Article, Source, Talk, History).",
    "parent": "BlockNode:00CBFDZ41800A",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CBFDZ41800F",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CBFDZ41800F:props:StringProp:00CBFDZ430000",
