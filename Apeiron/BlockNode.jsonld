    "@type": "BlockNode",
    "blockId": "00C5FPAA1801S",
    "children": [
      "BlockNode/00C5FPAA1801T"
    ],
    "text": "The outer universe existing in a state of infinite, unmanifested potential.",
    "title": "00C6HQACHR01F",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801T",
