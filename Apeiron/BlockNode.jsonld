        "@type": "Link",
        "target": "BlockNode:00CEA5Y5JG003",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CEA68QVG002:links:Link:00CGRSHV5G000:props:StringProp:00CGRSHV5R000",
            "@type": "StringProp",
            "key": "position",
            "value": "0"
          }
        ]
      }
    ],
    "props": [
      {
        "@id": "BlockNode:00CEA68QVG002:props:StringProp:00CEA68S28000",
