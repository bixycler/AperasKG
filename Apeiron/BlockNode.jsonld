  },
  {
    "@id": "BlockNode/00C64YXFT0026",
    "@type": "BlockNode",
    "blockId": "00C64YXFT0026",
    "children": [],
    "text": "Reconciling separate hosts' diverged `aperas_apeiron` histories (push/pull, possibly rebase) — currently only fetched-and-inspected, not merged.",
    "title": "00C64Z9NB800M",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C64YXFT0027",
    "@type": "BlockNode",
    "blockId": "00C64YXFT0027",
    "children": [
      "BlockNode/00C64YXFT0028"
    ],
    "title": "00C64Z9NB800N",
    "type": "listItem",
