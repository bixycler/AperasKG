    ]
  },
  {
    "@id": "BlockNode:00CR8G0T70002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00CR8G0T70002:props:StringProp:00CR8G0YFG000",
        "@type": "StringProp",
        "key": "orderedList",
        "value": "false"
      },
      {
