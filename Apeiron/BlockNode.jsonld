  },
  {
    "@id": "BlockNode/00C5FPAA20058",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20058",
    "children": [],
    "text": "When an inline span is addressed, the transducer uses offsets to split the parent AST text node and assign an ID to the newly created span node without disturbing surrounding text.",
