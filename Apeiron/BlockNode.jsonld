    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004N",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2004N",
    "children": [],
    "text": "Unified.js AST mapping to TerminusDB substrate",
    "title": "00C64YWX60017",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2004P",
    "@type": "BlockNode",
