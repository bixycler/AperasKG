  {
    "@id": "BlockNode:00CJ6TGSYG005",
    "@type": "BlockNode",
    "title": "## Architecture",
    "parent": "BlockNode:00CJ6TGSX8001",
    "type": "heading",
    "children": [
      "BlockNode:00CJ6TGSYG006",
