  },
  {
    "@id": "BlockNode:00CS1593MR00N",
    "@type": "BlockNode",
    "title": "Unfold the matching candidate node",
    "text": "Unfold the matching candidate node: `aperas unfold <id>`.",
    "parent": "BlockNode:00CS1593MR00H",
    "type": "listItem",
    "children": []
  },
  {
