      }
    ],
    "title": "00D253D680007",
    "text": "Not found. `hydrateFromParsed` (`node.ts` line 574) sets `type` on every ingest, so a node with children and hashes and no `type` was not produced by that path in its present form.",
    "parent": "BlockNode:00D253D680006",
