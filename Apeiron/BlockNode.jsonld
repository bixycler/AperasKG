  {
    "@id": "BlockNode/00C5FPA5PG00V",
    "@type": "BlockNode",
    "blockId": "00C5FPA5PG00V",
    "children": [],
    "text": "**Restore Safety**: `restore-full` extracts into an isolated temporary volume/container (`<container>-restored`) for inspection. Automatic promotion (`--overwrite`) updates container volume bindings with automatic fallback to `-old` on startup failure.",
    "title": "00C5FPA5PG00V",
