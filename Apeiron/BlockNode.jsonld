    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2800X",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2800X",
    "children": [],
    "text": "UI rendering and projection layer",
    "title": "00C64YWX68003",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2800Y",
    "@type": "BlockNode",
