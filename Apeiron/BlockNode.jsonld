      },
      {
        "@id": "BlockNode:00D22ZV0FR002:props:StringProp:00D22ZVBTG001",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D22ZV0FR002",
    "text": "The rename of `__parent` to `parent` did not reach a file that nothing runs, so no test or build step noticed. [The no-coverage issue](#id/BlockNode:00CVQHD7CR001) records that this script checks rehydrate and field access only.",
    "parent": "BlockNode:00D22ZV0FR001",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D22ZV0FR003",
    "@type": "BlockNode",
    "title": "00D22ZV0FR003",
    "text": "**Not proven**",
    "parent": "BlockNode:00D22ZV0FG001",
    "type": "listItem",
    "children": [
      "BlockNode:00D22ZV0FR004"
    ]
  },
  {
