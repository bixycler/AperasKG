    ],
    "title": "00CEA68QVG002",
    "text": "[Design](../design/aperas-skill.md#id/BlockNode:00CEA5Y5JG003) — the four-level shape, abstract to concrete, that the skill follows, and the multi-agent loop around it.",
    "parent": "BlockNode:00CE8XWZK0000",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00CEA68QVG003",
