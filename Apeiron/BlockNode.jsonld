    ],
    "title": "00C64YWX60046",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28005",
    "@type": "BlockNode",
    "blockId": "00C5FPAA28005",
    "children": [],
    "text": "Triple interface continuum for user coding agents",
    "title": "00C64YWX60047",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA28006",
    "@type": "BlockNode",
