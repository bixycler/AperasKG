      {
        "@id": "BlockNode:00CVKFWNB8001:links:Link:00CVKFWW38002",
        "@type": "Link",
        "target": "BlockNode:00CGN6GJVG000",
        "predicate": "[[wikilink]]",
        "props": [
          {
            "@id": "BlockNode:00CVKFWNB8001:links:Link:00CVKFWW38002:props:StringProp:00CVKFWW38003",
