  },
  {
    "@id": "BlockNode/00C5FPAA1801T",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1801T",
    "children": [],
    "text": "The outer universe existing in a state of infinite, unmanifested potential.",
    "title": "00C64YWX5G00G",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801V",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1801V",
    "children": [
      "BlockNode/00C5FPAA1801W"
    ],
    "title": "00C64YWX5G00H",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801W",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1801W",
    "children": [],
    "text": "Represents the unconditioned, boundless origin – an inexhaustible, schema-free field holding all possibilities without being trapped by any single form.",
    "title": "00C64YWX5G00J",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801X",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1801X",
    "children": [
      "BlockNode/00C5FPAA1801Y",
      "BlockNode/00C5FPAA1801Z"
    ],
    "title": "00C64YWX5G00K",
    "type": "listItem",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801Y",
    "@type": "BlockNode",
    "blockId": "00C5FPAA1801Y",
    "children": [],
    "text": "Aperas – Unbound (Microcosm – Subjective Liberation)",
    "title": "00C64YWX5G00M",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA1801Z",
