    ]
  },
  {
    "@id": "BlockNode:00CBFDZ02802F",
    "@type": "BlockNode",
    "links": [
      {
        "@id": "BlockNode:00CBFDZ02802F:links:Link:00CBFDZ0Q0000",
        "@type": "Link",
        "target": "BlockNode:00CBFDZ028013",
        "predicate": "[[wikilink]]",
