  },
  {
    "@id": "BlockNode/00C5FPAA2003W",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2003W",
    "children": [],
    "text": "The backing store in TerminusDB preserving content as coarse or fine AST nodes and character offset ranges.",
    "title": "00C64YWX6000C",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2003X",
    "@type": "BlockNode",
