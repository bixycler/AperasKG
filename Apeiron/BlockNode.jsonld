      {
        "@id": "BlockNode:00D22ZV0FR004:props:StringProp:00D22ZVBTG003",
        "@type": "StringProp",
        "key": "startIndex",
        "value": "1"
      }
    ],
    "title": "00D22ZV0FR004",
    "text": "Whether the script, run now, would fail at that line or elsewhere; the Coder did not touch it.",
    "parent": "BlockNode:00D22ZV0FR003",
