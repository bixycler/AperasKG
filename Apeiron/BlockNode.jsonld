    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20046",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20046",
    "children": [],
    "text": "Zero layout interference",
    "title": "00C64YWX6000R",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA20047",
    "@type": "BlockNode",
    "blockId": "00C5FPAA20047",
    "children": [
      "BlockNode/00C5FPAA20048"
