  {
    "@id": "BlockNode/00C7BJJVZG001",
    "@type": "BlockNode",
    "title": "# Agentic Query Tools — Design",
    "blockId": "00C7BJJVZG001",
    "children": [
      "BlockNode/00C7BJJVZG002",
      "BlockNode/00C7BJJVZG003",
      "BlockNode/00C7BJJVZR003",
      "BlockNode/00C7BJJVZR00A",
      "BlockNode/00C7BJJVZR00H",
      "BlockNode/00C7BJJVZR012",
      "BlockNode/00C7BJJVZR017"
    ],
