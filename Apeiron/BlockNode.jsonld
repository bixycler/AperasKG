  },
  {
    "@id": "BlockNode/00C5FPAA2006K",
    "@type": "BlockNode",
    "blockId": "00C5FPAA2006K",
    "children": [],
    "text": "Incremental capability growth",
    "title": "00C64YWX60035",
    "type": "paragraph",
    "unfolded": false
  },
  {
    "@id": "BlockNode/00C5FPAA2006M",
    "@type": "BlockNode",
