        ]
      }
    ],
    "title": "00D2536E2000B",
    "text": "[The smoke-test issue](#id/BlockNode:00D22ZV0FG001), which is one of the direct callers.",
    "parent": "BlockNode:00D2536E20009",
    "type": "listItem",
    "children": []
  },
  {
    "@id": "BlockNode:00D2538VKR001",
    "@type": "BlockNode",
    "title": "**The loader writes a node's `parent` from the `parent` pair in the file, not from the container that lists it, so a file whose `parent` and `children` disagree loads as it stands**",
    "text": "**The loader writes a node's `parent` from the `parent` pair in the file, not from the container that lists it, so a file whose `parent` and `children` disagree loads as it stands**:  found 2026-10-12 by the Coder in the fact-check of the draft `design/core.md`. Filed 2026-10-12.",
    "parent": "BlockNode:00CF1WZ4JG00J",
    "type": "listItem",
    "children": [
      "BlockNode:00D2538VKR002",
      "BlockNode:00D2538VKR005",
      "BlockNode:00D2538VKR008",
      "BlockNode:00D2538VKR00A",
      "BlockNode:00D2538VM0000",
      "BlockNode:00D6HBQYPR001"
    ]
  },
  {
    "@id": "BlockNode:00D2538VKR002",
    "@type": "BlockNode",
    "props": [
      {
        "@id": "BlockNode:00D2538VKR002:props:StringProp:00D25397J0000",
