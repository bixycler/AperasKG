    ],
    "title": "00CBFDZ41R02P",
    "text": "Bidirectional round-tripping",
    "parent": "BlockNode:00CBFDZ41R02C",
    "type": "listItem",
    "children": [
      "BlockNode:00CBFDZ41R02Q",
      "BlockNode:00CBFDZ41R02R"
    ]
  },
  {
    "@id": "BlockNode:00CBFDZ41R02Q",
    "@type": "BlockNode",
    "title": "00CBFDZ41R02Q",
    "text": "Edits a rendered view to update only delta nodes in the knowledge graph.",
    "parent": "BlockNode:00CBFDZ41R02P",
