  {
    "@id": "ArtifactNode:00CE1GW4B8001",
    "@type": "ArtifactNode",
    "title": "treeview.md",
    "text": "Fix the treeview-specific gaps and the two relocated ingest/parser gaps together, since they were bundled by direct instruction rather than filed separately. No particular cross-dependency between them — order by whichever's simplest to verify in isolation.",
    "parent": "FolderNode:00CDBYV4BR004",
