    "path": "design/webapp.md",
    "fileHash": "32d6a7190804502bd8f3bdf8c2fd84c782b7b435184520af78c6598e498e33dc",
    "lastTrackedAt": "2026-09-22T08:06:16.357Z",
    "ingestedHash": "32d6a7190804502bd8f3bdf8c2fd84c782b7b435184520af78c6598e498e33dc",
    "lastIngestedAt": "2026-09-22T08:23:02.165Z",
