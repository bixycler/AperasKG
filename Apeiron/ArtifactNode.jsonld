  {
    "@id": "ArtifactNode:00CF1TZQV8000",
    "@type": "ArtifactNode",
    "tombstonedAt": "2026-09-12T21:59:17.749Z",
    "holder": true,
    "title": "cli.md",
    "parent": "FolderNode:00CDBYV4BR003",
