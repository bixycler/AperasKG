    "@id": "ArtifactNode:00CN1QE950000",
    "@type": "ArtifactNode",
    "props": [
      {
        "@id": "ArtifactNode:00CN1QE950000:props:StringProp:00CN1QEEQ8000",
        "@type": "StringProp",
        "key": "description",
        "value": "The Aperas project's knowledge-graph corpus root: every design/issues/planning/history/discussion doc lives under here, live-ingested rather than static documentation."
      }
    ],
    "title": "README.md",
    "text": "Design docs, dev status, and reports for the Aperas project, tracked as `ArtifactNode`/`FolderNode` content in ApeironNgn's own knowledge graph (`Aperas-apeironngn-design.md`) — this tree is both documentation and a live corpus the substrate ingests itself.",
    "type": "root",
    "children": [
      "BlockNode:00CN1QEAGG001"
    ],
    "path": "README.md",
    "fileHash": "adcb2e690fedf95d4e1af52a852b9651db8dc1344f0eb3c18812b8c0967da37d",
    "lastTrackedAt": "2026-09-22T05:30:47.316Z",
