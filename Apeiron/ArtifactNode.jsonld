    "lastTrackedAt": "2026-09-11T18:22:15.487Z",
    "ingestedHash": "c53d9b46ab20ab3d5bf1188ed75feeff80d75262d363594899cd634d47a52b46",
    "lastIngestedAt": "2026-09-15T02:51:20.144Z",
